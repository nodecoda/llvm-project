body:             |
  bb.1.entry:
    successors: %bb.2(0x80000000)
    liveins: $esi, $rdi
  
    %0:gr64 = COPY $rdi
    %1:gr32 = COPY $esi
    MOV64mr %stack.0.a.addr, 1, $noreg, 0, $noreg, %0 :: (store (p0) into %ir.a.addr)
    MOV32mr %stack.1.n.addr, 1, $noreg, 0, $noreg, %1 :: (store (s32) into %ir.n.addr)
    MOV32mi %stack.2.s, 1, $noreg, 0, $noreg, 0 :: (store (s32) into %ir.s)
    MOV32mi %stack.3.i, 1, $noreg, 0, $noreg, 0 :: (store (s32) into %ir.i)
  
  bb.2.for.cond:
    successors: %bb.3(0x40000000), %bb.5(0x40000000)
  
    %7:gr32 = MOV32rm %stack.3.i, 1, $noreg, 0, $noreg :: (dereferenceable load (s32) from %ir.i)
    %8:gr32 = MOV32rm %stack.1.n.addr, 1, $noreg, 0, $noreg :: (dereferenceable load (s32) from %ir.n.addr)
    CMP32rr %7, %8, implicit-def $eflags
    %25:gr8 = SETCCr 12, implicit $eflags
    TEST8ri %25, 1, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.5
  
  bb.3.for.body:
    successors: %bb.4(0x80000000)
  
    %11:gr64 = MOV64rm %stack.0.a.addr, 1, $noreg, 0, $noreg :: (dereferenceable load (p0) from %ir.a.addr)
    %12:gr32 = MOV32rm %stack.3.i, 1, $noreg, 0, $noreg :: (dereferenceable load (s32) from %ir.i)
    %13:gr64 = MOVSX64rr32 %12
    %15:gr64_nosp = nsw SHL64ri %13, 2, implicit-def dead $eflags
    %16:gr64 = nusw inbounds LEA64r %11, 1, %15, 0, $noreg
    %17:gr32 = MOV32rm %16, 1, $noreg, 0, $noreg :: (load (s32) from %ir.arrayidx)
    ADD32mr %stack.2.s, 1, $noreg, 0, $noreg, %17, implicit-def dead $eflags :: (store (s32) into %ir.s), (dereferenceable load (s32) from %ir.s)
  
  bb.4.for.inc:
    successors: %bb.2(0x80000000)
  
    INC32m %stack.3.i, 1, $noreg, 0, $noreg, implicit-def dead $eflags :: (store (s32) into %ir.i), (dereferenceable load (s32) from %ir.i)
    JMP_1 %bb.2
  
  bb.5.for.end:
    %10:gr32 = MOV32rm %stack.2.s, 1, $noreg, 0, $noreg :: (dereferenceable load (s32) from %ir.s)
    $eax = COPY %10
    RET 0, implicit $eax
