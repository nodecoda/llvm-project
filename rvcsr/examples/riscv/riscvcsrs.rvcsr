# rvcsr v1 — core-syntax example
#
# This file exercises every Layer 0-2 production once; it is meant as a
# parser/sema smoke fixture, not as the full RISC-V corpus (594 records).

# --- unprivileged ---
csr fflags = 0x001
csr frm    = 0x002
csr fcsr   = 0x003

# --- counters ---
for i in 3..31 {
  csr hpmcounter${i}    = 0xc03 + (i - 3)
  csr hpmcounter${i}h   = 0xc83 + (i - 3) { rv32only }
}

# --- aliases: one canonical, two alternate names ---
csr tdata1 = 0x7a1
alias mcontrol  of 0x7a1
alias mcontrol6 of 0x7a1

# --- deprecated name of a canonical CSR ---
csr stval = 0x143
deprecated sbadaddr of 0x143

# --- vendor namespace: projected as sf.mtvt ---
vendor sf requires XSfmclic {
  csr mtvt = 0x307
}

# --- vendor namespace + zero padding: qc.mclicilvl00..31 ---
vendor qc requires Xqciint {
  for i in 0..31 {
    csr mclicilvl${i:2} = 0xbc0 + i
  }
}

# --- restricted condition: odd pmpcfg entries are RV32-only ---
for i in 0..15 {
  csr pmpcfg${i} = 0x3a0 + i { rv32only if odd(i) }
}
