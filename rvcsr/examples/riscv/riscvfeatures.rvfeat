# rvcsr v1 — feature declarations used by riscvcsrs.rvcsr
#
# "extern feature" references a standard extension without modelling it.
# Only rv32only and experimental are consumed by the v1 backend;
# "requires" is recorded as a direct edge and closed by sema for checks.

extern feature F

feature XSfmclic { experimental }
feature XSfsclic { experimental }
feature Xqciint  { rv32only }
feature Xqccmi   { rv32only }
feature XAIFET   { requires F }
