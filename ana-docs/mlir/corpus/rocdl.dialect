  }
  op global.store.async.from.lds.b8 from AsyncLdsCopy {
    Doc "Asynchronously copy 8 bits from LDS to a global pointer at constant `offset` with cache policy `aux`; no completion wait is inserted (gfx1250+).";
  }
  op cluster.load.async.to.lds.b128 from ClusterAsyncLdsCopy {
    Doc "Broadcast-load 128 bits from global memory into LDS for a cluster of workgroups at constant `offset`, with cache policy `cpol` and per-workgroup `mask` (gfx1250+).";
  }
  op cluster.load.async.to.lds.b32 from ClusterAsyncLdsCopy {
    Doc "Broadcast-load 32 bits from global memory into LDS for a cluster of workgroups at constant `offset`, with cache policy `cpol` and per-workgroup `mask` (gfx1250+).";
  }
