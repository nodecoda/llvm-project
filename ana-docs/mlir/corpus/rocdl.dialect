  op load.to.lds {
    Doc "Load size bytes from global pointer globalPtr to LDS pointer ldsPtr at a constant offset, using the given cache policy; the compiler inserts completion waits.";
    Operands   (globalPtr: any, ldsPtr: any);
    Attributes (size: i32, offset: i32, aux: any);
    Properties [memory_effect(read), memory_effect(write)];
    Assembly   { globalPtr "," ldsPtr "," size "," offset "," custom<CachePolicy>(aux) prop-dict attr-dict ":" type(globalPtr) }
  }
  op load.async.to.lds {
    Doc "Gathering load from global memory to LDS at a constant offset, with no automatic completion waits; pair with asyncmark/wait.asyncmark.";
    Operands   (globalPtr: any, ldsPtr: any);
    Attributes (size: i32, offset: i32, aux: any);
    Properties [memory_effect(read), memory_effect(write)];
    Assembly   { globalPtr "," ldsPtr "," size "," offset "," custom<CachePolicy>(aux) prop-dict attr-dict ":" qualified(type(globalPtr)) "," qualified(type(ldsPtr)) }
  }
  op global.load.lds {
    Doc "Load from a global buffer pointer to LDS with size, constant offset and cache policy; the compiler inserts completion waits.";
    Operands   (globalPtr: any, ldsPtr: any);
    Attributes (size: i32, offset: i32, aux: any);
    Properties [memory_effect(read), memory_effect(write)];
    Assembly   { globalPtr "," ldsPtr "," size "," offset "," custom<CachePolicy>(aux) prop-dict attr-dict }
  }
  op global.load.async.lds {
    Doc "Async load from an address-space-1 global pointer to LDS with a cache policy; no automatic completion waits.";
    Operands   (globalPtr: any, ldsPtr: any);
    Attributes (size: i32, offset: i32, aux: any);
    Properties [memory_effect(read), memory_effect(write)];
    Assembly   { globalPtr "," ldsPtr "," size "," offset "," custom<CachePolicy>(aux) prop-dict attr-dict ":" qualified(type(globalPtr)) "," qualified(type(ldsPtr)) }
  }

  op global.load.async.to.lds.b128 from AsyncLdsCopy {
    Doc "Asynchronously copy 128 bits from a global pointer to LDS at constant `offset` with cache policy `aux`; no completion wait is inserted (gfx1250+).";
  }
