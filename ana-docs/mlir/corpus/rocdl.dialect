/// rocdl —— AMD GPU 的 ROCDL 方言：硬件 id、屏障/等待、缓存策略内存指令、
/// 矩阵乘累加（MFMA/SMFMAC/WMMA/SWMMAC）、点积、DPP/permlane 置换与数值转换。
///
/// 领域：ROCDL 把 AMDGPU 后端的 LLVM intrinsic 暴露成 MLIR op。绝大多数 op
/// 直接对应一条 `llvm.amdgcn.*` intrinsic；本语料按上游 ROCDLOps.td 的助记符
/// 建模，覆盖其全部 374 个 op（以 `llvm-tblgen --dump-json` 的 opName 为准）。
///
/// 文本通道：374 个 op 中 337 个块格式、37 个块格式加 `custom<CachePolicy>`
/// 钩子（block-hook），0 个 Custom、0 个 Generic。
/// 上游 ROCDLOps.td 及其 include 闭包里没有任何 op 打开
/// `hasCustomAssemblyFormat`，也没有哪个 op 缺少 `assemblyFormat`，因此本文件
/// 不需要 Custom 或 Generic 通道，也没有使用任何命名缺口。
///
/// 钩子：唯一的钩子是 `custom<CachePolicy>`，实参逐位对应上游（都只有一个
/// 数据实参，本文件用同名的已声明属性部件）：
///   - `$aux`（raw.ptr.buffer.*、load[.async].to.lds、global.load[.async].lds、
///     global.load.async.to.lds.b*、global.store.async.from.lds.b*）
///   - `$cpol`（cluster.load.async.to.lds.b*）
///   - `$cachePolicy`（global.prefetch、flat.prefetch、tensor.load/store）
///
/// schema：用 39 个 schema 收敛同形 op（MFMA、SMFMAC、WMMA 的七种修饰器形状、
/// 点积、SWMMAC 的五种形状、LDS 转置读、global/ds.load.tr*、async copy、
/// tensor 搬运、数学近似、raw buffer 原子返回、硬件 id 寄存器、cvt.scale/
/// cvt.scalef32 的各修饰器形状）。每个 op 仍显式给出 `from` 继承或自己的
/// `Assembly { ... }`；没有 op 靠省略继承默认通道。
///
/// 事实：只用 `tools/fact-glossary.tsv` 的 core 词：
///   - Pure trait -> `pure`（硬件 id、dot、cvt、fmed3、math、make.buffer.rsrc）；
///   - AllTypesMatch -> 相邻 `same_type`（readfirstlane/readlane、update.dpp、
///     permlanex16、raw buffer 原子操作、fmed3）；
///   - 操作数上的 MemRead/MemWrite -> `memory_effect(read|write)`
///     （LDS 转置读、global/ds.load.tr*、load-to-LDS、async copy、
///     ptr buffer load/store/atomic、prefetch、DS 屏障原子）。
///   没有符号、region、terminator 类 trait，故不写对应事实。
///
/// 只写进 Doc 的语义（文法没有对应谓词）：
///   - 所有指针操作数都是 LLVM 指针（`!llvm.ptr<AS>`，AS 为 0/1/3/7/8/15），
///     语料统一写 `any`，Doc 记录真实地址空间：global=1、LDS=3、buffer
///     resource=8、named barrier=15、flat=0。
///   - MFMA 的 `blgp` 是 B-lane 置换；f64 变体在 gfx94x 上是 NEG 位域
///     (`neg_a|neg_b`)，不是置换。
///   - `cbsz`/`abid`/`blgp`/`modC`/`fmtA`/`fmtB`/`scaleAType`/`fmtScaleA`/
///     `fmtScaleB` 等是计时常量 immarg；其枚举取值集合由 ROCDLAttrs.td 定义。
///   - `sched.barrier` 的 mask 位域：none、valu、vmem_read、vmem_write、
///     ds_read、ds_write，以及包含 LDSDMA 的超集 all_vmem、all_ds、mfma_wmma。
///   - `asyncmark`/`wait.asyncmark` 的 stages 是 async stage 位掩码（all 或
///     tensor 等单 stage）；每个被点名的 stage 各有一条 mark 序列。
///   - 特化 id 寄存器结果被建模成 i32（上游是 LLVM_Type，示例均为 i32）；
///     `range` 是可选 LLVM_ConstantRangeAttr，语法写 `optional<any>`。
///   - readlane/readfirstlane 的标量与 vector 形态共享一个 lane 类型，元素
///     位宽 <= 64；语料用 `lane = scalar | vector<any>` 表达。
///   - permlane16/permlane32 的 `.swap` 变体返回 LLVM struct pair `(i32,i32)`，
///     语料把结果写成 `any` 并在 Doc 记录。
///   - cvt.* 的 byteSel/wordSel/scaleSel/srcSelIndex/srcLoHiSel/dstLoHiSel/
///     dstSelIndex 是选择源/目标字节、字或半字的 immarg；f32 打包形式的结果是
///     vector<2xf32>/vector<8xf32> 等，低精度打包形式的结果是 i32 或
///     vector<Nxi32>，宽度由助记符与上游 ScaleArgInfo 决定；cvt.pkrtz 的结果是
///     vector<2xf16>。
///   - WMMA/SWMMAC 的 signA/signB/clamp 是 i1 立即数；scale 形式的 scaleA/B
///     是 i32（scale16 形式是 i64）。
///   - `softmax` 之外的 math 近似（tanh/sin/cos/rcp/exp/exp2/log/sqrt/rsq）
///     一般应优先用 arith/math/llvm，仅当可接受精度损失时使用。
///   - `make.buffer.rsrc` 的结果是地址空间 8 的 buffer resource。
///
/// 工具说明：覆盖率以上游 `llvm-tblgen --dump-json` 的 opName 为真值，因此由
/// `foreach`/模板拼出的助记符（global/ds.load.tr*、global/cluster async copy、
/// cvt.scale/cvt.scalef32 各 pk 族）都能被识别；本文件已逐一建模，missing=0、
/// extra=0。`tools/escape-audit.py` 的文本扫描只看字面量 `Base<"...">` 助记符，
/// 看不到这些拼接名，故会把它们列进 “ops with no upstream record”；这是该工具
/// 正则的已知盲区，不是本语料缺 op。

dialect rocdl {
  Doc "AMD GPU ROCDL dialect: hardware ids, barriers, cache-policy memory intrinsics, matrix ops, permutations and numeric conversions.";

  // ---- 类型域 ----

  // 标量 lane 与标量-or-vector lane；上游的位宽上界（<= 64）文法写不出，见文件头。
  constraint scalar = integer | float;
  constraint vector_any = vector<any>;
  constraint lane = scalar | vector_any;

  // ---- 硬件 id 寄存器 ----

  schema SpecialId {
    Doc "Read a hardware thread/workgroup/cluster id register; the optional range attribute bounds the returned i32.";
    Results    (res: i32);
    Attributes (range: optional<any>);
    Properties [pure];
    Assembly   { if range { "range" range } attr-dict ":" type(res) }
  }

  // ---- 基础逐元素 / 波前操作 ----

  schema Mbcnt {
    Doc "Masked bit count of threads below the current lane in a wavefront.";
    Operands   (in0: i32, in1: i32);
    Results    (res: i32);
    Properties [pure];
    Assembly   { in0 "," in1 prop-dict attr-dict ":" "(" type(in0) "," type(in1) ")" "->" type(res) }
  }

  // ---- MFMA ----

  schema Mfma<ab: any, cd: any> {
    Doc "Matrix fused multiply-add D = A*B + C with broadcast/block-layout modifiers.";
    Operands   (a: ab, b: ab, c: cd);
    Results    (res: cd);
    Attributes (cbsz: i32, abid: i32, blgp: any);
    Assembly   { a "," b "," c "," cbsz "," abid "," blgp
                 attr-dict ":" functional-type(operands, res) }
  }

  schema MfmaScale<ab: any, cd: any> {
    Doc "Scaled matrix fused multiply-add with per-operand opsel and scale operands.";
    Operands   (a: vector<ab>, b: vector<ab>, c: vector<cd>,
                scaleA: i32, scaleB: i32);
    Results    (res: any);
    Attributes (cbsz: any, blgp: any, opselA: i32, opselB: i32);
    Assembly   { a "," b "," c "," cbsz "," blgp "," opselA ","
                 scaleA "," opselB "," scaleB
                 attr-dict ":" functional-type(operands, res) }
  }

  // ---- SMFMAC ----

  schema Smfmac<atype: any, btype: any, cdtype: any> {
    Doc "Sparse 2:4 matrix fused multiply-accumulate; index carries sparsity metadata.";
    Operands   (a: atype, b: btype, c: cdtype, index: i32);
    Results    (res: cdtype);
    Attributes (cbsz: i32, abid: i32);
    Assembly   { a "," b "," c "," index "," cbsz "," abid
                 attr-dict ":" functional-type(operands, res) }
  }

  // ---- WMMA：七种修饰器形状 ----

  schema Wmma<ab: any, cd: any> {
    Doc "Wave matrix multiply-accumulate without extra modifiers.";
    Operands   (a: ab, b: ab, c: cd);
    Results    (res: cd);
    Assembly   { a "," b "," c attr-dict ":" functional-type(operands, res) }
  }

  schema WmmaOpsel<ab: any, cd: any> {
    Doc "Wave matrix multiply-accumulate with the opsel output-selection attribute.";
    Operands   (a: ab, b: ab, c: cd);
    Results    (res: cd);
    Attributes (opsel: i1);
    Assembly   { a "," b "," c prop-dict attr-dict
                 ":" functional-type(operands, res) }
  }

  schema WmmaIU<ab: any, cd: any> {
    Doc "Integer wave matrix multiply-accumulate with sign and clamp modifiers.";
    Operands   (a: ab, b: ab, c: cd);
    Results    (res: cd);
    Attributes (signA: i1, signB: i1, clamp: i1);
    Assembly   { a "," b "," c prop-dict attr-dict
                 ":" functional-type(operands, res) }
  }

  schema WmmaModsC<ab: any, ctype: any, rtype: any> {
    Doc "Wave matrix multiply-accumulate with modC and reuse modifiers.";
    Operands   (a: ab, b: ab, c: ctype);
    Results    (res: rtype);
    Attributes (modC: any, reuseA: i1, reuseB: i1);
    Assembly   { a "," b "," c "," "modC" "=" modC prop-dict attr-dict
                 ":" functional-type(operands, res) }
  }

  schema WmmaModsABClamp<ab: any, cd: any> {
    Doc "Integer wave matrix multiply-accumulate with sign, reuse and clamp modifiers.";
    Operands   (a: ab, b: ab, c: cd);
    Results    (res: cd);
    Attributes (signA: i1, signB: i1, reuseA: i1, reuseB: i1, clamp: i1);
    Assembly   { a "," b "," c prop-dict attr-dict
                 ":" functional-type(operands, res) }
  }

  schema WmmaScale<ab: any, cd: any, exp: any> {
    Doc "Scaled wave matrix multiply-accumulate with format and scale-type modifiers.";
    Operands   (a: ab, b: ab, c: cd, scaleA: exp, scaleB: exp);
    Results    (res: cd);
    Attributes (fmtA: any, fmtB: any, modC: any, scaleAType: any,
                fmtScaleA: any, scaleBType: any, fmtScaleB: any,
                reuseA: i1, reuseB: i1);
    Assembly   { a "," b "," c "," scaleA "," scaleB ","
                 "fmtA" "=" fmtA "," "fmtB" "=" fmtB "," "modC" "=" modC ","
                 "scaleAType" "=" scaleAType "," "fmtScaleA" "=" fmtScaleA ","
                 "scaleBType" "=" scaleBType "," "fmtScaleB" "=" fmtScaleB
                 prop-dict attr-dict ":" functional-type(operands, res) }
  }

  schema WmmaScaleF4<ab: any, cd: any, exp: any> {
    Doc "Scaled F4 wave matrix multiply-accumulate with modC and scale modifiers.";
    Operands   (a: ab, b: ab, c: cd, scaleA: exp, scaleB: exp);
    Results    (res: cd);
    Attributes (modC: any, scaleAType: any, fmtScaleA: any,
                scaleBType: any, fmtScaleB: any, reuseA: i1, reuseB: i1);
    Assembly   { a "," b "," c "," scaleA "," scaleB ","
                 "modC" "=" modC ","
                 "scaleAType" "=" scaleAType "," "fmtScaleA" "=" fmtScaleA ","
                 "scaleBType" "=" scaleBType "," "fmtScaleB" "=" fmtScaleB
                 prop-dict attr-dict ":" functional-type(operands, res) }
  }

  // ---- 点积 ----

  schema Dot<atype: any, btype: any, ctype: any> {
    Doc "Packed intra-lane dot product with the optional clamp modifier.";
    Operands   (a: atype, b: btype, c: ctype);
    Results    (res: ctype);
    Attributes (clamp: i1);
    Properties [pure];
    Assembly   { a "," b "," c prop-dict attr-dict
                 ":" functional-type(operands, res) }
  }

  schema DotNoClamp<atype: any, btype: any, ctype: any> {
    Doc "Packed intra-lane dot product without a clamp modifier.";
    Operands   (a: atype, b: btype, c: ctype);
    Results    (res: ctype);
    Properties [pure];
    Assembly   { a "," b "," c attr-dict ":" functional-type(operands, res) }
  }

  schema Sudot {
    Doc "Mixed-signedness packed dot product with per-operand sign and clamp modifiers.";
    Operands   (a: i32, b: i32, c: i32);
    Results    (res: i32);
    Attributes (signA: i1, signB: i1, clamp: i1);
    Properties [pure];
    Assembly   { a "," b "," c prop-dict attr-dict
                 ":" functional-type(operands, res) }
  }

  // ---- SWMMAC：五种修饰器形状 ----

  schema SwmmacV<ab: any, cd: any> {
    Doc "Sparse wave matrix multiply-accumulate with an index sparsity operand.";
    Operands   (a: ab, b: ab, c: cd, index: i32);
    Results    (res: cd);
    Assembly   { a "," b "," c "," index attr-dict
                 ":" functional-type(operands, res) }
  }

  schema SwmmacReuse<ab: any, cd: any> {
    Doc "Sparse wave matrix multiply-accumulate with index and reuse controls.";
    Operands   (a: ab, b: ab, c: cd, index: i32);
    Results    (res: cd);
    Attributes (reuseA: i1, reuseB: i1);
    Assembly   { a "," b "," c "," index prop-dict attr-dict
                 ":" functional-type(operands, res) }
  }

  schema SwmmacIU<ab: any, cd: any> {
    Doc "Integer sparse wave matrix multiply-accumulate with sign and clamp modifiers.";
    Operands   (a: ab, b: ab, c: cd, index: i32);
    Results    (res: cd);
    Attributes (signA: i1, signB: i1, clamp: i1);
    Assembly   { a "," b "," c "," index prop-dict attr-dict
                 ":" functional-type(operands, res) }
  }

  schema SwmmacModsAB<ab: any, ctype: any, rtype: any> {
    Doc "Sparse wave matrix multiply-accumulate with sign and reuse modifiers.";
    Operands   (a: ab, b: ab, c: ctype, index: i32);
    Results    (res: rtype);
    Attributes (signA: i1, signB: i1, reuseA: i1, reuseB: i1);
    Assembly   { a "," b "," c "," index prop-dict attr-dict
                 ":" functional-type(operands, res) }
  }

  schema SwmmacModsABClamp<ab: any, ctype: any, rtype: any> {
    Doc "Integer sparse wave matrix multiply-accumulate with sign, reuse and clamp modifiers.";
    Operands   (a: ab, b: ab, c: ctype, index: i32);
    Results    (res: rtype);
    Attributes (signA: i1, signB: i1, reuseA: i1, reuseB: i1, clamp: i1);
    Assembly   { a "," b "," c "," index prop-dict attr-dict
                 ":" functional-type(operands, res) }
  }

  // ---- LDS 转置读与 tensor 搬运 ----

  schema LdsRead {
    Doc "Transposed read from LDS; the mnemonic names the transpose width and result bit width.";
    Operands   (ptr: any);
    Results    (res: any);
    Properties [memory_effect(read)];
    Assembly   { ptr prop-dict attr-dict ":" type(ptr) "->" type(res) }
  }

  schema TensorLds {
    Doc "Move a tensor tile between global memory and LDS through five descriptor groups.";
    Operands   (dgroup0: vector<i32, 4>, dgroup1: vector<i32, 8>,
                dgroup2: vector<i32, 4>, dgroup3: vector<i32, 4>,
                dgroup4: vector<i32, 8>);
    Attributes (cachePolicy: any);
    Assembly   { dgroup0 "," dgroup1 "," dgroup2 "," dgroup3 "," dgroup4 ","
                 custom<CachePolicy>(cachePolicy) prop-dict attr-dict
                 ":" type(dgroup0) "," type(dgroup1) }
  }

  // ---- 数学近似 ----

  schema MathOp {
    Doc "Hardware approximation of one floating-point function.";
    Operands   (arg: float);
    Results    (res: float);
    Properties [pure];
    Assembly   { arg qualified(type(arg)) attr-dict "->" qualified(type(res)) }
  }

  // ---- raw pointer buffer 原子返回 ----

  schema RawPtrAtomicRet {
    Doc "Atomic on a raw buffer resource given as a pointer; returns the old value.";
    Operands   (vdata: any, rsrc: any, offset: i32, soffset: i32);
    Results    (res: any);
    Attributes (aux: any);
    Properties [memory_effect(read), memory_effect(write), same_type(res, vdata)];
    Assembly   { vdata "," rsrc "," offset "," soffset ","
                 custom<CachePolicy>(aux) prop-dict attr-dict ":" type(vdata) }
  }
  schema TrLoad {
    Doc "Transposed load from global or LDS memory to a register vector; the mnemonic fixes the transpose width and result element type.";
    Operands   (ptr: any);
    Results    (res: any);
    Properties [memory_effect(read)];
    Assembly   { ptr prop-dict attr-dict ":" qualified(type(ptr)) "->" type(res) }
  }

  schema AsyncLdsCopy {
    Doc "Asynchronously copy data between a global pointer and LDS at a constant `offset` with cache policy `aux`; no completion wait is inserted.";
    Operands   (globalPtr: any, ldsPtr: any);
    Attributes (offset: i32, aux: any);
    Properties [memory_effect(read), memory_effect(write)];
    Assembly   { globalPtr "," ldsPtr "," offset "," custom<CachePolicy>(aux) prop-dict attr-dict ":" qualified(type(globalPtr)) "," qualified(type(ldsPtr)) }
  }

  schema ClusterAsyncLdsCopy {
    Doc "Broadcast-load data from global memory into LDS for a cluster of workgroups at a constant `offset`, with cache policy `cpol` and a per-workgroup `mask`.";
    Operands   (globalPtr: any, ldsPtr: any, mask: i32);
    Attributes (offset: i32, cpol: any);
    Properties [memory_effect(read), memory_effect(write)];
    Assembly   { globalPtr "," ldsPtr "," offset "," custom<CachePolicy>(cpol) "," mask prop-dict attr-dict ":" qualified(type(globalPtr)) "," qualified(type(ldsPtr)) }
  }

  schema CvtPkScale<st: any, rt: any> {
    Doc "Scale packed low-precision inputs (selected by `scaleSel`) by the exponent of `scale` and convert them to the result vector.";
    Operands   (src: st, scale: i32);
    Results    (res: rt);
    Attributes (scaleSel: i32);
    Properties [pure];
    Assembly   { attr-dict src "," scale "[" scaleSel "]" ":" type(res) }
  }

  schema CvtScaleF32<st: any, rt: any> {
    Doc "Scale and convert packed inputs to the result vector, dividing or multiplying by the exponent part of `scale`.";
    Operands   (src: st, scale: f32);
    Results    (res: rt);
    Properties [pure];
    Assembly   { attr-dict src "," scale ":" type(res) }
  }

  schema CvtScaleF32Sr<st: any, rt: any> {
    Doc "Scale and convert packed inputs to the result vector by the exponent part of `scale`, using `seed` for stochastic rounding.";
    Operands   (src: st, seed: i32, scale: f32);
    Results    (res: rt);
    Properties [pure];
    Assembly   { attr-dict src "," seed "," scale ":" type(res) }
  }

  schema CvtScalef32TwoPk16<rt: any> {
    Doc "Scale two vector<16xf32> operands (logically concatenated) by the exponent part of `scale` and convert them to 32 packed values.";
    Operands   (src0: vector<f32, 16>, src1: vector<f32, 16>, scale: f32);
    Results    (res: rt);
    Properties [pure];
    Assembly   { attr-dict src0 "," src1 "," scale ":" type(res) }
  }

  schema CvtScalef32ToF16 {
    Doc "Scale the byte selected by `srcSelIndex` from `src` by the exponent part of `scale`, convert it to f16 and insert it at `dstLoHiSel` of `oldVdst`.";
    Operands   (oldVdst: vector<f16, 2>, src: i32, scale: f32);
    Results    (res: vector<f16, 2>);
    Attributes (srcSelIndex: i32, dstLoHiSel: i1);
    Properties [pure];
    Assembly   { attr-dict src "[" srcSelIndex "]" "," scale "->" oldVdst "[" dstLoHiSel "]" ":" type(res) }
  }

  schema CvtScalef32FromPacked<rt: any> {
    Doc "Scale the packed value selected by `srcSelIndex` from `src` by the exponent part of `scale` and convert it to the result type.";
    Operands   (src: i32, scale: f32);
    Results    (res: rt);
    Attributes (srcSelIndex: i32);
    Properties [pure];
    Assembly   { attr-dict src "[" srcSelIndex "]" "," scale ":" type(res) }
  }

  schema CvtScalef32PkToVec<rt: any> {
    Doc "Scale the two packed low-precision values selected by `srcLoHiSel` from `src` by the exponent part of `scale` and convert them to the result vector.";
    Operands   (src: i32, scale: f32);
    Results    (res: rt);
    Attributes (srcLoHiSel: i1);
    Properties [pure];
    Assembly   { attr-dict src "[" srcLoHiSel "]" "," scale ":" type(res) }
  }

  schema CvtScalef32PkFromVec2<st: any> {
    Doc "Scale two packed values in `src0` by the exponent part of `scale`, convert them to two low-precision bytes and insert them at `dstLoHiSel` of `oldVdst`.";
    Operands   (oldVdst: vector<i16, 2>, src0: st, scale: f32);
    Results    (res: vector<i16, 2>);
    Attributes (dstLoHiSel: i1);
    Properties [pure];
    Assembly   { attr-dict src0 "," scale "->" oldVdst "[" dstLoHiSel "]" ":" type(res) }
  }

  schema CvtScalef32PkFromTwoF32<ot: any, rt: any> {
    Doc "Scale two f32 operands by the exponent part of `scale`, convert them to two packed bytes and insert them at `dstLoHiSel` of `oldVdst`.";
    Operands   (oldVdst: ot, src0: f32, src1: f32, scale: f32);
    Results    (res: rt);
    Attributes (dstLoHiSel: i1);
    Properties [pure];
    Assembly   { attr-dict src0 "," src1 "," scale "->" oldVdst "[" dstLoHiSel "]" ":" type(res) }
  }

  schema CvtScalef32SrToByte<st: any> {
    Doc "Convert `src0` to a low-precision byte with `seed` stochastic rounding, dividing by the exponent part of `scale`, and replace byte `dstSelIndex` of `oldVdst`.";
    Operands   (oldVdst: i32, src0: st, seed: i32, scale: f32);
    Results    (res: i32);
    Attributes (dstSelIndex: i32);
    Properties [pure];
    Assembly   { attr-dict src0 "," seed "," scale "->" oldVdst "[" dstSelIndex "]" ":" type(res) }
  }

  schema CvtScalef32PkFp4<st: any> {
    Doc "Scale two packed values in `src` by the exponent part of `scale`, convert them to packed fp4 and replace byte `dstSelIndex` of `oldVdst`.";
    Operands   (oldVdst: i32, src: st, scale: f32);
    Results    (res: i32);
    Attributes (dstSelIndex: i32);
    Properties [pure];
    Assembly   { attr-dict src "," scale "->" oldVdst "[" dstSelIndex "]" ":" type(res) }
  }

  schema CvtScalef32SrPkFp4<st: any> {
    Doc "Scale two packed values in `src` by the exponent part of `scale`, convert them to packed fp4 with `seed` stochastic rounding and replace byte `dstSelIndex` of `oldVdst`.";
    Operands   (oldVdst: i32, src: st, seed: i32, scale: f32);
    Results    (res: i32);
    Attributes (dstSelIndex: i32);
    Properties [pure];
    Assembly   { attr-dict src "," seed "," scale "->" oldVdst "[" dstSelIndex "]" ":" type(res) }
  }

  op mbcnt.lo from Mbcnt {
    Doc "Masked bit count of threads below the current lane in a wavefront; `in0` is the lane mask and `in1` the additive base.";
  }
  op mbcnt.hi from Mbcnt {
    Doc "Masked bit count of threads below the current lane in a wavefront; `in0` is the lane mask and `in1` the additive base.";
  }
  op ds_swizzle {
    Doc "Data-sharing swizzle within a wavefront; `offset` encodes the 16-bit swizzle pattern of ds_swizzle_b32.";
    Operands   (src: i32, offset: i32);
    Results    (res: i32);
    Assembly   { src "," offset attr-dict ":" "(" type(src) "," type(offset) ")" "->" type(res) }
  }
  op ds_bpermute {
    Doc "Backward (pull) permute across lanes: each lane reads `src` from the lane whose byte address is `index`, so lane id = index / 4.";
    Operands   (index: i32, src: i32);
    Results    (res: i32);
    Assembly   { index "," src attr-dict ":" "(" type(index) "," type(src) ")" "->" type(res) }
  }
  op ballot {
    Doc "Bit mask of the 1-bit predicate from every lane; bit n is the predicate contributed by lane n.";
    Operands   (pred: i1);
    Results    (res: i64);
    Assembly   { pred attr-dict ":" type(res) }
  }
  op readfirstlane {
    Doc "Return the value held by the lowest active lane of `src`; scalar and vector forms share one type.";
    Operands   (src: lane);
    Results    (res: lane);
    Properties [same_type(res, src)];
    Assembly   { src attr-dict ":" type(res) }
  }
  op readlane {
    Doc "Return the value of `src0` in the lane selected by `src1`; src0 and the result share one type.";
    Operands   (src0: lane, src1: i32);
    Results    (res: lane);
    Properties [same_type(res, src0)];
    Assembly   { src0 "," src1 attr-dict ":" "(" type(src0) "," type(src1) ")" "->" type(res) }
  }
