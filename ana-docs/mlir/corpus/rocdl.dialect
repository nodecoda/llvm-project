    Doc "Broadcast-load 8 bits from global memory into LDS for a cluster of workgroups at constant `offset`, with cache policy `cpol` and per-workgroup `mask` (gfx1250+).";
  }
  op tensor.load.to.lds from TensorLds {
    Doc "Move a tensor tile between global memory and LDS through five descriptor groups, with an optional cache policy.";
  }
  op tensor.store.from.lds from TensorLds {
    Doc "Move a tensor tile between global memory and LDS through five descriptor groups, with an optional cache policy.";
  }
  op make.buffer.rsrc {
    Doc "Build a buffer resource (pointer in address space 8) from a base pointer, an i16 stride, the number of records and i32 flags.";
    Operands   (base: any, stride: i16, numRecords: integer, flags: i32);
    Results    (res: any);
    Properties [pure];
    Assembly   { operands attr-dict ":" type(base) "," type(numRecords) "to" type(res) }
  }
  op raw.ptr.buffer.load {
    Doc "Load from the raw buffer resource `rsrc` at offset/soffset with a cache policy; returns the loaded value.";
    Operands   (rsrc: any, offset: i32, soffset: i32);
    Results    (res: any);
    Attributes (aux: any);
    Properties [memory_effect(read)];
    Assembly   { rsrc "," offset "," soffset "," custom<CachePolicy>(aux) prop-dict attr-dict ":" type(res) }
  }
  op ptr.s.buffer.load {
    Doc "Load from the raw buffer resource `rsrc` at `offset`, additionally marking the load invariant in LLVM IR.";
    Operands   (rsrc: any, offset: i32);
    Results    (res: any);
    Attributes (aux: any);
    Properties [memory_effect(read)];
    Assembly   { rsrc "," offset "," custom<CachePolicy>(aux) prop-dict attr-dict ":" type(res) }
  }
  op raw.ptr.buffer.load.lds {
    Doc "Load from raw buffer resource `rsrc` into LDS at `ldsPtr`, using size, voffset, soffset and offset.";
    Operands   (rsrc: any, ldsPtr: any, size: i32, voffset: i32, soffset: i32, offset: i32);
    Attributes (aux: any);
    Properties [memory_effect(read), memory_effect(write)];
    Assembly   { rsrc "," ldsPtr "," size "," voffset "," soffset "," offset "," custom<CachePolicy>(aux) prop-dict attr-dict }
  }
  op raw.ptr.buffer.load.async.lds {
    Doc "Async variant of raw.ptr.buffer.load.lds; the compiler does not insert completion waits, so pair it with asyncmark/wait.asyncmark.";
    Operands   (rsrc: any, ldsPtr: any, size: i32, voffset: i32, soffset: i32, offset: i32);
    Attributes (aux: any);
    Properties [memory_effect(read), memory_effect(write)];
    Assembly   { rsrc "," ldsPtr "," size "," voffset "," soffset "," offset "," custom<CachePolicy>(aux) prop-dict attr-dict }
  }
  op raw.ptr.buffer.store {
    Doc "Store `vdata` to raw buffer resource `rsrc` at offset/soffset with a cache policy.";
    Operands   (vdata: any, rsrc: any, offset: i32, soffset: i32);
    Attributes (aux: any);
    Properties [memory_effect(write)];
    Assembly   { vdata "," rsrc "," offset "," soffset "," custom<CachePolicy>(aux) prop-dict attr-dict ":" type(vdata) }
  }
  op raw.ptr.buffer.atomic.cmpswap {
    Doc "Atomic compare-and-swap on raw buffer resource `rsrc`; src, cmp and the result share one type.";
    Operands   (src: any, cmp: any, rsrc: any, offset: i32, soffset: i32);
    Results    (res: any);
    Attributes (aux: any);
    Properties [memory_effect(read), memory_effect(write), same_type(res, src), same_type(src, cmp)];
    Assembly   { src "," cmp "," rsrc "," offset "," soffset "," custom<CachePolicy>(aux) prop-dict attr-dict ":" type(res) }
  }
  op raw.ptr.buffer.atomic.fmax from RawPtrAtomicRet {
    Doc "Atomic 'fmax' on a raw buffer resource given as a pointer; returns the old value.";
  }
  op raw.ptr.buffer.atomic.smax from RawPtrAtomicRet {
    Doc "Atomic 'smax' on a raw buffer resource given as a pointer; returns the old value.";
  }
  op raw.ptr.buffer.atomic.umin from RawPtrAtomicRet {
    Doc "Atomic 'umin' on a raw buffer resource given as a pointer; returns the old value.";
  }
  op raw.ptr.buffer.atomic.fadd from RawPtrAtomicRet {
    Doc "Atomic 'fadd' on a raw buffer resource given as a pointer; returns the old value.";
  }
  op raw.buffer.load {
    Doc "Deprecated load whose buffer resource is a vector<4xi32>; use raw.ptr.buffer.load with a make.buffer.rsrc resource instead.";
    Operands   (rsrc: vector<i32, 4>, offset: i32, soffset: i32);
    Results    (res: any);
    Attributes (aux: any);
    Assembly   { rsrc "," offset "," soffset "," custom<CachePolicy>(aux) attr-dict ":" type(res) }
  }
  op raw.buffer.store {
    Doc "Deprecated store whose buffer resource is a vector<4xi32>; use raw.ptr.buffer.store instead.";
    Operands   (vdata: any, rsrc: vector<i32, 4>, offset: i32, soffset: i32);
    Attributes (aux: any);
    Assembly   { vdata "," rsrc "," offset "," soffset "," custom<CachePolicy>(aux) attr-dict ":" type(vdata) }
  }
  op raw.buffer.atomic.cmpswap {
    Doc "Deprecated compare-and-swap whose buffer resource is a vector<4xi32>; src, cmp and the result share one type.";
    Operands   (src: any, cmp: any, rsrc: vector<i32, 4>, offset: i32, soffset: i32);
    Results    (res: any);
    Attributes (aux: any);
    Properties [same_type(res, src), same_type(src, cmp)];
    Assembly   { attr-dict "(" src "," cmp "," rsrc "," offset "," soffset "," custom<CachePolicy>(aux) ")" ":" type(res) "," type(rsrc) }
  }
  op global.prefetch {
    Doc "Prefetch one byte per lane from global memory into the WGP or L2 cache with the given cache policy; gfx1250+.";
    Operands   (ptr: any);
    Attributes (cachePolicy: any);
    Properties [memory_effect(read), memory_effect(write)];
    Assembly   { ptr "," custom<CachePolicy>(cachePolicy) prop-dict attr-dict ":" qualified(type(ptr)) }
  }
  op flat.prefetch {
    Doc "Prefetch one byte per lane from flat memory into the WGP or L2 cache with the given cache policy; gfx1250+.";
    Operands   (ptr: any);
    Attributes (cachePolicy: any);
    Properties [memory_effect(read), memory_effect(write)];
    Assembly   { ptr "," custom<CachePolicy>(cachePolicy) prop-dict attr-dict ":" qualified(type(ptr)) }
  }
  op ds.atomic.barrier.arrive.rtn.b64 {
    Doc "Wait on the DS barrier at `barrierPtr` and decrement its pending count by `val`, returning the old 64-bit barrier state; gfx1250+.";
    Operands   (barrierPtr: any, val: i64);
    Results    (res: i64);
    Properties [memory_effect(read), memory_effect(write)];
    Assembly   { barrierPtr "," val prop-dict attr-dict ":" qualified(type(barrierPtr)) "," type(val) "->" type(res) }
  }
  op ds.atomic.async.barrier.arrive.b64 {
    Doc "Fire-and-forget DS barrier arrive at `barrierPtr`; ordered with async LDS loads and tracked by ASYNCCNT; gfx1250+.";
    Operands   (barrierPtr: any);
    Properties [memory_effect(read), memory_effect(write)];
    Assembly   { barrierPtr prop-dict attr-dict ":" qualified(type(barrierPtr)) }
  }
  op raw.buffer.atomic.fadd {
    Doc "Deprecated atomic floating-point add on a vector<4xi32> buffer resource; vdata and the result share one type.";
    Operands   (vdata: any, rsrc: vector<i32, 4>, offset: i32, soffset: i32);
    Results    (res: any);
    Attributes (aux: any);
    Properties [same_type(res, vdata)];
    Assembly   { vdata "," rsrc "," offset "," soffset "," custom<CachePolicy>(aux) attr-dict ":" type(vdata) }
  }
  op raw.buffer.atomic.fmax {
    Doc "Deprecated atomic floating-point max on a vector<4xi32> buffer resource; vdata and the result share one type.";
    Operands   (vdata: any, rsrc: vector<i32, 4>, offset: i32, soffset: i32);
    Results    (res: any);
    Attributes (aux: any);
    Properties [same_type(res, vdata)];
    Assembly   { vdata "," rsrc "," offset "," soffset "," custom<CachePolicy>(aux) attr-dict ":" type(vdata) }
  }
  op raw.buffer.atomic.smax {
    Doc "Deprecated atomic signed integer max on a vector<4xi32> buffer resource; vdata and the result share one type.";
    Operands   (vdata: any, rsrc: vector<i32, 4>, offset: i32, soffset: i32);
    Results    (res: any);
    Attributes (aux: any);
    Properties [same_type(res, vdata)];
    Assembly   { vdata "," rsrc "," offset "," soffset "," custom<CachePolicy>(aux) attr-dict ":" type(vdata) }
  }
  op raw.buffer.atomic.umin {
    Doc "Deprecated atomic unsigned integer min on a vector<4xi32> buffer resource; vdata and the result share one type.";
    Operands   (vdata: any, rsrc: vector<i32, 4>, offset: i32, soffset: i32);
    Results    (res: any);
    Attributes (aux: any);
    Properties [same_type(res, vdata)];
    Assembly   { vdata "," rsrc "," offset "," soffset "," custom<CachePolicy>(aux) attr-dict ":" type(vdata) }
  }
  op update.dpp {
    Doc "Data-parallel-primitives update: combines `old` and `src` under the dppCtrl/rowMask/bankMask/boundCtrl modifiers; old, src and the result share one type.";
    Operands   (old: lane, src: lane);
    Results    (res: lane);
    Attributes (dppCtrl: i32, rowMask: i32, bankMask: i32, boundCtrl: i1);
    Properties [same_type(res, src), same_type(src, old)];
    Assembly   { attr-dict old "," src "with" dppCtrl "," rowMask "," bankMask "," boundCtrl ":" type(src) }
  }
  op permlanex16 {
    Doc "Cross-row 16-lane permutation with immediate fi/boundControl modifiers; res, old and src0 share one type and src1/src2 share another.";
    Operands   (old: lane, src0: lane, src1: i32, src2: i32);
    Results    (res: lane);
    Attributes (fi: i1, boundControl: i1);
    Properties [same_type(res, old), same_type(old, src0), same_type(src1, src2)];
    Assembly   { attr-dict old "," src0 "," src1 "," src2 "," fi "," boundControl ":" type(src0) "," type(src1) }
  }
  op permlane16.swap {
    Doc "Swap lanes between groups of 16 threads; the result is the LLVM struct pair (i32, i32).";
    Operands   (old: i32, src: i32);
    Results    (res: any);
    Attributes (fi: i1, boundControl: i1);
    Assembly   { attr-dict old "," src "," fi "," boundControl ":" "(" type(old) "," type(src) ")" "->" type(res) }
  }
  op permlane32.swap {
    Doc "Swap lanes between groups of 32 threads; the result is the LLVM struct pair (i32, i32).";
    Operands   (old: i32, src: i32);
    Results    (res: any);
    Attributes (fi: i1, boundControl: i1);
    Assembly   { attr-dict old "," src "," fi "," boundControl ":" "(" type(old) "," type(src) ")" "->" type(res) }
  }
  op permlane16.var {
    Doc "Per-lane variable-selector intra-row (within 16-lane row) permutation; src1 carries the per-lane source indices.";
    Operands   (old: i32, src0: i32, src1: i32);
    Results    (res: i32);
    Attributes (fi: i1, boundControl: i1);
    Assembly   { attr-dict old "," src0 "," src1 "," fi "," boundControl ":" functional-type(operands, res) }
  }
  op permlanex16.var {
    Doc "Per-lane variable-selector cross-row permutation; src1 carries the per-lane source indices.";
    Operands   (old: i32, src0: i32, src1: i32);
    Results    (res: i32);
    Attributes (fi: i1, boundControl: i1);
    Assembly   { attr-dict old "," src0 "," src1 "," fi "," boundControl ":" functional-type(operands, res) }
  }
  op cvt.pkrtz {
    Doc "Convert two f32 values into a packed vector<2xf16> with round-to-zero.";
    Operands   (srcA: f32, srcB: f32);
    Results    (res: vector<f16, 2>);
    Properties [pure];
    Assembly   { attr-dict srcA "," srcB ":" type(res) }
  }
  op cvt.f32.bf8 {
    Doc "Convert the 8-bit bf8 value selected by `byteSel` from `srcA` to f32.";
    Operands   (srcA: i32);
    Results    (res: f32);
    Attributes (byteSel: i32);
    Properties [pure];
    Assembly   { attr-dict srcA "[" byteSel "]" ":" type(res) }
  }
  op cvt.f32.fp8 {
    Doc "Convert the 8-bit fp8 value selected by `byteSel` from `srcA` to f32.";
    Operands   (srcA: i32);
    Results    (res: f32);
    Attributes (byteSel: i32);
    Properties [pure];
    Assembly   { attr-dict srcA "[" byteSel "]" ":" type(res) }
  }
  op cvt.pk.f32.fp8 {
    Doc "Unpack the fp8 word selected by `wordSel` from `src` to a vector<2xf32>.";
    Operands   (src: i32);
    Results    (res: vector<f32, 2>);
    Attributes (wordSel: i1);
    Properties [pure];
    Assembly   { attr-dict src "[" wordSel "]" ":" type(res) }
  }
  op cvt.pk.f32.bf8 {
    Doc "Unpack the bf8 word selected by `wordSel` from `src` to a vector<2xf32>.";
    Operands   (src: i32);
    Results    (res: vector<f32, 2>);
    Attributes (wordSel: i1);
    Properties [pure];
    Assembly   { attr-dict src "[" wordSel "]" ":" type(res) }
  }
  op cvt.pk.bf8.f32 {
    Doc "Convert srcA and srcB to bf8 and replace the word selected by `wordSel` of `old`, returning the updated i32.";
    Operands   (srcA: f32, srcB: f32, old: i32);
    Results    (res: i32);
    Attributes (wordSel: i1);
    Properties [pure];
    Assembly   { attr-dict srcA "," srcB "->" old "[" wordSel "]" ":" type(res) }
  }
  op cvt.pk.fp8.f32 {
    Doc "Convert srcA and srcB to fp8 and replace the word selected by `wordSel` of `old`, returning the updated i32.";
    Operands   (srcA: f32, srcB: f32, old: i32);
    Results    (res: i32);
    Attributes (wordSel: i1);
    Properties [pure];
    Assembly   { attr-dict srcA "," srcB "->" old "[" wordSel "]" ":" type(res) }
  }
  op cvt.sr.bf8.f32 {
    Doc "Stochastic-rounding convert srcA to bf8 using the rounding factor in srcB, replacing the byte selected by `byteSel` of `old`.";
    Operands   (srcA: f32, srcB: i32, old: i32);
    Results    (res: i32);
    Attributes (byteSel: i32);
    Properties [pure];
    Assembly   { attr-dict srcA "," srcB "->" old "[" byteSel "]" ":" type(res) }
  }
  op cvt.sr.fp8.f32 {
    Doc "Stochastic-rounding convert srcA to fp8 using the rounding factor in srcB, replacing the byte selected by `byteSel` of `old`.";
    Operands   (srcA: f32, srcB: i32, old: i32);
    Results    (res: i32);
    Attributes (byteSel: i32);
    Properties [pure];
    Assembly   { attr-dict srcA "," srcB "->" old "[" byteSel "]" ":" type(res) }
  }
  op cvt.scalef32.pk.fp4.f32 {
    Doc "Scale src0 and src1 by the exponent of `scale`, convert to packed fp4 and replace byte `dstSelIndex` of `oldVdst`.";
    Operands   (oldVdst: i32, src0: f32, src1: f32, scale: f32);
    Results    (res: i32);
    Attributes (dstSelIndex: i32);
    Properties [pure];
