  op s.waitcnt {
    Doc "Wait for outstanding memory operations to complete; the i32 bitfield selects which counters must reach zero and is chipset-dependent.";
    Attributes (bitfield: i32);
    Assembly   { attr-dict bitfield }
  }
  op s.sleep {
    Doc "Sleep for at least `count` clock cycles.";
    Attributes (count: i32);
    Assembly   { attr-dict count }
  }
  op s.nop {
    Doc "Insert `count` NOP cycles.";
    Attributes (count: i16);
    Assembly   { attr-dict count }
  }
  op s.barrier {
    Doc "Workgroup barrier without memory fences; deprecated on gfx12+ in favour of s.barrier.signal and s.barrier.wait.";
    Assembly   { attr-dict }
  }
  op barrier {
    Doc "HIP __syncthreads equivalent: a workgroup-scoped release fence, amdgcn_s_barrier, then a workgroup-scoped acquire fence. Deprecated in favour of gpu.barrier.";
    Assembly   { attr-dict }
  }
  op wave.barrier {
    Doc "Wave-level barrier synchronising lanes of one wavefront; carries no memory-ordering guarantee.";
    Assembly   { attr-dict }
  }
  op s.barrier.init {
    Doc "Initialise the named barrier at `ptr` with `memberCnt` participants; available on gfx1250+.";
    Operands   (ptr: any);
    Attributes (memberCnt: i32);
    Assembly   { ptr "member_cnt" "=" memberCnt attr-dict ":" qualified(type(ptr)) }
  }
  op s.barrier.signal {
    Doc "Signal a named barrier by `id`; id -1 signals all barriers. Available on gfx1250+.";
    Attributes (id: i32);
    Assembly   { "id" "=" id attr-dict }
  }
  op s.barrier.signal.var {
    Doc "Signal a named barrier given by `ptr`; memberCnt 0 retains the count from initialisation. Available on gfx1250+.";
    Operands   (ptr: any);
    Attributes (memberCnt: i32);
    Assembly   { ptr "member_cnt" "=" memberCnt attr-dict ":" qualified(type(ptr)) }
  }
  op s.barrier.join {
    Doc "Join the named barrier given by `ptr`; available on gfx1250+.";
    Operands   (ptr: any);
    Assembly   { ptr attr-dict ":" qualified(type(ptr)) }
  }
  op s.barrier.leave {
    Doc "Leave the named barrier selected by `id`; available on gfx1250+.";
    Attributes (id: i16);
    Assembly   { "id" "=" id attr-dict }
  }
  op s.barrier.wait {
    Doc "Wait on the barrier selected by `id`; id -1 waits on all barriers. Available on gfx1200+.";
    Attributes (id: i16);
    Assembly   { "id" "=" id attr-dict }
  }
  op s.barrier.signal.isfirst {
    Doc "Signal barrier `id` and return whether this wave was first to arrive; available on gfx1200+.";
    Attributes (id: i32);
    Results    (res: i1);
    Assembly   { "id" "=" id attr-dict "->" type(res) }
  }
  op s.get.barrier.state {
    Doc "Query the state of barrier `id`; available on gfx1200+.";
    Attributes (id: i32);
    Results    (res: i32);
    Assembly   { "id" "=" id attr-dict "->" type(res) }
  }
  op s.get.named.barrier.state {
    Doc "Query the state of the named barrier given by `ptr`; available on gfx1250+.";
    Operands   (ptr: any);
    Results    (res: i32);
    Assembly   { ptr attr-dict ":" qualified(type(ptr)) "->" type(res) }
  }
  op s.wakeup.barrier {
    Doc "Wake waves waiting at the named barrier given by `ptr` without releasing them; available on gfx1250+.";
    Operands   (ptr: any);
    Assembly   { ptr attr-dict ":" qualified(type(ptr)) }
  }
  op s.wait.dscnt {
    Doc "Wait until DSCNT is less than or equal to `count`; gfx12+.";
    Attributes (count: i16);
    Assembly   { count attr-dict }
  }
  op s.wait.loadcnt {
    Doc "Wait until LOADCNT is less than or equal to `count`; gfx12+.";
    Attributes (count: i16);
    Assembly   { count attr-dict }
  }
  op s.wait.storecnt {
    Doc "Wait until STORECNT is less than or equal to `count`; gfx12+.";
    Attributes (count: i16);
    Assembly   { count attr-dict }
  }
  op s.wait.expcnt {
    Doc "Wait until EXPCNT is less than or equal to `count`; gfx12+.";
    Attributes (count: i16);
    Assembly   { count attr-dict }
  }
  op s.wait.asynccnt {
    Doc "Wait until ASYNCCNT is less than or equal to `count`; gfx1250+.";
    Attributes (count: i16);
    Assembly   { count attr-dict }
  }
  op s.wait.tensorcnt {
    Doc "Wait until TENSORCNT is less than or equal to `count`; gfx1250+.";
    Attributes (count: i16);
    Assembly   { count attr-dict }
  }
  op asyncmark {
    Doc "Mark the end of an asynchronous-operation group. `stages` is a mask of async stages (all, or a stage such as tensor); every named stage gets the mark. Available on gfx9+.";
    Attributes (stages: any);
    Assembly   { if stages { "stages" "=" stages } attr-dict }
  }
  op wait.asyncmark {
    Doc "Wait until at most `count` async-operation groups remain unexecuted, counting each stage named by `stages` separately. Available on gfx9+.";
    Attributes (count: i16, stages: any);
    Assembly   { count if stages { "stages" "=" stages } attr-dict }
  }
  op s.setprio {
    Doc "Set the wavefront scheduling priority to `priority`.";
    Attributes (priority: i16);
    Assembly   { priority attr-dict }
  }
  op sched.barrier {
    Doc "Scheduling barrier whose mask is a bitfield of the instruction groups allowed to cross it (none, valu, vmem_read, vmem_write, ds_read, ds_write, all_vmem, all_ds, mfma_wmma).";
    Attributes (mask: any);
    Assembly   { mask attr-dict }
  }
  op sched.group.barrier {
    Doc "Scheduling group barrier with the scheduling-group mask, group size and group id.";
    Attributes (mask: any, size: i32, groupId: i32);
    Assembly   { mask "," size "," groupId attr-dict }
  }
