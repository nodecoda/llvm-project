  // ---- 特例形态 ----

  op intr.ldexp {
    Doc "Multiply by two raised to an integer exponent (LLVM_LoadExpOp, LLVMIntrinsicOps.td:135).";
    Operands   (val: float, exp: integer);
    Results    (res: float);
    Attributes (fastmathFlags: FastmathFlags = none);
    Properties [pure];
    Assembly   { "(" operands ")"
                 if fastmathFlags { "fastmath" fastmathFlags }
                 attr-dict ":" functional-type(operands, results) }
  }

  op intr.assume {
    Doc "Assume that cond holds, optionally with operand bundles; the bundle group prints through the OpBundles hook (LLVM_AssumeOp, LLVMIntrinsicOps.td:917).";
    Operands   (cond: i1, op_bundle_operands: variadic<llvm_type>);
    Attributes (op_bundle_tags: optional<array<i32>>);
    Assembly   { cond
                 if op_bundle_operands
                   { "(" custom<OpBundles>(op_bundle_operands,
                                           type(op_bundle_operands),
                                           op_bundle_tags) ")" }
                 ":" type(cond) attr-dict }
  }

  op intr.abs {
    Doc "Absolute value with an is_int_min_poison immediate (LLVM_AbsOp, LLVMIntrinsicOps.td:106); upstream has no assemblyFormat.";
    Operands   (in: integer);
    Results    (res: integer);
    Attributes (is_int_min_poison: bool);
    Properties [pure];
    Assembly   Generic;
  }

  op intr.annotation {
    Doc "Attach an annotation string to an integer value (LLVM_Annotation, LLVMIntrinsicOps.td); upstream has no assemblyFormat.";
    Operands   (integer: integer, annotation: ptr, fileName: ptr,
                line: i32);
    Results    (res: integer);
    Properties [same_type(res, integer), same_type(annotation, fileName)];
    Assembly   Generic;
  }

  op intr.ctlz {
    Doc "Count leading zeros; is_zero_poison is an immediate (LLVM_CountZerosIntrOp, LLVMIntrinsicOps.td:96); upstream has no assemblyFormat.";
    Operands   (in: integer);
    Results    (res: integer);
    Attributes (is_zero_poison: bool);
    Properties [pure, same_type(in, res)];
    Assembly   Generic;
  }

  op intr.cttz {
    Doc "Count trailing zeros; is_zero_poison is an immediate; upstream has no assemblyFormat.";
    Operands   (in: integer);
    Results    (res: integer);
    Attributes (is_zero_poison: bool);
    Properties [pure, same_type(in, res)];
    Assembly   Generic;
  }

  op intr.is.constant {
    Doc "Returns whether the argument is a constant at lowering time (LLVM_IsConstantOp); upstream has no assemblyFormat.";
    Operands   (val: llvm_type);
    Results    (res: i1);
    Properties [pure];
    Assembly   Generic;
  }

  op intr.is.fpclass {
    Doc "Test the class of a floating-point value against a bit mask attribute (LLVM_IsFPClass, LLVMIntrinsicOps.td:124); upstream has no assemblyFormat.";
    Operands   (in: float);
    Results    (res: i1);
    Attributes (bit: i32);
    Properties [pure];
    Assembly   Generic;
  }

  op intr.masked.load from MaskedLoadLike {
    Doc "Masked vector load from a pointer with an llvm.vector mask; alignment is a property.";
  }

  op intr.masked.gather from MaskedLoadLike {
    Doc "Masked gather from a vector of pointers; alignment is a property.";
  }

  op intr.masked.store {
    Doc "Masked vector store through a pointer (LLVM_MaskedStoreOp, LLVMIntrinsicOps.td:1140).";
    Operands   (value: vector, data: ptr, mask: vector);
    Attributes (alignment: optional<i64>);
    Assembly   { "(" value "," data "," mask ")"
                 if alignment { "," "alignment" "(" alignment ")" }
                 prop-dict attr-dict ":" type(value) "," type(mask) "into"
                 qualified(type(data)) }
  }

  op intr.masked.scatter {
    Doc "Masked scatter through a vector of pointers.";
    Operands   (value: vector, ptrs: vector, mask: vector);
    Attributes (alignment: optional<i64>);
    Assembly   { "(" value "," ptrs "," mask ")"
                 if alignment { "," "alignment" "(" alignment ")" }
                 prop-dict attr-dict ":" type(value) "," type(mask) "into"
                 type(ptrs) }
  }

  op intr.masked.compressstore {
    Doc "Compress the unmasked elements and store them contiguously (LLVM_masked_compressstore); upstream has no assemblyFormat.";
    Operands   (value: vector, ptr: ptr, mask: vector);
    Assembly   Generic;
  }

  op intr.masked.expandload {
    Doc "Load contiguously and expand into the unmasked lanes (LLVM_masked_expandload); upstream has no assemblyFormat.";
    Operands   (ptr: ptr, mask: vector);
    Results    (res: vector);
    Assembly   Generic;
  }

  op intr.memcpy {
    Doc "Copy a constant number of bytes (LLVM_MemcpyOp); upstream has no assemblyFormat.";
    Operands   (dst: ptr, src: ptr);
    Attributes (len: i64, isVolatile: bool);
    Assembly   Generic;
  }

  op intr.memmove {
    Doc "Copy a constant number of bytes allowing overlap; upstream has no assemblyFormat.";
    Operands   (dst: ptr, src: ptr);
    Attributes (len: i64, isVolatile: bool);
    Assembly   Generic;
  }

  op intr.memcpy.inline {
    Doc "Inlinable memcpy with a constant length; upstream has no assemblyFormat.";
    Operands   (dst: ptr, src: ptr);
    Attributes (len: i64, isVolatile: bool);
    Properties [memory_effect(read), memory_effect(write)];
    Assembly   Generic;
  }

  op intr.memset {
    Doc "Fill a constant number of bytes (LLVM_MemsetOp); upstream has no assemblyFormat.";
    Operands   (dst: ptr, val: i8);
    Attributes (len: i64, isVolatile: bool);
    Assembly   Generic;
  }

  op intr.memset.inline {
    Doc "Inlinable memset with a constant length; upstream has no assemblyFormat.";
    Operands   (dst: ptr, val: i8);
    Attributes (len: i64, isVolatile: bool);
    Assembly   Generic;
  }

  op intr.vp.merge {
    Doc "VP merge of two vectors on a mask (LLVM_VPMergeMinOp : LLVM_VPSelectBase<\"merge\">, LLVMIntrinsicOps.td:1940-1970); the base class concatenates \"vp.\" with the mnemonic, so the printed name is intr.vp.merge, not intr.merge. Upstream has no assemblyFormat.";
    Operands   (cond: vector, true_val: vector, false_val: vector, evl: i32);
    Results    (res: vector);
    Properties [pure];
    Assembly   Generic;
  }

  op intr.prefetch {
    Doc "Prefetch hint for an address; rw/hint/cache are immediate attributes (LLVM_Prefetch, LLVMIntrinsicOps.td:164); upstream has no assemblyFormat.";
    Operands   (addr: ptr);
    Attributes (rw: i32, hint: i32, cache: i32);
    Assembly   Generic;
  }

  op intr.ptr.annotation {
    Doc "Attach an annotation to a pointer and return it (LLVM_PtrAnnotation); upstream has no assemblyFormat.";
    Operands   (ptr: ptr, annotation: ptr, fileName: ptr, line: i32,
                attr: ptr);
    Results    (res: ptr);
    Properties [same_type(res, ptr), same_type(annotation, fileName)];
    Assembly   Generic;
  }

  op intr.var.annotation {
    Doc "Attach an annotation to an SSA value (LLVM_VarAnnotation); upstream has no assemblyFormat.";
    Operands   (val: ptr, annotation: ptr, fileName: ptr, line: i32,
                attr: ptr);
    Properties [same_type(annotation, fileName)];
    Assembly   Generic;
  }

  op intr.sadd.with.overflow {
    Doc "Signed addition returning {result, overflow} (LLVM_SAddWithOverflowOp); upstream has no assemblyFormat.";
    Operands   (a: integer, b: integer);
    Results    (res: struct);
    Properties [pure, same_element_type(a, b)];
    Assembly   Generic;
  }

  op intr.uadd.with.overflow {
    Doc "Unsigned addition returning {result, overflow}; upstream has no assemblyFormat.";
    Operands   (a: integer, b: integer);
    Results    (res: struct);
    Properties [pure, same_element_type(a, b)];
    Assembly   Generic;
  }

  op intr.ssub.with.overflow {
    Doc "Signed subtraction returning {result, overflow}; upstream has no assemblyFormat.";
    Operands   (a: integer, b: integer);
    Results    (res: struct);
    Properties [pure, same_element_type(a, b)];
    Assembly   Generic;
  }

  op intr.usub.with.overflow {
    Doc "Unsigned subtraction returning {result, overflow}; upstream has no assemblyFormat.";
    Operands   (a: integer, b: integer);
    Results    (res: struct);
    Properties [pure, same_element_type(a, b)];
    Assembly   Generic;
  }

  op intr.smul.with.overflow {
    Doc "Signed multiplication returning {result, overflow}; upstream has no assemblyFormat.";
    Operands   (a: integer, b: integer);
    Results    (res: struct);
    Properties [pure, same_element_type(a, b)];
    Assembly   Generic;
  }

  op intr.umul.with.overflow {
    Doc "Unsigned multiplication returning {result, overflow}; upstream has no assemblyFormat.";
    Operands   (a: integer, b: integer);
    Results    (res: struct);
    Properties [pure, same_element_type(a, b)];
    Assembly   Generic;
  }

  op intr.threadlocal.address {
    Doc "Address of a thread-local global for the current thread (LLVM_ThreadLocalAddressOp); upstream has no assemblyFormat.";
    Operands   (global: ptr);
    Results    (res: ptr);
    Properties [pure];
    Assembly   Generic;
  }

  op intr.vector.deinterleave2 {
    Doc "Split a vector into even and odd elements; upstream has no assemblyFormat.";
    Operands   (vec: vector);
    Results    (res: struct);
    Properties [pure];
    Assembly   Generic;
  }

  op intr.vector.interleave2 {
    Doc "Interleave two vectors; upstream has no assemblyFormat.";
    Operands   (vec1: vector, vec2: vector);
    Results    (res: vector);
    Properties [pure, same_type(vec1, vec2)];
    Assembly   Generic;
  }

  op intr.vp.load {
    Doc "Vector-predicated load with mask and explicit vector length; upstream has no assemblyFormat.";
    Operands   (ptr: ptr, mask: vector, evl: i32);
    Results    (res: vector);
    Assembly   Generic;
  }

  op intr.vp.store {
    Doc "Vector-predicated store with mask and explicit vector length; upstream has no assemblyFormat.";
    Operands   (val: vector, ptr: ptr, mask: vector, evl: i32);
    Assembly   Generic;
  }

  op intr.vscale {
    Doc "Runtime value of vscale for scalable vectors; upstream has no assemblyFormat.";
    Results    (res: i32);
    Assembly   Generic;
  }

  op intr.experimental.vp.strided.load {
    Doc "Strided vector-predicated load (LLVM_VPStridedLoadOp, LLVMIntrinsicOps.td:1973); upstream has no assemblyFormat.";
    Operands   (ptr: ptr, stride: integer, mask: vector, evl: i32);
    Results    (res: vector);
    Assembly   Generic;
  }

  op intr.experimental.vp.strided.store {
    Doc "Strided vector-predicated store (LLVM_VPStridedStoreOp); upstream has no assemblyFormat.";
    Operands   (val: vector, ptr: ptr, stride: integer, mask: vector,
                evl: i32);
    Assembly   Generic;
  }

  // ---- 向量归约 intrinsic ----

  schema VectorReduceInt {
    Doc "Integer vector reduction over a single vector (LLVM_VecReductionI, LLVMIntrinsicOps.td:1303-1306); upstream has no assemblyFormat, so the text channel is Generic.";
    Operands   (in: vector);
    Results    (res: integer);
    Properties [pure, same_element_type(in, res)];
    Assembly   Generic;
  }

  schema VectorReduceFloat {
    Doc "Float vector reduction over a single vector with optional fastmath; upstream assemblyFormat is `(operands) (fastmath<...>)? attr-dict : functional-type(operands, results)` (LLVM_VecReductionF, LLVMIntrinsicOps.td:1292-1301).";
    Operands   (in: vector);
    Results    (res: float);
    Attributes (fastmathFlags: FastmathFlags = none);
    Properties [pure, same_element_type(in, res)];
    Assembly   { "(" operands ")"
                 if fastmathFlags { "fastmath" fastmathFlags }
                 attr-dict ":" functional-type(operands, results) }
  }

  schema VectorReduceAcc {
    Doc "Float vector reduction with an initial value and permission to reassociate; same assemblyFormat shape as VectorReduceFloat (LLVM_VecReductionAccBase, LLVMIntrinsicOps.td:1310-1323).";
    Operands   (start_value: float, input: vector);
    Results    (res: float);
    Attributes (fastmathFlags: FastmathFlags = none);
    Properties [pure, same_element_type(start_value, res),
                same_element_type(input, res)];
    Assembly   { "(" operands ")"
                 if fastmathFlags { "fastmath" fastmathFlags }
                 attr-dict ":" functional-type(operands, results) }
  }

  op intr.vector.reduce.add from VectorReduceInt {
    Doc "Integer vector reduction add (LLVM_vector_reduce_add, LLVMIntrinsicOps.td:1328); upstream LLVM_VecReductionI has no assemblyFormat, so this is Generic.";
  }
  op intr.vector.reduce.and from VectorReduceInt {
    Doc "Integer vector reduction and (LLVM_vector_reduce_and, LLVMIntrinsicOps.td:1329); upstream LLVM_VecReductionI has no assemblyFormat, so this is Generic.";
  }
  op intr.vector.reduce.mul from VectorReduceInt {
    Doc "Integer vector reduction mul (LLVM_vector_reduce_mul, LLVMIntrinsicOps.td:1330); upstream LLVM_VecReductionI has no assemblyFormat, so this is Generic.";
  }
  op intr.vector.reduce.or from VectorReduceInt {
    Doc "Integer vector reduction or (LLVM_vector_reduce_or, LLVMIntrinsicOps.td:1331); upstream LLVM_VecReductionI has no assemblyFormat, so this is Generic.";
  }
  op intr.vector.reduce.smax from VectorReduceInt {
    Doc "Integer vector reduction smax (LLVM_vector_reduce_smax, LLVMIntrinsicOps.td:1332); upstream LLVM_VecReductionI has no assemblyFormat, so this is Generic.";
  }
  op intr.vector.reduce.smin from VectorReduceInt {
    Doc "Integer vector reduction smin (LLVM_vector_reduce_smin, LLVMIntrinsicOps.td:1333); upstream LLVM_VecReductionI has no assemblyFormat, so this is Generic.";
  }
  op intr.vector.reduce.umax from VectorReduceInt {
    Doc "Integer vector reduction umax (LLVM_vector_reduce_umax, LLVMIntrinsicOps.td:1334); upstream LLVM_VecReductionI has no assemblyFormat, so this is Generic.";
  }
  op intr.vector.reduce.umin from VectorReduceInt {
    Doc "Integer vector reduction umin (LLVM_vector_reduce_umin, LLVMIntrinsicOps.td:1335); upstream LLVM_VecReductionI has no assemblyFormat, so this is Generic.";
  }
  op intr.vector.reduce.xor from VectorReduceInt {
    Doc "Integer vector reduction xor (LLVM_vector_reduce_xor, LLVMIntrinsicOps.td:1336); upstream LLVM_VecReductionI has no assemblyFormat, so this is Generic.";
  }
  op intr.vector.reduce.fmax from VectorReduceFloat {
    Doc "Float vector reduction fmax with optional fastmath (LLVM_vector_reduce_fmax, LLVMIntrinsicOps.td:1338).";
  }
  op intr.vector.reduce.fmin from VectorReduceFloat {
    Doc "Float vector reduction fmin with optional fastmath (LLVM_vector_reduce_fmin, LLVMIntrinsicOps.td:1339).";
  }
  op intr.vector.reduce.fmaximum from VectorReduceFloat {
    Doc "Float vector reduction fmaximum with optional fastmath (LLVM_vector_reduce_fmaximum, LLVMIntrinsicOps.td:1340).";
  }
  op intr.vector.reduce.fminimum from VectorReduceFloat {
    Doc "Float vector reduction fminimum with optional fastmath (LLVM_vector_reduce_fminimum, LLVMIntrinsicOps.td:1341).";
  }
  op intr.vector.reduce.fmaximumnum from VectorReduceFloat {
    Doc "Float vector reduction fmaximumnum with optional fastmath (LLVM_vector_reduce_fmaximumnum, LLVMIntrinsicOps.td:1342).";
  }
  op intr.vector.reduce.fminimumnum from VectorReduceFloat {
    Doc "Float vector reduction fminimumnum with optional fastmath (LLVM_vector_reduce_fminimumnum, LLVMIntrinsicOps.td:1343).";
  }
  op intr.vector.reduce.fadd from VectorReduceAcc {
    Doc "Float vector reduction addition with an initial value (LLVM_vector_reduce_fadd, LLVMIntrinsicOps.td:1345); the initial value precedes the vector operand.";
  }
  op intr.vector.reduce.fmul from VectorReduceAcc {
    Doc "Float vector reduction multiply with an initial value (LLVM_vector_reduce_fmul, LLVMIntrinsicOps.td:1346); the initial value precedes the vector operand.";
  }

  // ---- VP reduce ----

  schema VPReduceInt {
    Doc "VP integer reduction with a start value, a mask and an explicit vector length; upstream records LLVM_VPReduce*Op have no assemblyFormat (LLVMIntrinsicOps.td:1941-1960).";
    Operands   (satrt_value: integer, val: vector, mask: vector, evl: i32);
    Results    (res: integer);
    Properties [pure];
    Assembly   Generic;
  }

  schema VPReduceFloat {
    Doc "VP float reduction with a start value, a mask and an explicit vector length (LLVM_VPReduceF*Op, no assemblyFormat).";
    Operands   (satrt_value: float, val: vector, mask: vector, evl: i32);
    Results    (res: float);
    Properties [pure];
    Assembly   Generic;
  }

  schema VPBinaryInt {
    Doc "VP integer binary operation with a mask and an explicit vector length (LLVM_VPBinaryBase, LLVMIntrinsicOps.td:1922).";
    Operands   (lhs: vector, rhs: vector, mask: vector, evl: i32);
    Results    (res: vector);
    Properties [pure];
    Assembly   Generic;
  }

  op intr.vp.reduce.add from VPReduceInt {
    Doc "VP integer reduction, addition (LLVM_VPReduceAddOp, LLVMIntrinsicOps.td:1952); upstream has no assemblyFormat. The core llvm.add op is a separate upstream record and is declared separately.";
  }

  op intr.vp.reduce.mul from VPReduceInt {
    Doc "VP integer reduction, multiply; upstream record LLVM_VPReduceMulOp.";
  }

  op intr.vp.reduce.and from VPReduceInt {
    Doc "VP integer reduction, and; upstream record LLVM_VPReduceAndOp.";
  }

  op intr.vp.reduce.or from VPReduceInt {
    Doc "VP integer reduction, or; upstream record LLVM_VPReduceOrOp.";
  }

  op intr.vp.reduce.xor from VPReduceInt {
    Doc "VP integer reduction, xor; upstream record LLVM_VPReduceXorOp.";
  }

  op intr.vp.reduce.smax from VPReduceInt {
    Doc "VP signed integer reduction, maximum; upstream record LLVM_VPReduceSMaxOp.";
  }

  op intr.vp.reduce.smin from VPReduceInt {
    Doc "VP signed integer reduction, minimum; upstream record LLVM_VPReduceSMinOp.";
  }

  op intr.vp.reduce.umax from VPReduceInt {
    Doc "VP unsigned integer reduction, maximum; upstream record LLVM_VPReduceUMaxOp.";
  }

  op intr.vp.reduce.umin from VPReduceInt {
    Doc "VP unsigned integer reduction, minimum; upstream record LLVM_VPReduceUMinOp.";
  }

  op intr.vp.reduce.fadd from VPReduceFloat {
    Doc "VP float reduction, add, with a start value; upstream record LLVM_VPReduceFAddOp (no assemblyFormat).";
  }

  op intr.vp.reduce.fmul from VPReduceFloat {
    Doc "VP float reduction, multiply; upstream record LLVM_VPReduceFMulOp.";
  }
  op intr.vp.reduce.fmax from VPReduceFloat {
    Doc "VP float reduction, maximum; upstream record LLVM_VPReduceFMaxOp.";
  }
  op intr.vp.reduce.fmin from VPReduceFloat {
    Doc "VP float reduction, minimum; upstream record LLVM_VPReduceFMinOp.";
  }
  op intr.vp.reduce.fmaximum from VPReduceFloat {
    Doc "VP float reduction, IEEE maximum; upstream record LLVM_VPReduceFMaximumOp.";
  }
  op intr.vp.reduce.fminimum from VPReduceFloat {
    Doc "VP float reduction, IEEE minimum; upstream record LLVM_VPReduceFMinimumOp.";
  }

  op intr.vp.sdiv from VPBinaryInt {
    Doc "VP integer division, signed (LLVM_VPSDivOp); upstream has no assemblyFormat.";
  }
  op intr.vp.udiv from VPBinaryInt {
    Doc "VP integer division, unsigned (LLVM_VPUDivOp).";
  }
  op intr.vp.srem from VPBinaryInt {
    Doc "VP integer remainder, signed (LLVM_VPSRemOp).";
  }
  op intr.vp.urem from VPBinaryInt {
    Doc "VP integer remainder, unsigned (LLVM_VPURemOp).";
  }

  // ---- 协程 intrinsic ----

  op intr.coro.id {
    Doc "Produce a coroutine id token; align/promise/coroaddr/fnaddrs print as a bare operand list (LLVM_CoroIdOp, LLVMIntrinsicOps.td:996).";
    Operands   (align: i32, promise: ptr, coroaddr: ptr,
                fnaddrs: array<ptr>);
    Results    (res: token);
    Assembly   { align "," promise "," coroaddr "," fnaddrs attr-dict ":"
                 functional-type(operands, results) }
  }

  op intr.coro.begin {
    Doc "Begin a coroutine from an id token and a memory pointer.";
    Operands   (token: token, mem: ptr);
    Results    (res: ptr);
    Assembly   { token "," mem attr-dict ":"
                 functional-type(operands, results) }
  }

  op intr.coro.alloc {
    Doc "Whether the coroutine frame must be heap-allocated.";
    Operands   (id: token);
    Results    (res: i1);
    Assembly   { id attr-dict ":" functional-type(operands, results) }
  }

  op intr.coro.size {
    Doc "Size of the coroutine frame.";
    Results    (res: i64);
    Assembly   { attr-dict ":" type(res) }
  }

  op intr.coro.align {
    Doc "Required alignment of the coroutine frame.";
    Results    (res: i64);
    Assembly   { attr-dict ":" type(res) }
  }

  op intr.coro.save {
    Doc "Save the coroutine state into a token.";
    Operands   (handle: ptr);
    Results    (res: token);
    Assembly   { handle attr-dict ":" functional-type(operands, results) }
  }

  op intr.coro.suspend {
    Doc "Suspend the coroutine; save is the token, final marks the final suspend.";
    Operands   (save: token, final: i1);
    Results    (res: i8);
    Assembly   { save "," final attr-dict ":" type(res) }
  }

  op intr.coro.end {
    Doc "Mark the end of the coroutine body; unwind selects the unwind path.";
    Operands   (handle: ptr, unwind: i1, retvals: variadic<llvm_type>);
    Results    (res: i1);
    Assembly   { handle "," unwind "," retvals attr-dict ":"
                 functional-type(operands, results) }
  }

  op intr.coro.free {
    Doc "Free the coroutine frame.";
    Operands   (id: token, handle: ptr);
    Results    (res: llvm_ptr);
    Assembly   { id "," handle attr-dict ":"
                 functional-type(operands, results) }
  }

  op intr.coro.resume {
    Doc "Resume a suspended coroutine.";
    Operands   (handle: ptr);
    Assembly   { handle attr-dict ":" qualified(type(handle)) }
  }

  op intr.coro.promise {
    Doc "Address of a promise field at a given alignment.";
    Operands   (handle: ptr, align: i32, from: ptr);
    Results    (res: ptr);
    Assembly   { handle "," align "," from attr-dict ":"
                 functional-type(operands, results) }
  }

  op intr.coro.frame {
    Doc "Address of the coroutine frame.";
    Results    (res: ptr);
    Assembly   { attr-dict ":" type(res) }
  }

  op intr.coro.noop {
    Doc "No-op marker that keeps a coroutine frame alive.";
    Results    (res: ptr);
    Assembly   { attr-dict ":" type(res) }
  }

  op intr.coro.destroy {
    Doc "Destroy a suspended coroutine.";
    Operands   (handle: ptr);
    Assembly   { handle attr-dict ":" qualified(type(handle)) }
  }

  op intr.coro.done {
    Doc "Whether the coroutine is at its final suspend point.";
    Operands   (handle: ptr);
    Results    (res: i1);
    Assembly   { handle attr-dict ":" functional-type(operands, results) }
  }

  op intr.coro.is_in_ramp {
    Doc "Whether the coroutine is in a ramp (LLVM_CoroIsInRampOp).";
    Results    (res: i1);
    Assembly   { attr-dict ":" type(res) }
  }

  op intr.coro.dead {
    Doc "Whether the coroutine is dead.";
    Operands   (handle: ptr);
    Assembly   { handle attr-dict ":" qualified(type(handle)) }
  }

  op intr.coro.await.suspend.void {
    Doc "Suspend until the awaiter is ready, void result.";
    Operands   (awaiter: ptr, frame: ptr, wrapper: ptr);
    Assembly   { awaiter "," frame "," wrapper attr-dict ":"
                 qualified(type(awaiter)) "," qualified(type(frame)) ","
                 qualified(type(wrapper)) }
  }

  op intr.coro.await.suspend.bool {
    Doc "Suspend until the awaiter is ready, boolean result.";
    Operands   (awaiter: ptr, frame: ptr, wrapper: ptr);
    Results    (res: i1);
    Assembly   { awaiter "," frame "," wrapper attr-dict ":"
                 functional-type(operands, results) }
  }

  op intr.coro.await.suspend.handle {
    Doc "Suspend until the awaiter is ready, coroutine handle result.";
    Operands   (awaiter: ptr, frame: ptr, wrapper: ptr);
    Assembly   { awaiter "," frame "," wrapper attr-dict ":"
                 qualified(type(awaiter)) "," qualified(type(frame)) ","
                 qualified(type(wrapper)) }
  }

  // ---- 调试 intrinsic ----

  op intr.dbg.declare {
    Doc "Describe how an address relates to a source variable; varInfo and locationExpr print with the dialect prefix (LLVM_DbgIntrOp, LLVMIntrinsicOps.td:1121).";
    Operands   (addr: ptr);
    Attributes (varInfo: attribute, locationExpr: optional<attribute>);
    Assembly   { qualified(varInfo) if locationExpr { qualified(locationExpr) }
               "=" addr ":" qualified(type(addr)) attr-dict }
  }

  op intr.dbg.value {
    Doc "Describe how a value relates to a source variable; varInfo and locationExpr print with the dialect prefix.";
    Operands   (value: llvm_type);
    Attributes (varInfo: attribute, locationExpr: optional<attribute>);
    Assembly   { qualified(varInfo) if locationExpr { qualified(locationExpr) }
               "=" value ":" qualified(type(value)) attr-dict }
  }

  op intr.dbg.label {
    Doc "Relate the program point to a debug label (LLVM_DbgLabelOp).";
    Attributes (label: attribute);
    Assembly   { label attr-dict }
  }

  op intr.debugtrap {
    Doc "Trap that debuggers may catch (LLVM_DebugTrap); upstream prints only attr-dict.";
    Assembly   { attr-dict }
  }

  op intr.trap {
    Doc "Unconditionally trap (LLVM_Trap); upstream prints only attr-dict.";
    Assembly   { attr-dict }
  }

  op intr.ubsantrap {
    Doc "Trap with a failure kind for UBSan (LLVM_UBSanTrap, LLVMIntrinsicOps.td:929).";
    Attributes (failureKind: i8);
    Assembly   { "failureKind" "=" failureKind attr-dict }
  }

  op intr.eh.typeid.for {
    Doc "Type id of a type info global used by exception handling.";
    Attributes (type_info: ptr);
    Results    (res: i32);
    Assembly   { type_info attr-dict ":" functional-type(operands, results) }
  }

  op intr.expect {
    Doc "Branch-weight hint that val is likely equal to expected (LLVM_ExpectOp).";
    Operands   (val: integer, expected: integer);
    Results    (res: integer);
    Properties [pure];
    Assembly   { val "," expected attr-dict ":" type(val) }
  }

  op intr.expect.with.probability {
    Doc "Branch-weight hint with an explicit probability (LLVM_ExpectWithProbabilityOp).";
    Operands   (val: integer, expected: integer);
    Results    (res: integer);
    Attributes (prob: float);
    Properties [pure];
    Assembly   { val "," expected "," prob attr-dict ":" type(val) }
  }

  op intr.experimental.noalias.scope.decl {
    Doc "Declare an alias scope that later aliasing metadata refers to (LLVM_NoAliasScopeDeclOp, LLVMIntrinsicOps.td:414).";
    Attributes (scope: attribute);
    Assembly   { scope attr-dict }
  }

  op intr.fake.use {
    Doc "Keep a value alive in the IR (LLVM_FakeUseOp, LLVMIntrinsicOps.td:917).";
    Operands   (args: variadic<llvm_type>);
    Assembly   { args attr-dict ":" type(args) }
  }

  op intr.get.active.lane.mask {
    Doc "Mask of the lanes below n for the base index (LLVM_GetActiveLaneMaskOp, LLVMIntrinsicOps.td:1475).";
    Operands   (base: integer, n: integer);
    Results    (res: vector);
    Properties [pure];
    Assembly   { base "," n attr-dict ":" type(base) "," type(n) "to"
                 type(res) }
  }

  // ---- 内存标记 / 生命周期 ----

  op intr.lifetime.start {
    Doc "Start of a lifetime marker (LLVM_LifetimeBaseOp, LLVMIntrinsicOps.td:462).";
    Operands   (ptr: ptr);
    Assembly   { ptr attr-dict ":" qualified(type(ptr)) }
  }

  op intr.lifetime.end {
    Doc "End of a lifetime marker.";
    Operands   (ptr: ptr);
    Assembly   { ptr attr-dict ":" qualified(type(ptr)) }
  }

  op intr.invariant.start {
    Doc "Start of an invariant region; size is an immediate, result is a pointer (LLVM_InvariantStartOp).";
    Operands   (ptr: ptr);
    Results    (res: ptr);
    Attributes (size: i64);
    Assembly   { size "," ptr attr-dict ":" qualified(type(ptr)) }
  }

  op intr.invariant.end {
    Doc "End of an invariant region; start is the pointer from invariant.start.";
    Operands   (start: ptr, ptr: ptr);
    Attributes (size: i64);
    Assembly   { start "," size "," ptr attr-dict ":" qualified(type(ptr)) }
  }

  op intr.launder.invariant.group {
    Doc "Strip invariant.group information from a pointer (LLVM_LaunderInvariantGroupOp).";
    Operands   (ptr: ptr);
    Results    (res: ptr);
    Properties [same_type(ptr, res)];
    Assembly   { ptr attr-dict ":" qualified(type(ptr)) }
  }

  // ---- 矩阵 intrinsic ----

  op intr.matrix.column.major.load {
    Doc "Column-major strided 2-D matrix load; is_volatile/rows/columns are immediates (LLVM_MatrixColumnMajorLoadOp, LLVMIntrinsicOps.td:1364).";
    Operands   (data: ptr, stride: integer);
    Results    (res: vector);
    Attributes (isVolatile: bool, rows: i32, columns: i32);
    Assembly   { data "," "<" "stride" "=" stride ">" ","
                 "is_volatile" "=" isVolatile "," "rows" "=" rows ","
                 "columns" "=" columns attr-dict ":" type(res) "from"
                 qualified(type(data)) "stride" type(stride) }
  }

  op intr.matrix.column.major.store {
    Doc "Column-major strided 2-D matrix store.";
    Operands   (matrix: vector, data: ptr, stride: integer);
    Attributes (isVolatile: bool, rows: i32, columns: i32);
    Assembly   { matrix "," data "," "<" "stride" "=" stride ">" ","
                 "is_volatile" "=" isVolatile "," "rows" "=" rows ","
                 "columns" "=" columns attr-dict ":" type(matrix) "to"
                 qualified(type(data)) "stride" type(stride) }
  }

  op intr.matrix.multiply {
    Doc "Matrix multiply with explicit row/column counts (LLVM_MatrixMultiplyOp, LLVMIntrinsicOps.td:1428).";
    Operands   (lhs: vector, rhs: vector);
    Results    (res: vector);
    Attributes (lhs_rows: i32, lhs_columns: i32, rhs_columns: i32);
    Assembly   { lhs "," rhs "," "lhs_rows" "=" lhs_rows ","
                 "lhs_columns" "=" lhs_columns ","
                 "rhs_columns" "=" rhs_columns attr-dict ":"
                 "(" type(lhs) "," type(rhs) ")" "->" type(res) }
  }

  op intr.matrix.transpose {
    Doc "Matrix transpose with explicit row/column counts (LLVM_MatrixTransposeOp).";
    Operands   (matrix: vector);
    Results    (res: vector);
    Attributes (rows: i32, columns: i32);
    Assembly   { matrix "," "rows" "=" rows "," "columns" "=" columns
                 attr-dict ":" type(matrix) "into" type(res) }
  }

  // ---- 其他 ----

  op intr.ptrmask {
    Doc "Mask the address bits of a pointer (LLVM_PtrMaskOp, LLVMIntrinsicOps.td:448).";
    Operands   (ptr: ptr, mask: integer);
    Results    (res: ptr);
    Properties [pure, same_type(ptr, res)];
    Assembly   { ptr "," mask attr-dict ":"
                 functional-type(operands, results) }
  }

  op intr.ssa.copy {
    Doc "Copy of a value that cannot be folded away (LLVM_SSACopyOp).";
    Operands   (operand: llvm_type);
    Results    (res: llvm_type);
    Properties [pure, same_type(operand, res)];
    Assembly   { operand attr-dict ":" type(operand) }
  }

  op intr.stacksave {
    Doc "Save the current stack pointer (LLVM_StackSaveOp).";
    Results    (res: ptr);
    Assembly   { attr-dict ":" qualified(type(res)) }
  }

  op intr.stackrestore {
    Doc "Restore a previously saved stack pointer (LLVM_StackRestoreOp).";
    Operands   (ptr: ptr);
    Assembly   { ptr attr-dict ":" qualified(type(ptr)) }
  }

  op intr.stepvector {
    Doc "Vector of its own lane indices (LLVM_StepVectorOp).";
    Results    (res: vector);
    Properties [pure];
    Assembly   { attr-dict ":" type(res) }
  }

  op intr.vastart {
    Doc "Initialize an llvm.struct va_list pointer (LLVM_VaStartOp, LLVMIntrinsicOps.td:1236).";
    Operands   (arg_list: ptr);
    Assembly   { arg_list attr-dict ":" qualified(type(arg_list)) }
  }

  op intr.vaend {
    Doc "Finish using an llvm.struct va_list pointer (LLVM_VaEndOp).";
    Operands   (arg_list: ptr);
    Assembly   { arg_list attr-dict ":" qualified(type(arg_list)) }
  }

  op intr.vacopy {
    Doc "Copy one llvm.struct va_list into another (LLVM_VaCopyOp, LLVMIntrinsicOps.td:1240).";
    Operands   (src_list: ptr, dest_list: ptr);
    Assembly   { src_list "to" dest_list attr-dict ":" type(operands) }
  }

  op intr.vector.extract {
    Doc "Extract element pos of a vector, keeping the source type (LLVM_vector_extract, LLVMIntrinsicOps.td:1885).";
    Operands   (srcvec: vector);
    Results    (res: vector);
    Attributes (pos: i64);
    Properties [pure];
    Assembly   { srcvec "[" pos "]" attr-dict ":" type(res) "from"
                 type(srcvec) }
  }

  op intr.vector.insert {
    Doc "Insert srcvec into dstvec starting at element pos (LLVM_vector_insert).";
    Operands   (srcvec: vector, dstvec: vector);
    Results    (res: vector);
    Attributes (pos: i64);
    Properties [pure];
    Assembly   { srcvec "," dstvec "[" pos "]" attr-dict ":" type(srcvec)
                 "into" type(res) }
  }

  op intr.vector.repeat {
    Doc "Repeat a vector (LLVM_vector_repeat, LLVMIntrinsicOps.td:1932).";
    Operands   (vec: vector);
    Results    (res: vector);
    Properties [pure];
    Assembly   { "(" operands ")" attr-dict ":"
                 functional-type(operands, results) }
  }
}
