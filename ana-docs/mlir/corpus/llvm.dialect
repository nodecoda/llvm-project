  // ---- constrained FP intrinsic ----
  //
  // 全部 49 条都由 LLVM_ConstrainedIntr 族生成；逐条核对 tblgen 的
  // assemblyFormat 字段：49 条都有 assemblyFormat，没有一条是 Generic。

  schema ConstrainedUnaryRM {
    Doc "Constrained unary FP intrinsic with a rounding mode and an exception behavior; arg_0 and res share one type (LLVM_ConstrainedUnaryIntrRM, LLVMIntrinsicOps.td:597; assemblyFormat at :601-603).";
    Operands   (arg_0: llvm_type);
    Results    (res: llvm_type);
    Attributes (roundingmode: RoundingMode,
                fpExceptionBehavior: FPExceptionBehavior,
                fastmathFlags: FastmathFlags = none);
    Properties [pure, same_type(arg_0, res)];
    Assembly   { arg_0 roundingmode fpExceptionBehavior
                 if fastmathFlags { "fastmath" fastmathFlags }
                 attr-dict ":" type(arg_0) }
  }

  schema ConstrainedUnaryNoRM {
    Doc "Constrained unary FP intrinsic without a rounding mode (LLVM_ConstrainedUnaryIntrNoRM, LLVMIntrinsicOps.td:609; assemblyFormat at :613-615).";
    Operands   (arg_0: llvm_type);
    Results    (res: llvm_type);
    Attributes (fpExceptionBehavior: FPExceptionBehavior,
                fastmathFlags: FastmathFlags = none);
    Properties [pure, same_type(arg_0, res)];
    Assembly   { arg_0 fpExceptionBehavior
                 if fastmathFlags { "fastmath" fastmathFlags }
                 attr-dict ":" type(arg_0) }
  }

  schema ConstrainedBinaryRM {
    Doc "Constrained binary FP intrinsic with a rounding mode; both operands and the result share one type (LLVM_ConstrainedBinaryIntrRM, LLVMIntrinsicOps.td:621; assemblyFormat at :625-627).";
    Operands   (arg_0: llvm_type, arg_1: llvm_type);
    Results    (res: llvm_type);
    Attributes (roundingmode: RoundingMode,
                fpExceptionBehavior: FPExceptionBehavior,
                fastmathFlags: FastmathFlags = none);
    Properties [pure, same_type(arg_0, arg_1), same_type(arg_1, res)];
    Assembly   { arg_0 "," arg_1 roundingmode fpExceptionBehavior
                 if fastmathFlags { "fastmath" fastmathFlags }
                 attr-dict ":" type(arg_0) }
  }

  schema ConstrainedBinaryNoRM {
    Doc "Constrained binary FP intrinsic without a rounding mode (LLVM_ConstrainedBinaryIntrNoRM, LLVMIntrinsicOps.td:633; assemblyFormat at :637-639).";
    Operands   (arg_0: llvm_type, arg_1: llvm_type);
    Results    (res: llvm_type);
    Attributes (fpExceptionBehavior: FPExceptionBehavior,
                fastmathFlags: FastmathFlags = none);
    Properties [pure, same_type(arg_0, arg_1), same_type(arg_1, res)];
    Assembly   { arg_0 "," arg_1 fpExceptionBehavior
                 if fastmathFlags { "fastmath" fastmathFlags }
                 attr-dict ":" type(arg_0) }
  }

  schema ConstrainedTernaryRM {
    Doc "Constrained ternary FP intrinsic (fma/fmuladd) with a rounding mode; all operands and the result share one type (LLVM_ConstrainedFMAIntr :754 and LLVM_ConstrainedFMulAddIntr :763, assemblyFormat at :758-760 / :767-769).";
    Operands   (arg_0: llvm_type, arg_1: llvm_type, arg_2: llvm_type);
    Results    (res: llvm_type);
    Attributes (roundingmode: RoundingMode,
                fpExceptionBehavior: FPExceptionBehavior,
                fastmathFlags: FastmathFlags = none);
    Properties [pure, same_type(arg_0, arg_1), same_type(arg_1, arg_2),
                same_type(arg_2, res)];
    Assembly   { arg_0 "," arg_1 "," arg_2 roundingmode fpExceptionBehavior
                 if fastmathFlags { "fastmath" fastmathFlags }
                 attr-dict ":" type(arg_0) }
  }

  schema ConstrainedConvertRM {
    Doc "Constrained one-operand conversion with a rounding mode; the source and result types differ and print after the colon (LLVM_ConstrainedFPToIntIntrRM, LLVMIntrinsicOps.td:644, assemblyFormat at :648-651; also used by uitofp/sitofp/fptrunc).";
    Operands   (arg_0: llvm_type);
    Results    (res: llvm_type);
    Attributes (roundingmode: RoundingMode,
                fpExceptionBehavior: FPExceptionBehavior,
                fastmathFlags: FastmathFlags = none);
    Properties [pure];
    Assembly   { arg_0 roundingmode fpExceptionBehavior
                 if fastmathFlags { "fastmath" fastmathFlags }
                 attr-dict ":" type(arg_0) "to" type(res) }
  }

  schema ConstrainedConvertNoRM {
    Doc "Constrained one-operand conversion without a rounding mode (LLVM_ConstrainedFPToIntIntrNoRM, LLVMIntrinsicOps.td:656, assemblyFormat at :660-662; also used by fpext).";
    Operands   (arg_0: llvm_type);
    Results    (res: llvm_type);
    Attributes (fpExceptionBehavior: FPExceptionBehavior,
                fastmathFlags: FastmathFlags = none);
    Properties [pure];
    Assembly   { arg_0 fpExceptionBehavior
                 if fastmathFlags { "fastmath" fastmathFlags }
                 attr-dict ":" type(arg_0) "to" type(res) }
  }

  schema ConstrainedFCmp {
    Doc "Constrained floating-point comparison: a predicate attribute, two same-typed operands and an i1-shaped result (LLVM_ConstrainedFCmpIntrBase, LLVMIntrinsicOps.td:667; assemblyFormat at :686-688).";
    Operands   (arg_0: llvm_type, arg_1: llvm_type);
    Results    (res: i1);
    Attributes (predicate: FCmpPredicate,
                fpExceptionBehavior: FPExceptionBehavior,
                fastmathFlags: FastmathFlags = none);
    Properties [pure, same_type(arg_0, arg_1)];
    Assembly   { predicate arg_0 "," arg_1 fpExceptionBehavior
                 if fastmathFlags { "fastmath" fastmathFlags }
                 attr-dict ":" type(arg_0) }
  }

  schema ConstrainedPowiLdexp {
    Doc "Constrained powi/ldexp: a free operand list, a rounding mode, then a functional type (LLVM_ConstrainedPowIIntr :812 and LLVM_ConstrainedLdexpIntr :822, assemblyFormat at :816-819 / :826-829).";
    Operands   (operands: variadic<llvm_type>);
    Results    (results: variadic<llvm_type>);
    Attributes (roundingmode: RoundingMode,
                fpExceptionBehavior: FPExceptionBehavior,
                fastmathFlags: FastmathFlags = none);
    Properties [pure];
    Assembly   { operands roundingmode fpExceptionBehavior
                 if fastmathFlags { "fastmath" fastmathFlags }
                 attr-dict ":" functional-type(operands, results) }
  }

