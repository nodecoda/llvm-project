/// mpi —— MPI 运行时调用的领域描述（corpus，不是最终语法）。
///
/// 领域特点：所有调用都返回可选的 `retval`，失败分类用 `errclass` 枚举；
/// 缓冲区是 memref，通信子/请求/返回值是三种不透明句柄。
/// 文本全部是声明式的：`mpi.recv(%buf, %tag, %src, %comm) : memref<...>, i32, i32`。

dialect mpi {
  Doc "Message passing calls over the MPI runtime.";

  type_def comm {
    Doc "Opaque MPI communicator handle (!mpi.comm); carries no parameters.";
    Assembly   Generic;
  }
  type_def retval {
    Doc "Return value of an MPI call (!mpi.retval): MPI_SUCCESS or an error code.";
    Assembly   Generic;
  }
  type_def request {
    Doc "Opaque handle to an asynchronous request (!mpi.request).";
    Assembly   Generic;
  }

  enum MPI_ErrorClassEnum {
    Doc "MPI error classes (MPI_SUCCESS .. MPI_ERR_LASTCODE).";
    Cases [
      mpi_success = 0 "MPI_SUCCESS", mpi_err_access = 1 "MPI_ERR_ACCESS",
      mpi_err_amode = 2 "MPI_ERR_AMODE", mpi_err_arg = 3 "MPI_ERR_ARG",
      mpi_err_assert = 4 "MPI_ERR_ASSERT", mpi_err_bad_file = 5 "MPI_ERR_BAD_FILE",
      mpi_err_base = 6 "MPI_ERR_BASE", mpi_err_buffer = 7 "MPI_ERR_BUFFER",
      mpi_err_comm = 8 "MPI_ERR_COMM", mpi_err_conversion = 9 "MPI_ERR_CONVERSION",
      mpi_err_count = 10 "MPI_ERR_COUNT", mpi_err_dims = 11 "MPI_ERR_DIMS",
      mpi_err_disp = 12 "MPI_ERR_DISP", mpi_err_dup_datarep = 13 "MPI_ERR_DUP_DATAREP",
      mpi_err_errhandler = 14 "MPI_ERR_ERRHANDLER", mpi_err_file = 15 "MPI_ERR_FILE",
      mpi_err_file_exists = 16 "MPI_ERR_FILE_EXISTS",
      mpi_err_file_in_use = 17 "MPI_ERR_FILE_IN_USE",
      mpi_err_group = 18 "MPI_ERR_GROUP", mpi_err_info = 19 "MPI_ERR_INFO",
      mpi_err_info_key = 20 "MPI_ERR_INFO_KEY",
      mpi_err_info_nokey = 21 "MPI_ERR_INFO_NOKEY",
      mpi_err_info_value = 22 "MPI_ERR_INFO_VALUE",
      mpi_err_in_status = 23 "MPI_ERR_IN_STATUS", mpi_err_intern = 24 "MPI_ERR_INTERN",
      mpi_err_io = 25 "MPI_ERR_IO", mpi_err_keyval = 26 "MPI_ERR_KEYVAL",
      mpi_err_locktype = 27 "MPI_ERR_LOCKTYPE", mpi_err_name = 28 "MPI_ERR_NAME",
      mpi_err_no_mem = 29 "MPI_ERR_NO_MEM", mpi_err_no_space = 30 "MPI_ERR_NO_SPACE",
      mpi_err_no_such_file = 31 "MPI_ERR_NO_SUCH_FILE",
      mpi_err_not_same = 32 "MPI_ERR_NOT_SAME", mpi_err_op = 33 "MPI_ERR_OP",
      mpi_err_other = 34 "MPI_ERR_OTHER", mpi_err_pending = 35 "MPI_ERR_PENDING",
      mpi_err_port = 36 "MPI_ERR_PORT",
      mpi_err_proc_aborted = 37 "MPI_ERR_PROC_ABORTED",
      mpi_err_quota = 38 "MPI_ERR_QUOTA", mpi_err_rank = 39 "MPI_ERR_RANK",
      mpi_err_read_only = 40 "MPI_ERR_READ_ONLY",
      mpi_err_request = 41 "MPI_ERR_REQUEST",
      mpi_err_rma_attach = 42 "MPI_ERR_RMA_ATTACH",
      mpi_err_rma_conflict = 43 "MPI_ERR_RMA_CONFLICT",
      mpi_err_rma_flavor = 44 "MPI_ERR_RMA_FLAVOR",
      mpi_err_rma_range = 45 "MPI_ERR_RMA_RANGE",
      mpi_err_rma_shared = 46 "MPI_ERR_RMA_SHARED",
      mpi_err_rma_sync = 47 "MPI_ERR_RMA_SYNC", mpi_err_root = 48 "MPI_ERR_ROOT",
      mpi_err_service = 49 "MPI_ERR_SERVICE", mpi_err_session = 50 "MPI_ERR_SESSION",
      mpi_err_size = 51 "MPI_ERR_SIZE", mpi_err_spawn = 52 "MPI_ERR_SPAWN",
      mpi_err_tag = 53 "MPI_ERR_TAG", mpi_err_topology = 54 "MPI_ERR_TOPOLOGY",
      mpi_err_truncate = 55 "MPI_ERR_TRUNCATE", mpi_err_type = 56 "MPI_ERR_TYPE",
      mpi_err_unknown = 57 "MPI_ERR_UNKNOWN",
      mpi_err_unsupported_datarep = 58 "MPI_ERR_UNSUPPORTED_DATAREP",
      mpi_err_unsupported_operation = 59 "MPI_ERR_UNSUPPORTED_OPERATION",
      mpi_err_value_too_large = 60 "MPI_ERR_VALUE_TOO_LARGE",
      mpi_err_win = 61 "MPI_ERR_WIN", mpi_err_lastcode = 62 "MPI_ERR_LASTCODE"
    ];
  }
  enum MPI_ReductionOpEnum {
    Doc "MPI reduction operators.";
    Cases [
      mpi_op_null = 0 "MPI_OP_NULL", mpi_max = 1 "MPI_MAX", mpi_min = 2 "MPI_MIN",
      mpi_sum = 3 "MPI_SUM", mpi_prod = 4 "MPI_PROD", mpi_land = 5 "MPI_LAND",
      mpi_band = 6 "MPI_BAND", mpi_lor = 7 "MPI_LOR", mpi_bor = 8 "MPI_BOR",
      mpi_lxor = 9 "MPI_LXOR", mpi_bxor = 10 "MPI_BXOR", mpi_minloc = 11 "MPI_MINLOC",
      mpi_maxloc = 12 "MPI_MAXLOC", mpi_replace = 13 "MPI_REPLACE"
    ];
  }
  op init {
    Doc "Initialize the MPI library (MPI_Init(NULL, NULL)).";
    Results    (retval: optional<retval>);
    Properties [memory_effect(read), memory_effect(write)];
    Assembly   { attr-dict if retval { ":" type(retval) } }
  }
  op comm_world {
    Doc "Return the predefined MPI_COMM_WORLD communicator.";
    Results    (comm: comm);
    Properties [no_memory_effect];
    Assembly   { attr-dict ":" type(comm) }
  }
  op comm_rank {
    Doc "Rank of the calling process in the communicator.";
    Operands   (comm: comm);
    Results    (retval: optional<retval>, rank: i32);
    Properties [no_memory_effect];
    Assembly   { "(" comm ")" attr-dict ":" if retval { type(retval) "," } type(rank) }
  }
  op comm_size {
    Doc "Number of processes in the communicator.";
    Operands   (comm: comm);
    Results    (retval: optional<retval>, size: i32);
    Properties [no_memory_effect];
    Assembly   { "(" comm ")" attr-dict ":" if retval { type(retval) "," } type(size) }
  }
  op comm_split {
    Doc "Split a communicator into disjoint subgroups by color and key.";
    Operands   (comm: comm, color: i32, key: i32);
    Results    (retval: optional<retval>, newcomm: comm);
    Properties [memory_effect(read), memory_effect(write)];
    Assembly   { "(" comm "," color "," key ")" attr-dict ":" if retval { type(retval) "," } type(newcomm) }
  }
  op send {
    Doc "Blocking send of a buffer to one rank.";
    Operands   (ref: memref, tag: i32, dest: i32, comm: comm);
    Results    (retval: optional<retval>);
    Properties [memory_effect(read), memory_effect(write)];
    Assembly   { "(" ref "," tag "," dest "," comm ")" attr-dict ":" type(ref) "," type(tag) "," type(dest) if retval { "->" type(retval) } }
  }
  op isend {
    Doc "Non-blocking send; the request completes at mpi.wait.";
    Operands   (ref: memref, tag: i32, dest: i32, comm: comm);
    Results    (retval: optional<retval>, req: request);
    Properties [memory_effect(read), memory_effect(write)];
    Assembly   { "(" ref "," tag "," dest "," comm ")" attr-dict ":" type(ref) "," type(tag) "," type(dest) "->" if retval { type(retval) "," } type(req) }
  }
  op recv {
    Doc "Blocking receive of a buffer from one rank.";
    Operands   (ref: memref, tag: i32, source: i32, comm: comm);
    Results    (retval: optional<retval>);
    Properties [memory_effect(read), memory_effect(write)];
    Assembly   { "(" ref "," tag "," source "," comm ")" attr-dict ":" type(ref) "," type(tag) "," type(source) if retval { "->" type(retval) } }
  }
  op irecv {
    Doc "Non-blocking receive; the request completes at mpi.wait.";
    Operands   (ref: memref, tag: i32, source: i32, comm: comm);
    Results    (retval: optional<retval>, req: request);
    Properties [memory_effect(read), memory_effect(write)];
    Assembly   { "(" ref "," tag "," source "," comm ")" attr-dict ":" type(ref) "," type(tag) "," type(source) "->" if retval { type(retval) "," } type(req) }
  }
  op allgather {
    Doc "Gather the same buffer from every rank into every rank.";
    Operands   (sendbuf: memref, recvbuf: memref, comm: comm);
    Results    (retval: optional<retval>);
    Assembly   { "(" sendbuf "," recvbuf "," comm ")" attr-dict ":" type(sendbuf) "," type(recvbuf) if retval { "->" type(retval) } }
  }
  op allreduce {
    Doc "Reduce one buffer across all ranks with a reduction operator.";
    Operands   (sendbuf: memref, recvbuf: memref, op: MPI_ReductionOpEnum, comm: comm);
    Results    (retval: optional<retval>);
    Assembly   { "(" sendbuf "," recvbuf "," op "," comm ")" attr-dict ":" type(sendbuf) "," type(recvbuf) if retval { "->" type(retval) } }
  }
  op reduce_scatter_block {
    Doc "Reduce a buffer across ranks and scatter equal blocks.";
    Operands   (sendbuf: memref, recvbuf: memref, op: MPI_ReductionOpEnum, comm: comm);
    Results    (retval: optional<retval>);
    Assembly   { "(" sendbuf "," recvbuf "," op "," comm ")" attr-dict ":" type(sendbuf) "," type(recvbuf) if retval { "->" type(retval) } }
  }
  op barrier {
    Doc "Block until every rank reaches the barrier.";
    Operands   (comm: comm);
    Results    (retval: optional<retval>);
    Properties [memory_effect(read), memory_effect(write)];
    Assembly   { "(" comm ")" attr-dict if retval { "->" type(retval) } }
  }
  op wait {
    Doc "Complete an asynchronous request.";
    Operands   (req: request);
    Results    (retval: optional<retval>);
    Properties [no_memory_effect];
    Assembly   { "(" req ")" attr-dict ":" type(req) if retval { "->" type(retval) } }
  }
  op finalize {
    Doc "Finalize the MPI library.";
    Results    (retval: optional<retval>);
    Properties [memory_effect(read), memory_effect(write)];
    Assembly   { attr-dict if retval { ":" type(retval) } }
  }
  op retval_check {
    Doc "Compare a return value against an error class.";
    Operands   (val: retval);
    Results    (res: i1);
    Attributes (errclass: MPI_ErrorClassEnum);
    Properties [no_memory_effect];
    Assembly   { val "=" errclass attr-dict ":" type(res) }
  }
  op error_class {
    Doc "Error class of a failed call's return value.";
    Operands   (val: retval);
    Results    (errclass: retval);
    Properties [no_memory_effect];
    Assembly   { val attr-dict ":" type(val) }
  }
}
