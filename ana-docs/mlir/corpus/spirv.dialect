  // == SPIRVBarrierOps.td
  op ControlBarrier from SpirvOp {
    Doc "Wait for other invocations of this module to reach the current point of execution.";
    Attributes (execution_scope: Scope, memory_scope: Scope, memory_semantics: MemorySemantics);
    Assembly { execution_scope "," memory_scope "," memory_semantics attr-dict }
  }
  op MemoryBarrier from SpirvOp {
    Doc "Control the order that memory accesses are observed.";
    Attributes (memory_scope: Scope, memory_semantics: MemorySemantics);
    Assembly { memory_scope "," memory_semantics attr-dict }
  }
  op NamedBarrierInitialize from SpirvOp {
    Doc "Initialize a named barrier with a subgroup count.";
    Operands   (subgroup_count: i32);
    Results    (result: named_barrier);
    Assembly { subgroup_count attr-dict ":" type(subgroup_count) "->" type(result) }
  }
  op MemoryNamedBarrier from SpirvOp {
    Doc "Wait on a named barrier and apply a memory barrier.";
    Operands   (named_barrier: named_barrier);
    Attributes (memory_scope: Scope, memory_semantics: MemorySemantics);
    Assembly { named_barrier "," memory_scope "," memory_semantics attr-dict ":" type(named_barrier) }
  }

  // == SPIRVBitOps.td
  op BitCount from IntUnary {
    Doc "Count the number of set bits in an object.";
  }
  op BitFieldInsert from SpirvOp {
    Doc "Make a copy of an object, with a modified bit field that comes from another object.";
    Operands   (base: int_scalar_or_vector, insert: int_scalar_or_vector, offset: int_scalar, count: int_scalar);
    Results    (result: int_scalar_or_vector);
    Properties [pure, same_type(base, insert), same_type(insert, result)];
    Assembly { base "," insert "," offset "," count attr-dict ":" type(base) "," type(offset) "," type(count) }
  }
  op BitFieldSExtract from SpirvOp {
    Doc "Extract a bit field from an object, with sign extension.";
    Operands   (base: int_scalar_or_vector, offset: int_scalar, count: int_scalar);
    Results    (result: int_scalar_or_vector);
    Properties [pure, same_type(base, result)];
    Assembly { base "," offset "," count attr-dict ":" type(base) "," type(offset) "," type(count) }
  }
  op BitFieldUExtract from SpirvOp {
    Doc "Extract a bit field from an object, without sign extension.";
    Operands   (base: int_scalar_or_vector, offset: int_scalar, count: int_scalar);
    Results    (result: int_scalar_or_vector);
    Properties [pure, same_type(base, result)];
    Assembly { base "," offset "," count attr-dict ":" type(base) "," type(offset) "," type(count) }
  }
  op BitReverse from IntUnary {
    Doc "Reverse the bits in an object.";
  }
  op BitwiseAnd from IntBitwiseBinary {
    Doc "Result is 1 if both Operand 1 and Operand 2 are 1. Result is 0 if either Operand 1 or Operand 2 are 0.";
  }
  op BitwiseOr from IntBitwiseBinary {
    Doc "Result is 1 if either Operand 1 or Operand 2 is 1. Result is 0 if both Operand 1 and Operand 2 are 0.";
  }
  op BitwiseXor from IntBitwiseBinary {
    Doc "Result is 1 if exactly one of Operand 1 or Operand 2 is 1. Result is 0 if Operand 1 and Operand 2 have the same value.";
  }
  op ShiftLeftLogical from ShiftBinary {
    Doc "Shift the bits in Base left by the number of bits specified in Shift. The least-significant bits are zero filled.";
  }
  op ShiftRightArithmetic from ShiftBinary {
    Doc "Shift the bits in Base right by the number of bits specified in Shift. The most-significant bits are filled with the sign bit from Base.";
  }
  op ShiftRightLogical from ShiftBinary {
    Doc "Shift the bits in Base right by the number of bits specified in Shift. The most-significant bits are zero filled.";
  }
  op Not from IntUnary {
    Doc "Complement the bits of Operand.";
  }

  // == SPIRVCastOps.td
  op Bitcast from SpirvOp {
    Doc "Bit pattern-preserving type conversion.";
    Operands   (operand: scalar_or_vector_or_ptr_or_coop_matrix);
    Results    (result: scalar_or_vector_or_ptr_or_coop_matrix);
    Properties [pure];
    Assembly { operand attr-dict ":" type(operand) "to" type(result) }
  }
  op BitcastExtractEXT from SpirvOp {
    Doc "Extract a bit field and reinterpret it as a numerical value";
    Operands   (base: fp_ext_scalar_or_vector, offset: int_scalar);
    Results    (result: fp_ext_scalar_or_vector);
    Properties [pure];
    Assembly { base "," offset attr-dict ":" type(base) "," type(offset) "to" type(result) }
  }
  op ConvertFToS from SpirvOp {
    Doc "Convert value numerically from floating point to signed integer, with round toward 0.0.";
    Operands   (operand: fp_ext_scalar_vector_or_coop_matrix);
    Results    (result: int_scalar_vector_or_coop_matrix);
    Properties [pure, same_shape];
    Assembly { operand attr-dict ":" type(operand) "to" type(result) }
  }
  op ConvertFToU from SpirvOp {
    Doc "Convert value numerically from floating point to unsigned integer, with round toward 0.0.";
    Operands   (operand: fp_ext_scalar_vector_or_coop_matrix);
    Results    (result: int_scalar_vector_or_coop_matrix);
    Properties [pure, same_shape];
    Assembly { operand attr-dict ":" type(operand) "to" type(result) }
  }
  op ConvertSToF from SpirvOp {
    Doc "Convert value numerically from signed integer to floating point.";
    Operands   (operand: int_scalar_vector_or_coop_matrix);
    Results    (result: fp_ext_scalar_vector_or_coop_matrix);
    Properties [pure, same_shape];
    Assembly { operand attr-dict ":" type(operand) "to" type(result) }
  }
  op ConvertUToF from SpirvOp {
    Doc "Convert value numerically from unsigned integer to floating point.";
    Operands   (operand: int_scalar_vector_or_coop_matrix);
    Results    (result: fp_ext_scalar_vector_or_coop_matrix);
    Properties [pure, same_shape];
    Assembly { operand attr-dict ":" type(operand) "to" type(result) }
  }
  op FConvert from SpirvOp {
    Doc "Convert value numerically from one floating-point width to another width.";
    Operands   (operand: fp_ext_scalar_vector_or_coop_matrix);
    Results    (result: fp_ext_scalar_vector_or_coop_matrix);
    Properties [pure, same_shape];
    Assembly { operand attr-dict ":" type(operand) "to" type(result) }
  }
  op SConvert from SpirvOp {
    Doc "Convert signed width. This is either a truncate or a sign extend.";
    Operands   (operand: int_scalar_vector_or_coop_matrix);
    Results    (result: int_scalar_vector_or_coop_matrix);
    Properties [pure, same_shape];
    Assembly { operand attr-dict ":" type(operand) "to" type(result) }
  }
  op UConvert from SpirvOp {
    Doc "Convert unsigned width. This is either a truncate or a zero extend.";
    Operands   (operand: int_scalar_vector_or_coop_matrix);
    Results    (result: int_scalar_vector_or_coop_matrix);
    Properties [pure, same_shape];
    Assembly { operand attr-dict ":" type(operand) "to" type(result) }
  }
  op SatConvertSToU from SpirvOp {
    Doc "Convert a signed integer to unsigned integer. Converted values outside the representable range of Result Type are clamped to the nearest representable value of Result Type.";
    Operands   (operand: int_scalar_or_vector);
    Results    (result: int_scalar_or_vector);
    Properties [pure, same_shape];
    Assembly { operand attr-dict ":" type(operand) "to" type(result) }
  }
  op SatConvertUToS from SpirvOp {
    Doc "Convert an unsigned integer to signed integer. Converted values outside the representable range of Result Type are clamped to the nearest representable value of Result Type.";
    Operands   (operand: int_scalar_or_vector);
    Results    (result: int_scalar_or_vector);
    Properties [pure, same_shape];
    Assembly { operand attr-dict ":" type(operand) "to" type(result) }
  }
