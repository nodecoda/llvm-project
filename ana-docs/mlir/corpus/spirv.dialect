/// spirv —— MLIR SPIR-V 方言的领域模型（corpus，不是最终语法）。
///
/// 覆盖：SPIRVOps.td 及其 include 的 25 个 SPIRV*Ops.td 中带打印助记符的
/// 全部 430 个 op（OpName 已去掉 `spirv.` 前缀）。每个 op 都恰好落在一个
/// 文本通道上；同形 op 由族 schema 收敛。
///
/// 文本通道：397 个块格式，33 个 Custom，0 个 Generic。SPIR-V 的所有 op 都从
/// SPIRV_Op 继承 hasCustomAssemblyFormat = 1，但 ODS 的 genParser/genPrinter
/// 在 op 自带 assemblyFormat 时先生成声明式 parse/print（早于
/// hasCustomAssemblyFormat 检查）；所以本文件按"有无 assemblyFormat"选通道：
/// 有声明式格式的写块格式，33 个没有 assemblyFormat、在
/// mlir/lib/Dialect/SPIRV/IR/*.cpp 里有手写 parse/print 的写 Assembly Custom。
/// 33 个 Custom 与 33 个 `::parse(` 定义逐一对应；397 个 ODS 生成 printer
/// 见 build 的 SPIRVOps.cpp.inc。Custom 逐条依据见文末清单。
///
/// 类型：SPIR-V 的类型系统用本文件的 type_def + constraint 建模：
/// scalar/vector/composite/any_ptr/image/sampled_image/sampler/cooperative_matrix/
/// matrix/any_struct/any_array/named_barrier/void/tensor_arm，元素域 fp、int_scalar、
/// bool_scalar、fp_ext。tensor_arm 的 rank 0 表示上游只约束元素类型、未固定秩。
/// 上游的 pointee/address space、image 维度、tensor 形状细节是类型参数或
/// verifier 事实，文法写不出，只出现在 Doc。
///
/// 属性：SPIR-V 的枚举属性很多，统一用 enum + Cases 声明（取值抄 SPIRVBase.td
/// 的枚举）；MemoryAccess/ImageOperands 等位集也按上游数值列出。复杂属性
/// （LinkageAttributes、VerCapExt、DenseElements 形态的窗参数）建模为 any，
/// 详见各 op 的 Doc。
///
/// 事实：只用 tools/fact-glossary.tsv 的 core 词：pure（Pure）、commutative、
/// speculatable（AlwaysSpeculatable）、no_memory_effect（NoMemoryEffect）、
/// terminator、symbol/symbol_visibility/symbol_table、isolated_from_above、
/// constant_like、return_like、automatic_allocation_scope、
/// same_type（SameTypeOperands/SameOperandsAndResultType/AllTypesMatch）、
/// same_shape（SameOperandsAndResultShape 与 getMatchingBoolType 的 TypesMatchWith）、
/// same_element_type（AllElementTypesMatch）、same_rank（AllRanksMatch）、
/// broadcastable（MatchBroadcastableShapes）、element_type_matches（PointeeTypeMatchTrait）、
/// has_parent（InFunctionScope→func、InModuleScope→module、InGraphScope→ARM.Graph）、
/// 区域事实 single_block/no_terminator/no_region_args，以及 binding 上的
/// non_negative（Confined IntNonNegative）。没有方言本地事实。
///
/// schema：33 个族收敛 207 个同形 op（一元/二元算术、比较、类型转换、位运算、
/// 原子、subgroup/TOSA/GL/CL 的族）；其余 op 各自声明。所有 op 都 from SpirvOp，
/// 后者承载 SPIRV_Op 的四个 availability 查询接口。
///
/// 仅写进 Doc 的语义（文法没有对应谓词）：SPIR-V 的 availability（version/
/// extension/capability）、execution scope 校验（如 Subgroup）、tensor 的
/// rank/长度上界、指针的 storage class/pointee、image 的 dim/depth、以及
/// TypesMatchWith 之外的 verifier。
///
/// 偏差：上游 mnemonics 是 CamelCase（spirv.FAdd）。当前 tools 已支持：
/// dialect-coverage.py 的 TD 用 SPIRV*Ops.td 通配、助记符/声明正则接受大写；
/// escape-audit.py 的 resolve 让 assemblyFormat 优先于继承的
/// hasCustomAssemblyFormat。coverage 报 upstream=414 / corpus=430 /
/// missing=0 / extra=0：414 是因为 ext-inst 的前缀（CL./GL./TOSA./ARM./
/// INTEL./KHR.）由 TD 的 setPrefix 拼接，RECORD 只截到末段，按末段对齐；
/// escape 报 430 op / 33 Custom (8%) / 0 gap / 0 divergence。按 JSON/闭包
/// 复核，本语料的 430 个 op 与 include 闭包的 430 个助记符一一对应。

dialect spirv {
  Doc "SPIR-V dialect: types, constants, memory, arithmetic, control flow, image/group/matrix operations, plus GL/CL/TOSA/INTEL/ARM extensions.";

  // ----------------------------------------------------------------
  // 枚举属性（取值与拼写抄 SPIRVBase.td）
  // ----------------------------------------------------------------
  enum Scope {
    Doc "SPIR-V Scope enum attribute.";
    Cases [ cross_device = 0 "CrossDevice", device = 1 "Device", workgroup = 2 "Workgroup",
            subgroup = 3 "Subgroup", invocation = 4 "Invocation", queue_family = 5 "QueueFamily",
            shader_call_khr = 6 "ShaderCallKHR"];
  }
  enum MemorySemantics: bits {
    Doc "SPIR-V MemorySemantics enum attribute.";
    Cases [ none = 0 "None", acquire = 2 "Acquire", release = 4 "Release",
            acquire_release = 8 "AcquireRelease",
            sequentially_consistent = 16 "SequentiallyConsistent",
            uniform_memory = 64 "UniformMemory", subgroup_memory = 128 "SubgroupMemory",
            workgroup_memory = 256 "WorkgroupMemory",
            cross_workgroup_memory = 512 "CrossWorkgroupMemory",
            atomic_counter_memory = 1024 "AtomicCounterMemory", image_memory = 2048 "ImageMemory",
            output_memory = 4096 "OutputMemory", make_available = 8192 "MakeAvailable",
            make_visible = 16384 "MakeVisible", volatile = 32768 "Volatile"];
  }
  enum LoopControl: bits {
    Doc "SPIR-V LoopControl enum attribute.";
    Cases [ none = 0 "None", unroll = 1 "Unroll", dont_unroll = 2 "DontUnroll",
            dependency_infinite = 4 "DependencyInfinite", dependency_length = 8 "DependencyLength",
            min_iterations = 16 "MinIterations", max_iterations = 32 "MaxIterations",
            iteration_multiple = 64 "IterationMultiple", peel_count = 128 "PeelCount",
            partial_count = 256 "PartialCount",
            initiation_interval_intel = 65536 "InitiationIntervalINTEL",
            loop_coalesce_intel = 1048576 "LoopCoalesceINTEL",
            max_concurrency_intel = 131072 "MaxConcurrencyINTEL",
            max_interleaving_intel = 2097152 "MaxInterleavingINTEL",
            dependency_array_intel = 262144 "DependencyArrayINTEL",
            speculated_iterations_intel = 4194304 "SpeculatedIterationsINTEL",
            pipeline_enable_intel = 524288 "PipelineEnableINTEL",
            no_fusion_intel = 8388608 "NoFusionINTEL"];
  }
  enum SelectionControl: bits {
    Doc "SPIR-V SelectionControl enum attribute.";
    Cases [ none = 0 "None", flatten = 1 "Flatten", dont_flatten = 2 "DontFlatten"];
  }
  enum CooperativeMatrixLayoutKHR {
    Doc "SPIR-V CooperativeMatrixLayoutKHR enum attribute.";
    Cases [ row_major = 0 "RowMajor", column_major = 1 "ColumnMajor"];
  }
  enum MemoryAccess: bits {
    Doc "SPIR-V MemoryAccess enum attribute.";
    Cases [ none = 0 "None", volatile = 1 "Volatile", aligned = 2 "Aligned",
            nontemporal = 4 "Nontemporal", make_pointer_available = 8 "MakePointerAvailable",
            make_pointer_visible = 16 "MakePointerVisible",
            non_private_pointer = 32 "NonPrivatePointer",
            alias_scope_intel_mask = 65536 "AliasScopeINTELMask",
            no_alias_intel_mask = 131072 "NoAliasINTELMask"];
  }
  enum CooperativeMatrixOperandsKHR: bits {
    Doc "SPIR-V CooperativeMatrixOperandsKHR enum attribute.";
    Cases [ none = 0 "None", a_signed = 1 "ASigned", b_signed = 2 "BSigned",
            c_signed = 4 "CSigned", result_signed = 8 "ResultSigned", acc_sat = 16 "AccSat"];
  }
  enum GroupOperation {
    Doc "SPIR-V GroupOperation enum attribute.";
    Cases [ reduce = 0 "Reduce", inclusive_scan = 1 "InclusiveScan",
            exclusive_scan = 2 "ExclusiveScan", clustered_reduce = 3 "ClusteredReduce",
            partitioned_reduce_nv = 6 "PartitionedReduceNV",
            partitioned_inclusive_scan_nv = 7 "PartitionedInclusiveScanNV",
            partitioned_exclusive_scan_nv = 8 "PartitionedExclusiveScanNV"];
  }
  enum ImageOperands: bits {
    Doc "SPIR-V ImageOperands enum attribute.";
    Cases [ none = 0 "None", bias = 1 "Bias", lod = 2 "Lod", grad = 4 "Grad",
            const_offset = 8 "ConstOffset", offset = 16 "Offset",
            const_offsets = 32 "ConstOffsets", sample = 64 "Sample", min_lod = 128 "MinLod",
            make_texel_available = 256 "MakeTexelAvailable",
            make_texel_visible = 512 "MakeTexelVisible",
            non_private_texel = 1024 "NonPrivateTexel", volatile_texel = 2048 "VolatileTexel",
            sign_extend = 4096 "SignExtend", offsets = 65536 "Offsets",
            zero_extend = 8192 "ZeroExtend", nontemporal = 16384 "Nontemporal"];
  }
  enum PackedVectorFormat {
    Doc "SPIR-V PackedVectorFormat enum attribute.";
    Cases [ packed_vector_format4x8_bit = 0 "PackedVectorFormat4x8Bit"];
  }
  enum StorageClass {
    Doc "SPIR-V StorageClass enum attribute.";
    Cases [ uniform_constant = 0 "UniformConstant", input = 1 "Input", uniform = 2 "Uniform",
            output = 3 "Output", workgroup = 4 "Workgroup", cross_workgroup = 5 "CrossWorkgroup",
            private = 6 "Private", function = 7 "Function", generic = 8 "Generic",
            push_constant = 9 "PushConstant", atomic_counter = 10 "AtomicCounter",
            image = 11 "Image", storage_buffer = 12 "StorageBuffer",
            callable_data_khr = 5328 "CallableDataKHR",
            incoming_callable_data_khr = 5329 "IncomingCallableDataKHR",
            ray_payload_khr = 5338 "RayPayloadKHR", hit_attribute_khr = 5339 "HitAttributeKHR",
            incoming_ray_payload_khr = 5342 "IncomingRayPayloadKHR",
            shader_record_buffer_khr = 5343 "ShaderRecordBufferKHR",
            physical_storage_buffer = 5349 "PhysicalStorageBuffer",
            task_payload_workgroup_ext = 5402 "TaskPayloadWorkgroupEXT",
            code_section_intel = 5605 "CodeSectionINTEL",
            device_only_intel = 5936 "DeviceOnlyINTEL", host_only_intel = 5937 "HostOnlyINTEL"];
  }
  enum QuadSwapDirection {
    Doc "SPIR-V QuadSwapDirection enum attribute.";
    Cases [ horizontal = 0 "Horizontal", vertical = 1 "Vertical", diagonal = 2 "Diagonal"];
  }
  enum ExecutionModel {
    Doc "SPIR-V ExecutionModel enum attribute.";
    Cases [ vertex = 0 "Vertex", tessellation_control = 1 "TessellationControl",
            tessellation_evaluation = 2 "TessellationEvaluation", geometry = 3 "Geometry",
            fragment = 4 "Fragment", gl_compute = 5 "GLCompute", kernel = 6 "Kernel",
            ray_generation_khr = 5313 "RayGenerationKHR",
            intersection_khr = 5314 "IntersectionKHR", any_hit_khr = 5315 "AnyHitKHR",
            closest_hit_khr = 5316 "ClosestHitKHR", miss_khr = 5317 "MissKHR",
            callable_khr = 5318 "CallableKHR", task_ext = 5364 "TaskEXT", mesh_ext = 5365 "MeshEXT"];
  }
  enum ExecutionMode {
    Doc "SPIR-V ExecutionMode enum attribute.";
    Cases [ invocations = 0 "Invocations", spacing_equal = 1 "SpacingEqual",
            spacing_fractional_even = 2 "SpacingFractionalEven",
            spacing_fractional_odd = 3 "SpacingFractionalOdd", vertex_order_cw = 4 "VertexOrderCw",
            vertex_order_ccw = 5 "VertexOrderCcw", pixel_center_integer = 6 "PixelCenterInteger",
            origin_upper_left = 7 "OriginUpperLeft", origin_lower_left = 8 "OriginLowerLeft",
            early_fragment_tests = 9 "EarlyFragmentTests", point_mode = 10 "PointMode",
            xfb = 11 "Xfb", depth_replacing = 12 "DepthReplacing",
            depth_greater = 14 "DepthGreater", depth_less = 15 "DepthLess",
            depth_unchanged = 16 "DepthUnchanged", local_size = 17 "LocalSize",
            local_size_hint = 18 "LocalSizeHint", input_points = 19 "InputPoints",
            input_lines = 20 "InputLines", input_lines_adjacency = 21 "InputLinesAdjacency",
            triangles = 22 "Triangles", input_triangles_adjacency = 23 "InputTrianglesAdjacency",
            quads = 24 "Quads", isolines = 25 "Isolines", output_vertices = 26 "OutputVertices",
            output_points = 27 "OutputPoints", output_line_strip = 28 "OutputLineStrip",
            output_triangle_strip = 29 "OutputTriangleStrip", vec_type_hint = 30 "VecTypeHint",
            contraction_off = 31 "ContractionOff", initializer = 33 "Initializer",
            finalizer = 34 "Finalizer", subgroup_size = 35 "SubgroupSize",
            subgroups_per_workgroup = 36 "SubgroupsPerWorkgroup",
            subgroups_per_workgroup_id = 37 "SubgroupsPerWorkgroupId",
            local_size_id = 38 "LocalSizeId", local_size_hint_id = 39 "LocalSizeHintId",
            subgroup_uniform_control_flow_khr = 4421 "SubgroupUniformControlFlowKHR",
            post_depth_coverage = 4446 "PostDepthCoverage",
            denorm_preserve = 4459 "DenormPreserve",
            denorm_flush_to_zero = 4460 "DenormFlushToZero",
            signed_zero_inf_nan_preserve = 4461 "SignedZeroInfNanPreserve",
            rounding_mode_rte = 4462 "RoundingModeRTE", rounding_mode_rtz = 4463 "RoundingModeRTZ",
            early_and_late_fragment_tests_amd = 5017 "EarlyAndLateFragmentTestsAMD",
            stencil_ref_replacing_ext = 5027 "StencilRefReplacingEXT",
            stencil_ref_unchanged_front_amd = 5079 "StencilRefUnchangedFrontAMD",
            stencil_ref_greater_front_amd = 5080 "StencilRefGreaterFrontAMD",
            stencil_ref_less_front_amd = 5081 "StencilRefLessFrontAMD",
            stencil_ref_unchanged_back_amd = 5082 "StencilRefUnchangedBackAMD",
            stencil_ref_greater_back_amd = 5083 "StencilRefGreaterBackAMD",
            stencil_ref_less_back_amd = 5084 "StencilRefLessBackAMD",
            output_lines_ext = 5269 "OutputLinesEXT",
            output_primitives_ext = 5270 "OutputPrimitivesEXT",
            derivative_group_quads_nv = 5289 "DerivativeGroupQuadsNV",
            derivative_group_linear_nv = 5290 "DerivativeGroupLinearNV",
            output_triangles_ext = 5298 "OutputTrianglesEXT",
            pixel_interlock_ordered_ext = 5366 "PixelInterlockOrderedEXT",
            pixel_interlock_unordered_ext = 5367 "PixelInterlockUnorderedEXT",
            sample_interlock_ordered_ext = 5368 "SampleInterlockOrderedEXT",
            sample_interlock_unordered_ext = 5369 "SampleInterlockUnorderedEXT",
            shading_rate_interlock_ordered_ext = 5370 "ShadingRateInterlockOrderedEXT",
            shading_rate_interlock_unordered_ext = 5371 "ShadingRateInterlockUnorderedEXT",
            shared_local_memory_size_intel = 5618 "SharedLocalMemorySizeINTEL",
            rounding_mode_rtpintel = 5620 "RoundingModeRTPINTEL",
            rounding_mode_rtnintel = 5621 "RoundingModeRTNINTEL",
            floating_point_mode_altintel = 5622 "FloatingPointModeALTINTEL",
            floating_point_mode_ieeeintel = 5623 "FloatingPointModeIEEEINTEL",
            max_workgroup_size_intel = 5893 "MaxWorkgroupSizeINTEL",
            max_work_dim_intel = 5894 "MaxWorkDimINTEL",
            no_global_offset_intel = 5895 "NoGlobalOffsetINTEL",
            num_simd_workitems_intel = 5896 "NumSIMDWorkitemsINTEL",
            scheduler_target_fmax_mhz_intel = 5903 "SchedulerTargetFmaxMhzINTEL",
            streaming_interface_intel = 6154 "StreamingInterfaceINTEL",
            named_barrier_count_intel = 6417 "NamedBarrierCountINTEL"];
  }
  enum FunctionControl: bits {
    Doc "SPIR-V FunctionControl enum attribute.";
    Cases [ none = 0 "None", inline = 1 "Inline", dont_inline = 2 "DontInline", pure = 4 "Pure",
            const = 8 "Const", opt_none_intel = 65536 "OptNoneINTEL"];
  }
  enum AddressingModel {
    Doc "SPIR-V AddressingModel enum attribute.";
    Cases [ logical = 0 "Logical", physical32 = 1 "Physical32", physical64 = 2 "Physical64",
            physical_storage_buffer64 = 5348 "PhysicalStorageBuffer64"];
  }
  enum MemoryModel {
    Doc "SPIR-V MemoryModel enum attribute.";
    Cases [ simple = 0 "Simple", glsl450 = 1 "GLSL450", open_cl = 2 "OpenCL", vulkan = 3 "Vulkan"];
  }
  enum TosaExtNaNPropagationModeType {
    Doc "SPIR-V TosaExtNaNPropagationModeType enum attribute.";
    Cases [ propagate = 1 "Propagate", ignore = 2 "Ignore"];
  }
  enum TosaExtAccType {
    Doc "SPIR-V TosaExtAccType enum attribute.";
    Cases [ int32 = 1 "INT32", fp16 = 2 "FP16", fp32 = 3 "FP32", int48 = 4 "INT48"];
  }
  enum TosaExtResizeModeType {
    Doc "SPIR-V TosaExtResizeModeType enum attribute.";
    Cases [ nearest_neighbor = 1 "NearestNeighbor", bilinear = 2 "Bilinear"];
  }
  enum TosaExtRoundingModeType {
    Doc "SPIR-V TosaExtRoundingModeType enum attribute.";
    Cases [ single_round = 1 "SingleRound", inexact_round = 2 "InexactRound",
            double_round = 3 "DoubleRound"];
  }

  // ----------------------------------------------------------------
  // 类型域
  // ----------------------------------------------------------------
  type_def any_ptr {
    Doc "SPIR-V 指针类型；pointee 与 storage class 是类型参数/verifier 事实。";
  }
  type_def image {
    Doc "SPIR-V image 类型；dim/depth/arrayed 等是类型参数。";
  }
  type_def sampled_image {
    Doc "SPIR-V sampled image 类型（image + sampler）。";
  }
  type_def sampler {
    Doc "SPIR-V sampler 类型。";
  }
  type_def cooperative_matrix {
    Doc "SPIR-V cooperative matrix 类型；分量类型/行列数是参数。";
  }
  type_def matrix {
    Doc "SPIR-V matrix 类型（列向量组成的复合类型）。";
  }
  type_def any_struct {
    Doc "SPIR-V struct 类型；成员由元素类型给出。";
  }
  type_def any_array {
    Doc "SPIR-V array 或 runtime array 类型。";
  }
  type_def named_barrier {
    Doc "SPIR-V named barrier 类型。";
  }
  type_def void {
    Doc "SPIR-V void 类型。";
  }
  type_def tensor_arm {
    Doc "SPIR-V tensor 类型（ARM tensor 扩展）：元素类型 + 秩；rank 0 表示上游未固定秩。";
    Parameters (element: any, rank: integer);
    Assembly { "<" element "," rank ">" }
  }

  constraint fp = f16 | f32 | f64;
  constraint fp16_or_fp32 = f16 | f32;
  constraint fp_ext = fp | bf16 | fp8 | f6 | f4;
  constraint fp8 = f8e4m3fn | f8e5m2;
  constraint f6 = f6e2m3fn | f6e3m2fn;
  constraint f4 = f4e2m1fn;
  constraint int_scalar = i8 | i16 | i32 | i64;
  constraint bool_scalar = bool;
  constraint scalar = bool_scalar | int_scalar | fp;
  constraint vector = vector<scalar, 1>;
  constraint fp_vec = vector<fp, 1>;
  constraint int_vec = vector<int_scalar, 1>;
  constraint bool_vec = vector<bool_scalar, 1>;
  constraint fp_scalar_or_vector = fp | fp_vec;
  constraint fp16_or_fp32_scalar_or_vector = fp16_or_fp32 | vector<fp16_or_fp32, 1>;
  constraint i32_scalar_or_vector = i32 | vector<i32, 1>;
  constraint f32_scalar_or_vector = f32 | vector<f32, 1>;
  constraint i16_scalar_or_vector = i16 | vector<i16, 1>;
  constraint int_scalar_or_vector = int_scalar | int_vec;
  constraint bool_scalar_or_vector = bool_scalar | bool_vec;
  constraint scalar_or_vector = scalar | vector;
  constraint scalar_or_vector_or_ptr_or_coop_matrix = scalar | vector | any_ptr | cooperative_matrix;
  constraint fp_scalar_vector_or_coop_matrix = fp | fp_vec | cooperative_matrix;
  constraint int_scalar_vector_or_coop_matrix = int_scalar | int_vec | cooperative_matrix;
  constraint fp_ext_scalar_or_vector = fp_ext | vector<fp_ext, 1>;
  constraint fp_ext_scalar_vector_or_coop_matrix = fp_ext | vector<fp_ext, 1> | cooperative_matrix;
  constraint numerical = int_scalar | fp;
  constraint composite = scalar | vector | any_array | any_struct | cooperative_matrix | matrix;
  constraint select_type = scalar | vector;
  constraint any_type = composite | any_ptr | image | sampled_image | sampler | void | named_barrier | tensor_arm<any, 0>;
  constraint any_ptr_or_untyped_ptr = any_ptr;
  constraint matrix_or_coop_matrix = matrix | cooperative_matrix;
  constraint i32_vec4 = vector<i32, 4>;
  constraint int_vec4 = vector<i32, 4>;
  constraint float_ext_scalar_or_vector = fp_ext | vector<fp_ext, 1>;

  // ----------------------------------------------------------------
  // 基础 schema：SPIRV_Op 的四个 availability 接口
  // ----------------------------------------------------------------
  schema SpirvOp {
    Doc "SPIRV_Op 基类：每个 op 都实现 version/extension/capability 查询接口。";
    Implements [QueryMinVersionInterface, QueryMaxVersionInterface, QueryExtensionInterface, QueryCapabilityInterface];
  }

  // ----------------------------------------------------------------
  // 族 schema
  // ----------------------------------------------------------------
  schema CLUnaryFP extends SpirvOp {
    Doc "OpenCL 一元浮点函数：单操作数、同型结果、无属性。";
    Operands   (operand: fp_scalar_or_vector);
    Results    (result: fp_scalar_or_vector);
    Properties [pure, same_type];
    Assembly { operand ":" type(operand) attr-dict }
  }

  schema GLUnaryFP16Or32 extends SpirvOp {
    Doc "GLSL 一元浮点函数（f16/f32）：可推测、无副作用。";
    Operands   (operand: fp16_or_fp32_scalar_or_vector);
    Results    (result: fp16_or_fp32_scalar_or_vector);
    Properties [no_memory_effect, speculatable, same_type];
    Assembly { operand ":" type(operand) attr-dict }
  }

  schema GLUnaryFP extends SpirvOp {
    Doc "GLSL 一元浮点函数（任意浮点）：可推测、无副作用。";
    Operands   (operand: fp_scalar_or_vector);
    Results    (result: fp_scalar_or_vector);
    Properties [no_memory_effect, speculatable, same_type];
    Assembly { operand ":" type(operand) attr-dict }
  }

  schema AtomicRMWInt extends SpirvOp {
    Doc "原子读改写：指针 + 整数值，结果是指针元素类型。";
    Operands   (pointer: any_ptr, value: int_scalar);
    Results    (result: int_scalar);
    Attributes (memory_scope: Scope, semantics: MemorySemantics);
    Properties [element_type_matches(value, pointer), element_type_matches(result, pointer)];
    Assembly { memory_scope semantics pointer "," value attr-dict ":" type(pointer) }
  }

  schema NonUniformBinaryInt extends SpirvOp {
    Doc "subgroup 非一致整数归约：execution_scope/group_operation 决定范围。";
    Operands   (value: int_scalar_or_vector, cluster_size: optional<int_scalar>);
    Results    (results: int_scalar_or_vector);
    Attributes (execution_scope: Scope, group_operation: GroupOperation);
    Properties [same_type(value, results)];
    Assembly { execution_scope group_operation value if cluster_size { "cluster_size" "(" cluster_size ")" } attr-dict ":" type(value) if cluster_size { "," type(cluster_size) } "->" type(results) }
  }

  schema CLBinaryFP extends SpirvOp {
    Doc "OpenCL 二元浮点函数：两操作数与结果同型。";
    Operands   (lhs: fp_scalar_or_vector, rhs: fp_scalar_or_vector);
    Results    (result: fp_scalar_or_vector);
    Properties [pure, same_type];
    Assembly { lhs "," rhs attr-dict ":" type(result) }
  }

  schema FPCompareOrdered extends SpirvOp {
    Doc "有序/无序浮点比较：结果是操作数的 i1 形状对应。";
    Operands   (operand1: fp_scalar_or_vector, operand2: fp_scalar_or_vector);
    Results    (result: bool_scalar_or_vector);
    Properties [pure, same_type, same_shape, same_shape(result, operand1)];
    Assembly { operand1 "," operand2 ":" type(operand1) attr-dict }
  }

  schema IntCompare extends SpirvOp {
    Doc "整数比较：有符号或无符号，结果是 i1 形状对应。";
    Operands   (operand1: int_scalar_or_vector, operand2: int_scalar_or_vector);
    Results    (result: bool_scalar_or_vector);
    Properties [pure, same_type, same_shape, same_shape(result, operand1)];
    Assembly { operand1 "," operand2 ":" type(operand1) attr-dict }
  }

  schema TosaUnaryElementwise extends SpirvOp {
    Doc "TOSA 一元逐元素函数：输入输出同为浮点张量。";
    Operands   (input1: tensor_arm<f16 | f32 | bf16>);
    Results    (results: tensor_arm<f16 | f32 | bf16>);
    Properties [pure, has_parent(ARM.Graph), same_type(input1, results)];
    Assembly { input1 attr-dict ":" type(input1) "->" type(results) }
  }

  schema GLBinaryFP extends SpirvOp {
    Doc "GLSL 二元浮点函数：可推测、无副作用。";
