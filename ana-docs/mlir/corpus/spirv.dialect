    Assembly { sampled_image "," coordinate custom<ImageOperands>(image_operands) if operand_arguments { "," operand_arguments } attr-dict ":" type(sampled_image) "," type(coordinate) if operand_arguments { "," type(operand_arguments) } "->" type(result) }
  }
