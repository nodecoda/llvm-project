    Doc "Resize operation, supports various resize/upsample modes.";
    Operands   (input: tensor_arm<i8 | i16 | f16 | f32 | bf16, 4>, scale: tensor_arm<i32, 1>, offset: tensor_arm<i32, 1>, border: tensor_arm<i32, 1>);
    Results    (results: tensor_arm<i32 | i8 | i64 | i16 | f16 | f32 | bf16, 4>);
    Attributes (mode: TosaExtResizeModeType);
    Properties [pure, has_parent(ARM.Graph)];
    Assembly { "mode" "=" mode "," input "," scale "," offset "," border attr-dict ":" type(input) "," type(scale) "," type(offset) "," type(border) "->" type(results) }
  }
  op Tosa.Cast from SpirvOp {
    Doc "Cast operation.";
    Operands   (input: tensor_arm<bool_scalar | i8 | i16 | i32 | f16 | f32 | bf16 | fp8>);
    Results    (results: tensor_arm<i8 | i16 | i32 | bool_scalar | f16 | f32 | bf16 | fp8>);
    Properties [pure, has_parent(ARM.Graph)];
    Assembly { input attr-dict ":" type(input) "->" type(results) }
  }
  op Tosa.Rescale from SpirvOp {
    Doc "Rescale operator.";
    Operands   (input: tensor_arm<i8 | i16 | i32 | i64>, multiplier: tensor_arm<i16 | i32, 1>, shift: tensor_arm<i8, 1>, input_zp: tensor_arm<i8 | i16 | i32 | i64, 1>, output_zp: tensor_arm<i8 | i16 | i32, 1>);
    Results    (results: tensor_arm<i8 | i16 | i32>);
    Attributes (scale32: bool, rounding_mode: TosaExtRoundingModeType, per_channel: bool, input_unsigned: bool, output_unsigned: bool);
    Properties [no_memory_effect, same_element_type, has_parent(ARM.Graph)];
    Assembly { "scale32" "=" scale32 "," "rounding_mode" "=" rounding_mode "," "per_channel" "=" per_channel "," "input_unsigned" "=" input_unsigned "," "output_unsigned" "=" output_unsigned "," input "," multiplier "," shift "," input_zp "," output_zp attr-dict ":" type(input) "," type(multiplier) "," type(shift) "," type(input_zp) "," type(output_zp) "->" type(results) }
  }
}

