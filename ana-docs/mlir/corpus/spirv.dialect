    Results    (result: int_scalar_or_vector);
    Attributes (execution_scope: Scope, group_operation: GroupOperation);
    Properties [pure, same_type(x, result)];
    Assembly { execution_scope group_operation x attr-dict ":" type(x) }
  }

  schema CLBinaryInt extends SpirvOp {
    Doc "OpenCL 二元整数函数。";
    Operands   (lhs: int_scalar_or_vector, rhs: int_scalar_or_vector);
    Results    (result: int_scalar_or_vector);
    Properties [pure, same_type];
    Assembly { lhs "," rhs attr-dict ":" type(result) }
  }

  schema GLBinaryInt extends SpirvOp {
    Doc "GLSL 二元整数函数：可推测。";
    Operands   (lhs: int_scalar_or_vector, rhs: int_scalar_or_vector);
    Results    (result: int_scalar_or_vector);
    Properties [no_memory_effect, speculatable, same_type];
    Assembly { lhs "," rhs attr-dict ":" type(result) }
  }

  schema NonUniformBinaryFP extends SpirvOp {
