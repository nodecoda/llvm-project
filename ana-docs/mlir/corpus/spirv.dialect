    Attributes (axis: i32 [non_negative], nan_mode: TosaExtNaNPropagationModeType);
    Properties [pure, has_parent(ARM.Graph)];
    Assembly { "axis" "=" axis "," "nan_mode" "=" nan_mode "," input attr-dict ":" type(input) "->" type(results) }
  }
