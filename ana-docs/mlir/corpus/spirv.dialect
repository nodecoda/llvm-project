    Doc "Bit pattern-preserving conversion of a pointer to an unsigned scalar integer of possibly different bit width.";
    Operands   (pointer: any_ptr);
    Results    (result: int_scalar);
    Assembly { pointer attr-dict ":" type(pointer) "to" type(result) }
  }
  op ConvertUToPtr from SpirvOp {
    Doc "Bit pattern-preserving conversion of an unsigned scalar integer to a pointer.";
    Operands   (operand: int_scalar);
    Results    (result: any_ptr);
    Assembly { operand attr-dict ":" type(operand) "to" type(result) }
  }
