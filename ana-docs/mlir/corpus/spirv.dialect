    Results    (result: bool_scalar_or_vector);
    Properties [pure, same_type, same_shape, same_shape(result, operand)];
    Assembly { operand ":" type(operand) attr-dict }
  }

  schema GroupBinaryFP extends SpirvOp {
    Doc "subgroup 浮点归约。";
    Operands   (x: fp_scalar_or_vector);
    Results    (result: fp_scalar_or_vector);
    Attributes (execution_scope: Scope, group_operation: GroupOperation);
    Properties [pure, same_type(x, result)];
    Assembly { execution_scope group_operation x attr-dict ":" type(x) }
  }

  schema BoolBinary extends SpirvOp {
