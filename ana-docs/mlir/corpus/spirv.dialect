    Properties [commutative];
  }
  op INotEqual from IntCompare {
    Doc "Integer comparison for inequality.";
    Properties [commutative];
  }
  op IsFinite from FPClassTest {
    Doc "Result is true if x is an IEEE Finite, otherwise result is false";
  }
  op IsInf from FPClassTest {
    Doc "Result is true if x is an IEEE Inf, otherwise result is false";
  }
  op IsNan from FPClassTest {
    Doc "Result is true if x is an IEEE NaN, otherwise result is false.";
  }
  op IsNormal from FPClassTest {
    Doc "Result is true if x is an IEEE normal number, otherwise result is false";
  }
  op LogicalAnd from BoolBinary {
    Doc "Result is true if both Operand 1 and Operand 2 are true. Result is false if either Operand 1 or Operand 2 are false.";
  }
  op LogicalEqual from BoolBinary {
    Doc "Result is true if Operand 1 and Operand 2 have the same value. Result is false if Operand 1 and Operand 2 have different values.";
  }
  op LogicalNot from SpirvOp {
    Doc "Result is true if Operand is false. Result is false if Operand is true.";
    Operands   (operand: bool_scalar_or_vector);
    Results    (result: bool_scalar_or_vector);
    Properties [pure, same_type, same_shape, same_shape(result, operand)];
    Assembly { operand ":" type(operand) attr-dict }
  }
  op LogicalNotEqual from BoolBinary {
    Doc "Result is true if Operand 1 and Operand 2 have different values. Result is false if Operand 1 and Operand 2 have the same value.";
  }
  op LogicalOr from BoolBinary {
    Doc "Result is true if either Operand 1 or Operand 2 is true. Result is false if both Operand 1 and Operand 2 are false.";
  }
  op Ordered from FPCompareOrdered {
    Doc "Result is true if both x == x and y == y are true, where IEEE comparison is used, otherwise result is false.";
    Properties [commutative];
  }
  op SGreaterThan from IntCompare {
    Doc "Signed-integer comparison if Operand 1 is greater than Operand 2.";
  }
  op SGreaterThanEqual from IntCompare {
    Doc "Signed-integer comparison if Operand 1 is greater than or equal to Operand 2.";
  }
  op SLessThan from IntCompare {
    Doc "Signed-integer comparison if Operand 1 is less than Operand 2.";
  }
  op SLessThanEqual from IntCompare {
    Doc "Signed-integer comparison if Operand 1 is less than or equal to Operand 2.";
  }
  op Select from SpirvOp {
    Doc "Select between two objects. Before version 1.4, results are only computed per component.";
    Operands   (condition: bool_scalar_or_vector, true_value: select_type, false_value: select_type);
    Results    (result: select_type);
    Properties [pure, same_type(true_value, false_value), same_type(false_value, result)];
    Implements [SelectLikeOpInterface];
    Assembly { condition "," true_value "," false_value attr-dict ":" type(condition) "," type(result) }
  }
  op UGreaterThan from IntCompare {
    Doc "Unsigned-integer comparison if Operand 1 is greater than Operand 2.";
  }
  op UGreaterThanEqual from IntCompare {
    Doc "Unsigned-integer comparison if Operand 1 is greater than or equal to Operand 2.";
  }
  op ULessThan from IntCompare {
    Doc "Unsigned-integer comparison if Operand 1 is less than Operand 2.";
  }
  op Unordered from FPCompareOrdered {
    Doc "Result is true if either x or y is an IEEE NaN, otherwise result is false.";
    Properties [commutative];
  }
  op ULessThanEqual from IntCompare {
    Doc "Unsigned-integer comparison if Operand 1 is less than or equal to Operand 2.";
  }

