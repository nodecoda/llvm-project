    Assembly { memory_scope semantics pointer attr-dict ":" type(pointer) }
  }
  op AtomicStore from SpirvOp {
    Doc "Atomically store through Pointer using the given Semantics.";
    Operands   (pointer: any_ptr, value: numerical);
    Attributes (memory_scope: Scope, semantics: MemorySemantics);
    Properties [element_type_matches(value, pointer)];
    Assembly { memory_scope semantics pointer "," value attr-dict ":" type(pointer) }
  }
  op AtomicExchange from SpirvOp {
    Doc "Perform the following steps atomically with respect to any other atomic accesses within Scope to the same location:";
    Operands   (pointer: any_ptr, value: numerical);
    Results    (result: numerical);
    Attributes (memory_scope: Scope, semantics: MemorySemantics);
    Properties [element_type_matches(value, pointer), element_type_matches(result, pointer)];
    Assembly { memory_scope semantics pointer "," value attr-dict ":" type(pointer) }
  }
