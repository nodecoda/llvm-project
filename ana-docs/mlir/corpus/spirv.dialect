    Properties [pure];
    Assembly { base_ptr "[" indices "]" attr-dict ":" type(base_ptr) "," type(indices) "->" type(results) }
  }

  // ----------------------------------------------------------------
  // ops（按上游文件顺序）
  // ----------------------------------------------------------------

  // == SPIRVArithmeticOps.td
  op FAdd from ArithBinaryFP {
    Doc "Floating-point addition of Operand 1 and Operand 2.";
    Properties [commutative];
  }
  op FDiv from ArithBinaryFP {
    Doc "Floating-point division of Operand 1 divided by Operand 2.";
  }
  op FMod from ArithBinaryFPPlain {
    Doc "The floating-point remainder whose sign matches the sign of Operand 2.";
  }
  op FMul from ArithBinaryFP {
    Doc "Floating-point multiplication of Operand 1 and Operand 2.";
    Properties [commutative];
  }
  op FNegate from SpirvOp {
    Doc "Inverts the sign bit of Operand. (Note, however, that OpFNegate is still considered a floating-point instruction, and so is subject to the general floating-point rules regarding, for example, subno.";
    Operands   (operand: fp_scalar_vector_or_coop_matrix);
    Results    (result: fp_scalar_vector_or_coop_matrix);
    Properties [pure, same_type(operand, result)];
    Assembly { operand attr-dict ":" type(result) }
  }
  op FRem from ArithBinaryFPPlain {
    Doc "The floating-point remainder whose sign matches the sign of Operand 1.";
  }
  op FSub from ArithBinaryFP {
    Doc "Floating-point subtraction of Operand 2 from Operand 1.";
  }
  op IAdd from ArithBinaryIntCoop {
    Doc "Integer addition of Operand 1 and Operand 2.";
    Properties [commutative];
  }
  op IAddCarry from SpirvOp {
    Doc "Integer addition of Operand 1 and Operand 2, including the carry.";
    Operands   (operand1: int_scalar_or_vector, operand2: int_scalar_or_vector);
    Results    (result: any_struct);
    Properties [commutative, pure];
    Assembly Custom;
  }
  op IMul from ArithBinaryIntCoop {
    Doc "Integer multiplication of Operand 1 and Operand 2.";
    Properties [commutative];
  }
  op ISub from ArithBinaryIntCoop {
    Doc "Integer subtraction of Operand 2 from Operand 1.";
  }
  op ISubBorrow from SpirvOp {
    Doc "Result is the unsigned integer subtraction of Operand 2 from Operand 1, and what it needed to borrow.";
    Operands   (operand1: int_scalar_or_vector, operand2: int_scalar_or_vector);
    Results    (result: any_struct);
    Properties [pure];
    Assembly Custom;
  }
  op Dot from SpirvOp {
    Doc "Dot product of Vector 1 and Vector 2";
    Operands   (vector1: scalar_or_vector, vector2: scalar_or_vector);
    Results    (result: any_type);
    Properties [pure, same_element_type, same_type(vector1, vector2)];
    Assembly { vector1 "," vector2 attr-dict ":" type(vector1) "->" type(result) }
  }
  op SDiv from ArithBinaryIntCoop {
    Doc "Signed-integer division of Operand 1 divided by Operand 2.";
  }
  op SMod from ArithBinaryIntPlain {
    Doc "Signed remainder operation for the remainder whose sign matches the sign of Operand 2.";
  }
  op SMulExtended from SpirvOp {
    Doc "Result is the full value of the signed integer multiplication of Operand 1 and Operand 2.";
    Operands   (operand1: int_scalar_or_vector, operand2: int_scalar_or_vector);
    Results    (result: any_struct);
    Properties [pure, commutative];
    Assembly Custom;
  }
  op SNegate from SpirvOp {
    Doc "Signed-integer subtract of Operand from zero.";
    Operands   (operand: int_scalar_vector_or_coop_matrix);
    Results    (result: int_scalar_vector_or_coop_matrix);
    Properties [pure, same_type(operand, result)];
    Assembly { operand attr-dict ":" type(result) }
  }
  op SRem from ArithBinaryIntPlain {
    Doc "Signed remainder operation for the remainder whose sign matches the sign of Operand 1.";
  }
  op UDiv from ArithBinaryIntCoop {
    Doc "Unsigned-integer division of Operand 1 divided by Operand 2.";
  }
  op UMulExtended from SpirvOp {
    Doc "Result is the full value of the unsigned integer multiplication of Operand 1 and Operand 2.";
    Operands   (operand1: int_scalar_or_vector, operand2: int_scalar_or_vector);
    Results    (result: any_struct);
    Properties [pure, commutative];
    Assembly Custom;
  }
  op VectorTimesScalar from SpirvOp {
    Doc "Scale a floating-point vector.";
    Operands   (vector: any_type, scalar: fp);
    Results    (result: any_type);
    Properties [pure];
    Assembly { vector "," scalar attr-dict ":" "(" type(vector) "," type(scalar) ")" "->" type(result) }
  }
  op UMod from ArithBinaryIntPlain {
    Doc "Unsigned modulo operation of Operand 1 modulo Operand 2.";
  }

  // == SPIRVAtomicOps.td
  op AtomicAnd from AtomicRMWInt {
    Doc "Perform the following steps atomically with respect to any other atomic accesses within Scope to the same location:";
  }
  op AtomicCompareExchange from SpirvOp {
    Doc "Perform the following steps atomically with respect to any other atomic accesses within Scope to the same location:";
    Operands   (pointer: any_ptr, value: int_scalar, comparator: int_scalar);
    Results    (result: int_scalar);
    Attributes (memory_scope: Scope, equal_semantics: MemorySemantics, unequal_semantics: MemorySemantics);
    Properties [element_type_matches(result, pointer), element_type_matches(value, pointer), element_type_matches(comparator, pointer)];
    Assembly { memory_scope equal_semantics unequal_semantics pointer "," value "," comparator attr-dict ":" type(pointer) }
  }
  op AtomicCompareExchangeWeak from SpirvOp {
    Doc "Deprecated (use OpAtomicCompareExchange).";
    Operands   (pointer: any_ptr, value: int_scalar, comparator: int_scalar);
    Results    (result: int_scalar);
    Attributes (memory_scope: Scope, equal_semantics: MemorySemantics, unequal_semantics: MemorySemantics);
    Properties [element_type_matches(result, pointer), element_type_matches(value, pointer), element_type_matches(comparator, pointer)];
    Assembly { memory_scope equal_semantics unequal_semantics pointer "," value "," comparator attr-dict ":" type(pointer) }
  }
