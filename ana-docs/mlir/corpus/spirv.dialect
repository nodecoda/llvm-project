  // == SPIRVCompositeOps.td
  op CompositeConstruct from SpirvOp {
    Doc "Construct a new composite object from a set of constituent objects.";
    Operands   (constituents: variadic<any_type>);
    Results    (result: composite);
    Properties [pure];
    Assembly { constituents attr-dict ":" "(" type(constituents) ")" "->" type(result) }
  }
  op CompositeExtract from SpirvOp {
    Doc "Extract a part of a composite object.";
    Operands   (composite: composite);
    Results    (component: any_type);
    Attributes (indices: array<i32>);
    Properties [pure];
    Assembly Custom;
  }
  op CompositeInsert from SpirvOp {
    Doc "Make a copy of a composite object, while modifying one part of it.";
    Operands   (object: any_type, composite: composite);
    Results    (result: composite);
    Attributes (indices: array<i32>);
    Properties [pure];
    Assembly Custom;
  }
  op CopyObject from SpirvOp {
    Doc "Make a copy of Operand. There are no pointer dereferences involved.";
    Operands   (operand: any_type);
    Results    (result: any_type);
    Properties [pure, same_type(operand, result)];
    Assembly { operand attr-dict ":" type(operand) }
  }
  op VectorExtractDynamic from SpirvOp {
    Doc "Extract a single, dynamically selected, component of a vector.";
    Operands   (vector: scalar_or_vector, index: int_scalar);
    Results    (result: scalar);
    Properties [pure];
    Assembly { vector "[" index "]" attr-dict ":" type(vector) "," type(index) }
  }
  op VectorInsertDynamic from SpirvOp {
    Doc "Make a copy of a vector, with a single, variably selected, component modified.";
    Operands   (vector: scalar_or_vector, component: scalar, index: int_scalar);
    Results    (result: scalar_or_vector);
    Properties [pure, same_type(vector, result)];
    Assembly { component "," vector "[" index "]" attr-dict ":" type(vector) "," type(index) }
  }
  op VectorShuffle from SpirvOp {
    Doc "Select arbitrary components from two vectors to make a new vector.";
    Operands   (vector1: scalar_or_vector, vector2: scalar_or_vector);
    Results    (result: scalar_or_vector);
    Attributes (components: array<i32>);
    Properties [pure, same_element_type];
    Assembly { attr-dict components vector1 "," vector2 ":" type(vector1) "," type(vector2) "->" type(result) }
  }

  // == SPIRVControlFlowOps.td
  op Branch from SpirvOp {
    Doc "Unconditional branch to target block.";
    Operands   (targetOperands: variadic<any_type>);
    Successors (target: successor);
    Properties [has_parent(func), pure, terminator];
    Implements [BranchOpInterface];
    Assembly { target if targetOperands { "(" targetOperands ":" type(targetOperands) ")" } attr-dict }
  }
  op BranchConditional from SpirvOp {
    Doc "If Condition is true, branch to true block, otherwise branch to false block.";
    Operands   (condition: bool_scalar, trueTargetOperands: variadic<any_type>, falseTargetOperands: variadic<any_type>);
    Attributes (branch_weights: optional<array<i32>>);
    Successors (trueTarget: successor, falseTarget: successor);
    Properties [has_parent(func), pure, terminator];
    Implements [BranchOpInterface];
    Assembly Custom;
  }
  op FunctionCall from SpirvOp {
    Doc "Call a function.";
    Operands   (arguments: variadic<any_type>);
    Results    (results: optional<any_type>);
    Attributes (callee: symbol_ref, arg_attrs: optional<array<dictionary>>, res_attrs: optional<array<dictionary>>);
    Properties [has_parent(func)];
    Implements [CallOpInterface, SymbolUserOpInterface];
    Assembly { callee "(" arguments ")" if arg_attrs { "arg_attrs" "=" arg_attrs } if res_attrs { "res_attrs" "=" res_attrs } attr-dict ":" functional-type(arguments, results) }
  }
  op Switch from SpirvOp {
    Doc "Multi-way branch to one of the operand label `<id>`.";
    Operands   (selector: int_scalar, defaultOperands: variadic<any_type>, targetOperands: variadic<variadic<any_type>>);
    Attributes (literals: optional<array<i32>>, case_operand_segments: array<i32>);
    Successors (defaultTarget: successor, targets: variadic<successor>);
    Properties [has_parent(func), pure, terminator];
    Implements [BranchOpInterface];
    Assembly { selector ":" type(selector) "," "[" "\n" custom<SwitchOpCases>(ref(type(selector)), defaultTarget, defaultOperands, type(defaultOperands), literals, targets, targetOperands, type(targetOperands)) "]" attr-dict }
  }
  op KHR.Abort from SpirvOp {
    Doc "Ceases all further processing in the invocation that executes it.";
    Operands   (message: any_type);
    Properties [has_parent(func), terminator];
    Assembly { message attr-dict ":" type(message) }
  }
  op Kill from SpirvOp {
    Doc "Deprecated (use OpTerminateInvocation or OpDemoteToHelperInvocation).";
    Properties [terminator];
    Assembly { attr-dict }
  }
  op LifetimeStart from SpirvOp {
    Doc "Declare that an object was not defined before this instruction.";
    Operands   (pointer: any_ptr);
    Attributes (size: i32);
    Properties [has_parent(func)];
    Assembly { pointer "," size attr-dict ":" type(pointer) }
  }
  op LifetimeStop from SpirvOp {
    Doc "Declare that an object is dead after this instruction.";
    Operands   (pointer: any_ptr);
    Attributes (size: i32);
    Properties [has_parent(func)];
    Assembly { pointer "," size attr-dict ":" type(pointer) }
  }
  op mlir.loop from SpirvOp {
    Doc "Define a structured loop.";
    Results    (results: variadic<any_type>);
    Attributes (loop_control: LoopControl);
    Regions    (body: region);
    Properties [has_parent(func)];
    Assembly Custom;
  }
  op mlir.merge from SpirvOp {
    Doc "A special terminator for merging a structured selection/loop.";
    Operands   (operands: variadic<any_type>);
    Properties [pure, terminator, return_like];
    Assembly { attr-dict if operands { operands ":" type(operands) } }
  }
  op Return from SpirvOp {
    Doc "Return with no value from a function with void return type.";
    Properties [has_parent(func), pure, return_like, terminator];
    Assembly { attr-dict }
  }
  op Unreachable from SpirvOp {
    Doc "Behavior is undefined if this instruction is executed.";
    Properties [has_parent(func), terminator];
    Assembly { attr-dict }
  }
  op ReturnValue from SpirvOp {
    Doc "Return a value from a function.";
    Operands   (value: any_type);
    Properties [has_parent(func), pure, return_like, terminator];
    Assembly { value attr-dict ":" type(value) }
  }
  op mlir.selection from SpirvOp {
    Doc "Define a structured selection.";
    Results    (results: variadic<any_type>);
    Attributes (selection_control: SelectionControl);
    Regions    (body: region);
    Properties [has_parent(func)];
    Assembly Custom;
  }

  // == SPIRVCooperativeMatrixOps.td
  op KHR.CooperativeMatrixLength from SpirvOp {
    Doc "Queries the number of cooperative matrix components";
    Results    (result: i32);
    Attributes (cooperative_matrix_type: type);
    Properties [pure];
    Assembly { attr-dict ":" cooperative_matrix_type }
  }
  op KHR.CooperativeMatrixLoad from SpirvOp {
    Doc "Loads a cooperative matrix through a pointer";
    Operands   (pointer: any_ptr, stride: i32);
    Results    (result: cooperative_matrix);
    Attributes (matrix_layout: CooperativeMatrixLayoutKHR, memory_operand: optional<MemoryAccess>, alignment: optional<i32>);
    Implements [AlignmentAttrOpInterface];
    Assembly { pointer "," stride "," matrix_layout if memory_operand { "," memory_operand } if alignment { "," alignment } attr-dict ":" type(pointer) "," type(stride) "->" type(result) }
  }
  op KHR.CooperativeMatrixStore from SpirvOp {
    Doc "Stores a cooperative matrix through a pointer";
    Operands   (pointer: any_ptr, object: cooperative_matrix, stride: i32);
    Attributes (matrix_layout: CooperativeMatrixLayoutKHR, memory_operand: optional<MemoryAccess>, alignment: optional<i32>);
    Implements [AlignmentAttrOpInterface];
    Assembly { pointer "," object "," stride "," matrix_layout if memory_operand { "," memory_operand } if alignment { "," alignment } attr-dict ":" type(pointer) "," type(object) "," type(stride) }
  }
  op KHR.CooperativeMatrixMulAdd from SpirvOp {
    Doc "Returns the result of `(A x B) + C` of matrices A, B, and C";
    Operands   (a: cooperative_matrix, b: cooperative_matrix, c: cooperative_matrix);
    Results    (result: cooperative_matrix);
    Attributes (matrix_operands: optional<CooperativeMatrixOperandsKHR>);
    Properties [pure, same_type(c, result)];
    Assembly { a "," b "," c if matrix_operands { "," matrix_operands } attr-dict ":" type(a) "," type(b) "->" type(c) }
  }

  // == SPIRVExperimentalMLOps.td
  op ExperimentalML.Call from SpirvOp {
    Doc "Call an Arm experimental ML operation.";
    Operands   (parameters: variadic<any_type>);
    Results    (output: any_type);
    Attributes (opcode: i32);
    Assembly { "opcode" "=" opcode "," parameters attr-dict ":" functional-type(parameters, output) }
  }

