    Properties [pure, same_shape, same_type(operand1, result)];
    Assembly { operand1 "," operand2 attr-dict ":" type(operand1) "," type(operand2) }
  }

  schema TosaBinaryInt extends SpirvOp {
    Doc "TOSA 整数二元位运算：可广播。";
    Operands   (input1: tensor_arm<i8 | i16 | i32>, input2: tensor_arm<i8 | i16 | i32>);
    Results    (results: tensor_arm<i8 | i16 | i32>);
    Properties [pure, same_element_type, same_rank, broadcastable, has_parent(ARM.Graph)];
    Assembly { input1 "," input2 attr-dict ":" type(input1) "," type(input2) "->" type(results) }
  }

  schema TosaCompare extends SpirvOp {
    Doc "TOSA 比较：结果是 bool 张量。";
