  }
  op FUnordGreaterThanEqual from FPCompareOrdered {
    Doc "Floating-point comparison if operands are unordered or Operand 1 is greater than or equal to Operand 2.";
  }
  op FUnordLessThan from FPCompareOrdered {
    Doc "Floating-point comparison if operands are unordered or Operand 1 is less than Operand 2.";
  }
  op FUnordLessThanEqual from FPCompareOrdered {
    Doc "Floating-point comparison if operands are unordered or Operand 1 is less than or equal to Operand 2.";
  }
  op FUnordNotEqual from FPCompareOrdered {
    Doc "Floating-point comparison for being unordered or not equal.";
    Properties [commutative];
  }
  op IEqual from IntCompare {
