    Results    (result: bool_scalar_or_vector);
    Properties [commutative, pure, same_type, same_shape, same_shape(result, operand1)];
    Assembly { operand1 "," operand2 ":" type(operand1) attr-dict }
  }

  schema IntBitwiseBinary extends SpirvOp {
    Doc "整数位运算：可交换。";
