    Results    (result: int_scalar_vector_or_coop_matrix);
    Properties [pure, same_type(operand1, operand2), same_type(operand2, result)];
    Assembly { operand1 "," operand2 attr-dict ":" type(result) }
  }

  schema ArithBinaryFPPlain extends SpirvOp {
    Doc "算术二元浮点（不含协作矩阵）。";
    Operands   (operand1: fp_scalar_or_vector, operand2: fp_scalar_or_vector);
    Results    (result: fp_scalar_or_vector);
    Properties [pure, same_type(operand1, operand2), same_type(operand2, result)];
    Assembly { operand1 "," operand2 attr-dict ":" type(result) }
  }

  schema ArithBinaryIntPlain extends SpirvOp {
    Doc "算术二元整数（不含协作矩阵）。";
    Operands   (operand1: int_scalar_or_vector, operand2: int_scalar_or_vector);
    Results    (result: int_scalar_or_vector);
