    Results    (results: tensor_arm<bool_scalar>);
    Properties [pure, same_element_type, broadcastable, has_parent(ARM.Graph)];
    Assembly { input1 "," input2 attr-dict ":" type(input1) "," type(input2) "->" type(results) }
  }

  schema TosaUnaryActivation extends SpirvOp {
    Doc "TOSA 一元激活函数。";
    Operands   (input: tensor_arm<f16 | f32 | bf16>);
    Results    (results: tensor_arm<f16 | f32 | bf16>);
