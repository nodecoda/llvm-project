    Assembly { image "," coordinate "," texel custom<ImageOperands>(image_operands) if operand_arguments { "," operand_arguments } attr-dict ":" type(image) "," type(coordinate) "," type(texel) if operand_arguments { "," type(operand_arguments) } }
  }
