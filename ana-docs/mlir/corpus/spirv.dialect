  op INTEL.ControlBarrierArrive from SpirvOp {
    Doc "See extension SPV_INTEL_split_barrier";
    Attributes (execution_scope: Scope, memory_scope: Scope, memory_semantics: MemorySemantics);
    Assembly { execution_scope memory_scope memory_semantics attr-dict }
  }
  op INTEL.ControlBarrierWait from SpirvOp {
    Doc "See extension SPV_INTEL_split_barrier";
    Attributes (execution_scope: Scope, memory_scope: Scope, memory_semantics: MemorySemantics);
    Assembly { execution_scope memory_scope memory_semantics attr-dict }
  }
  op INTEL.MaskedGather from SpirvOp {
    Doc "Gather values from memory using a vector of pointers and a mask";
    Operands   (ptr_vector: scalar_or_vector, alignment: i32, mask: scalar_or_vector, fill_empty: scalar_or_vector);
    Results    (result: scalar_or_vector);
    Properties [same_type(fill_empty, result), same_shape(mask, result)];
    Assembly { ptr_vector "," alignment "," mask "," fill_empty attr-dict ":" type(ptr_vector) "," type(alignment) "," type(mask) "," type(fill_empty) "->" type(result) }
  }
  op INTEL.MaskedScatter from SpirvOp {
    Doc "Scatter values to memory using a vector of pointers and a mask";
    Operands   (ptr_vector: scalar_or_vector, alignment: i32, mask: scalar_or_vector, input_vector: scalar_or_vector);
    Properties [same_shape(mask, input_vector)];
    Assembly { ptr_vector "," alignment "," mask "," input_vector attr-dict ":" type(ptr_vector) "," type(alignment) "," type(mask) "," type(input_vector) }
  }
  op INTEL.FunctionPointerCall from SpirvOp {
    Doc "Call a function through a function pointer";
    Operands   (function_pointer: any_type, arguments: variadic<any_type>);
    Results    (results: optional<any_type>);
    Properties [has_parent(func)];
    Assembly { function_pointer "(" arguments ")" attr-dict ":" type(function_pointer) "," functional-type(arguments, results) }
  }

