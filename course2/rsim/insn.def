//===-- insn.def - the single list of instructions, chapter 03 ---*- C++ -*-===//
//
// X(ID, "mnemonic", Format, opcode, funct3, funct7, match_imm, isa, match_f5)
//
// 0xff in funct3/funct7/match_imm/match_f5 means "don't care".  match_imm is
// bits 31:20 (Zbb unary forms, ecall/ebreak/mret); match_f5 is bits 31:27,
// which is what separates lr.w/sc.w from the AMOs while ignoring aq/rl.
//
// This file is included several times with different definitions of
// RSIM_INSN: once for the enum, once for the decode table, once for the ISA
// mask.  Adding an instruction here is enough for the decoder to find it.
//
//===----------------------------------------------------------------------===//

RSIM_INSN(LUI,    "lui",    FmtU,     0x37, 0xff, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(AUIPC,  "auipc",  FmtU,     0x17, 0xff, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(JAL,    "jal",    FmtJ,     0x6f, 0xff, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(JALR,   "jalr",   FmtJalr,  0x67, 0x00, 0xff, 0xff, RV32I, 0xff)

RSIM_INSN(BEQ,    "beq",    FmtBranch, 0x63, 0x00, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(BNE,    "bne",    FmtBranch, 0x63, 0x01, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(BLT,    "blt",    FmtBranch, 0x63, 0x04, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(BGE,    "bge",    FmtBranch, 0x63, 0x05, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(BLTU,   "bltu",   FmtBranch, 0x63, 0x06, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(BGEU,   "bgeu",   FmtBranch, 0x63, 0x07, 0xff, 0xff, RV32I, 0xff)

RSIM_INSN(LB,     "lb",     FmtLoad,  0x03, 0x00, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(LH,     "lh",     FmtLoad,  0x03, 0x01, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(LW,     "lw",     FmtLoad,  0x03, 0x02, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(LBU,    "lbu",    FmtLoad,  0x03, 0x04, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(LHU,    "lhu",    FmtLoad,  0x03, 0x05, 0xff, 0xff, RV32I, 0xff)

RSIM_INSN(SB,     "sb",     FmtStore, 0x23, 0x00, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(SH,     "sh",     FmtStore, 0x23, 0x01, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(SW,     "sw",     FmtStore, 0x23, 0x02, 0xff, 0xff, RV32I, 0xff)

RSIM_INSN(ADDI,   "addi",   FmtI,     0x13, 0x00, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(SLTI,   "slti",   FmtI,     0x13, 0x02, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(SLTIU,  "sltiu",  FmtI,     0x13, 0x03, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(XORI,   "xori",   FmtI,     0x13, 0x04, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(ORI,    "ori",    FmtI,     0x13, 0x06, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(ANDI,   "andi",   FmtI,     0x13, 0x07, 0xff, 0xff, RV32I, 0xff)

RSIM_INSN(SLLI,   "slli",   FmtShift, 0x13, 0x01, 0x00, 0xff, RV32I, 0xff)
RSIM_INSN(SRLI,   "srli",   FmtShift, 0x13, 0x05, 0x00, 0xff, RV32I, 0xff)
RSIM_INSN(SRAI,   "srai",   FmtShift, 0x13, 0x05, 0x20, 0xff, RV32I, 0xff)

RSIM_INSN(ADD,    "add",    FmtR,     0x33, 0x00, 0x00, 0xff, RV32I, 0xff)
RSIM_INSN(SUB,    "sub",    FmtR,     0x33, 0x00, 0x20, 0xff, RV32I, 0xff)
RSIM_INSN(SLL,    "sll",    FmtR,     0x33, 0x01, 0x00, 0xff, RV32I, 0xff)
RSIM_INSN(SLT,    "slt",    FmtR,     0x33, 0x02, 0x00, 0xff, RV32I, 0xff)
RSIM_INSN(SLTU,   "sltu",   FmtR,     0x33, 0x03, 0x00, 0xff, RV32I, 0xff)
RSIM_INSN(XOR,    "xor",    FmtR,     0x33, 0x04, 0x00, 0xff, RV32I, 0xff)
RSIM_INSN(SRL,    "srl",    FmtR,     0x33, 0x05, 0x00, 0xff, RV32I, 0xff)
RSIM_INSN(SRA,    "sra",    FmtR,     0x33, 0x05, 0x20, 0xff, RV32I, 0xff)
RSIM_INSN(OR,     "or",     FmtR,     0x33, 0x06, 0x00, 0xff, RV32I, 0xff)
RSIM_INSN(AND,    "and",    FmtR,     0x33, 0x07, 0x00, 0xff, RV32I, 0xff)

RSIM_INSN(FENCE,  "fence",  FmtFence, 0x0f, 0x00, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(FENCE_I,"fence.i",FmtFence, 0x0f, 0x01, 0xff, 0xff, RV32I, 0xff)

RSIM_INSN(CSRRW,  "csrrw",  FmtCsr,   0x73, 0x01, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(CSRRS,  "csrrs",  FmtCsr,   0x73, 0x02, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(CSRRC,  "csrrc",  FmtCsr,   0x73, 0x03, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(CSRRWI, "csrrwi", FmtCsr,   0x73, 0x05, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(CSRRSI, "csrrsi", FmtCsr,   0x73, 0x06, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(CSRRCI, "csrrci", FmtCsr,   0x73, 0x07, 0xff, 0xff, RV32I, 0xff)
RSIM_INSN(MRET,   "mret",   FmtCsr,   0x73, 0x00, 0x18, 0x302, RV32I, 0xff)

RSIM_INSN(ECALL,  "ecall",  FmtSystem,0x73, 0x00, 0x00, 0x00, RV32I, 0xff)
RSIM_INSN(EBREAK, "ebreak", FmtSystem,0x73, 0x00, 0x00, 0x01, RV32I, 0xff)

RSIM_INSN(MUL,    "mul",    FmtR,     0x33, 0x00, 0x01, 0xff, RV32M, 0xff)
RSIM_INSN(MULH,   "mulh",   FmtR,     0x33, 0x01, 0x01, 0xff, RV32M, 0xff)
RSIM_INSN(MULHSU, "mulhsu", FmtR,     0x33, 0x02, 0x01, 0xff, RV32M, 0xff)
RSIM_INSN(MULHU,  "mulhu",  FmtR,     0x33, 0x03, 0x01, 0xff, RV32M, 0xff)
RSIM_INSN(DIV,    "div",    FmtR,     0x33, 0x04, 0x01, 0xff, RV32M, 0xff)
RSIM_INSN(DIVU,   "divu",   FmtR,     0x33, 0x05, 0x01, 0xff, RV32M, 0xff)
RSIM_INSN(REM,    "rem",    FmtR,     0x33, 0x06, 0x01, 0xff, RV32M, 0xff)
RSIM_INSN(REMU,   "remu",   FmtR,     0x33, 0x07, 0x01, 0xff, RV32M, 0xff)

// --- Zbb: bit manipulation (19 corpus lines, 18 distinct operations) -----
RSIM_INSN(CLZ,    "clz",    FmtUnary, 0x13, 0x1, 0x30, 0x600, Zbb, 0xff)
RSIM_INSN(CTZ,    "ctz",    FmtUnary, 0x13, 0x1, 0x30, 0x601, Zbb, 0xff)
RSIM_INSN(CPOP,   "cpop",   FmtUnary, 0x13, 0x1, 0x30, 0x602, Zbb, 0xff)
RSIM_INSN(SEXT_B, "sext.b", FmtUnary, 0x13, 0x1, 0x30, 0x604, Zbb, 0xff)
RSIM_INSN(SEXT_H, "sext.h", FmtUnary, 0x13, 0x1, 0x30, 0x605, Zbb, 0xff)
RSIM_INSN(REV8,   "rev8",   FmtUnary, 0x13, 0x5, 0x34, 0x698, Zbb, 0xff)
RSIM_INSN(ZEXT_H, "zext.h", FmtUnary, 0x33, 0x4, 0x04, 0x080, Zbb, 0xff)
RSIM_INSN(ROL,    "rol",    FmtR,     0x33, 0x1, 0x30, 0xff,  Zbb, 0xff)
RSIM_INSN(ROR,    "ror",    FmtR,     0x33, 0x5, 0x30, 0xff,  Zbb, 0xff)
RSIM_INSN(RORI,   "rori",   FmtShift, 0x13, 0x5, 0x30, 0xff,  Zbb, 0xff)
RSIM_INSN(ANDN,   "andn",   FmtR,     0x33, 0x7, 0x20, 0xff,  Zbb, 0xff)
RSIM_INSN(ORN,    "orn",    FmtR,     0x33, 0x6, 0x20, 0xff,  Zbb, 0xff)
RSIM_INSN(XNOR,   "xnor",   FmtR,     0x33, 0x4, 0x20, 0xff,  Zbb, 0xff)
RSIM_INSN(MIN,    "min",    FmtR,     0x33, 0x4, 0x05, 0xff,  Zbb, 0xff)
RSIM_INSN(MINU,   "minu",   FmtR,     0x33, 0x5, 0x05, 0xff,  Zbb, 0xff)
RSIM_INSN(MAX,    "max",    FmtR,     0x33, 0x6, 0x05, 0xff,  Zbb, 0xff)
RSIM_INSN(MAXU,   "maxu",   FmtR,     0x33, 0x7, 0x05, 0xff,  Zbb, 0xff)

// --- Zbs: single-bit operations (8 corpus lines) ------------------------
RSIM_INSN(BSET,   "bset",   FmtR,     0x33, 0x1, 0x14, 0xff,  Zbs, 0xff)
RSIM_INSN(BCLR,   "bclr",   FmtR,     0x33, 0x1, 0x24, 0xff,  Zbs, 0xff)
RSIM_INSN(BINV,   "binv",   FmtR,     0x33, 0x1, 0x34, 0xff,  Zbs, 0xff)
RSIM_INSN(BEXT,   "bext",   FmtR,     0x33, 0x5, 0x24, 0xff,  Zbs, 0xff)
RSIM_INSN(BSETI,  "bseti",  FmtShift, 0x13, 0x1, 0x14, 0xff,  Zbs, 0xff)
RSIM_INSN(BCLRI,  "bclri",  FmtShift, 0x13, 0x1, 0x24, 0xff,  Zbs, 0xff)
RSIM_INSN(BINVI,  "binvi",  FmtShift, 0x13, 0x1, 0x34, 0xff,  Zbs, 0xff)
RSIM_INSN(BEXTI,  "bexti",  FmtShift, 0x13, 0x5, 0x24, 0xff,  Zbs, 0xff)

// --- A: atomics (funct5, aq/rl ignored on a single hart) ----------------
RSIM_INSN(LR_W,      "lr.w",      FmtAtomic, 0x2f, 0x2, 0xff, 0xff, A, 0x02)
RSIM_INSN(SC_W,      "sc.w",      FmtAtomic, 0x2f, 0x2, 0xff, 0xff, A, 0x03)
RSIM_INSN(AMOSWAP_W, "amoswap.w", FmtAtomic, 0x2f, 0x2, 0xff, 0xff, A, 0x01)
RSIM_INSN(AMOADD_W,  "amoadd.w",  FmtAtomic, 0x2f, 0x2, 0xff, 0xff, A, 0x00)
RSIM_INSN(AMOXOR_W,  "amoxor.w",  FmtAtomic, 0x2f, 0x2, 0xff, 0xff, A, 0x04)
RSIM_INSN(AMOAND_W,  "amoand.w",  FmtAtomic, 0x2f, 0x2, 0xff, 0xff, A, 0x0c)
RSIM_INSN(AMOOR_W,   "amoor.w",   FmtAtomic, 0x2f, 0x2, 0xff, 0xff, A, 0x08)
RSIM_INSN(AMOMIN_W,  "amomin.w",  FmtAtomic, 0x2f, 0x2, 0xff, 0xff, A, 0x10)
RSIM_INSN(AMOMAX_W,  "amomax.w",  FmtAtomic, 0x2f, 0x2, 0xff, 0xff, A, 0x14)
RSIM_INSN(AMOMINU_W, "amominu.w", FmtAtomic, 0x2f, 0x2, 0xff, 0xff, A, 0x18)
RSIM_INSN(AMOMAXU_W, "amomaxu.w", FmtAtomic, 0x2f, 0x2, 0xff, 0xff, A, 0x1c)
