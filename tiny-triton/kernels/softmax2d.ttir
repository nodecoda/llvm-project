    %16 = tinytt.reduce %15 <axis = 1, combine = "add"> : tensor<8x8xf32> -> tensor<8x1xf32>
    %17 = tinytt.broadcast %16 : tensor<8x1xf32> -> tensor<8x8xf32>
    %18 = arith.divf %15, %17 : tensor<8x8xf32>
