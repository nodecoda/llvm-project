// vecadd TTIR golden: c[i] = a[i] + b[i] over one 1024-element block.
// Produced by `tiny-triton kernels/vecadd.py --emit ttir --arg-type ...`
// (chapter 2); chapter 1's hand-written version used tensor-typed pointer
// arguments, this one is Triton-faithful: scalar `!tinytt.ptr<f32>` args that
// `tinytt.splat` broadcasts before `tinytt.addptr`.
module {
  func.func @vecadd(%arg0: !tinytt.ptr<f32>, %arg1: !tinytt.ptr<f32>, %arg2: !tinytt.ptr<f32>) {
    %0 = tinytt.get_program_id <axis = 0> : i32
    %c1024_i32 = arith.constant 1024 : i32
    %1 = arith.muli %0, %c1024_i32 : i32
    %2 = tinytt.make_range <axis = 0> : tensor<1024xi32>
    %3 = tinytt.splat %1 : i32 -> tensor<1024xi32>
    %4 = arith.addi %3, %2 : tensor<1024xi32>
    %5 = tinytt.splat %arg0 : !tinytt.ptr<f32> -> tensor<1024x!tinytt.ptr<f32>>
    %6 = tinytt.addptr %5, %4 : tensor<1024x!tinytt.ptr<f32>>, tensor<1024xi32> -> tensor<1024x!tinytt.ptr<f32>>
    %7 = tinytt.load %6 : tensor<1024x!tinytt.ptr<f32>>, tensor<1024xf32>
    %8 = tinytt.splat %arg1 : !tinytt.ptr<f32> -> tensor<1024x!tinytt.ptr<f32>>
    %9 = tinytt.addptr %8, %4 : tensor<1024x!tinytt.ptr<f32>>, tensor<1024xi32> -> tensor<1024x!tinytt.ptr<f32>>
    %10 = tinytt.load %9 : tensor<1024x!tinytt.ptr<f32>>, tensor<1024xf32>
    %11 = tinytt.splat %arg2 : !tinytt.ptr<f32> -> tensor<1024x!tinytt.ptr<f32>>
    %12 = tinytt.addptr %11, %4 : tensor<1024x!tinytt.ptr<f32>>, tensor<1024xi32> -> tensor<1024x!tinytt.ptr<f32>>
    %13 = arith.addf %7, %10 : tensor<1024xf32>
    tinytt.store %12, %13 : tensor<1024x!tinytt.ptr<f32>>, tensor<1024xf32>
    return
  }
}
