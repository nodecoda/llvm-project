// Hand-written TTGIR golden (chapter 7b): the same 8x8 tensor in two layouts.
// `#blocked` hands the tile to 4 warps x 8 lanes (2 elements per thread);
// `#wide` hands it to a single warp whose lanes own whole columns
// (8 elements per thread).  The shapes and element types are identical, so
// only `convert_layout` can move the data -- through shared memory.
#blocked = #tinyttg.blocked<sizePerThread = [1, 1], threadsPerWarp = [1, 8],
                            warpsPerCTA = [4, 1], order = [1, 0]>
#wide = #tinyttg.blocked<sizePerThread = [1, 1], threadsPerWarp = [8, 1],
                         warpsPerCTA = [1, 1], order = [1, 0]>
module attributes {tinyttg.num_warps = 4 : i32} {
  func.func @convert_layout(%arg0: !tinytt.ptr<f32>) {
    %cst = arith.constant 1.000000e+00 : f32
    %0 = tinyttg.splat %cst : f32 -> tensor<8x8xf32, #blocked>
    %1 = tinyttg.convert_layout %0 : tensor<8x8xf32, #blocked> -> tensor<8x8xf32, #wide>
    %2 = tinyttg.splat %arg0 : !tinytt.ptr<f32> -> tensor<8x8x!tinytt.ptr<f32>, #wide>
    tinyttg.store %2, %1 : tensor<8x8x!tinytt.ptr<f32>, #wide>, tensor<8x8xf32, #wide>
    return
  }
}
