// Hand-written TTGIR golden (chapter 3): the chapter 2 TTIR with a layout on
// every tensor.  1024 elements over 32 lanes is 32 repetitions of the tile.
#blocked = #tinyttg.blocked<sizePerThread = [1], threadsPerWarp = [8],
                            warpsPerCTA = [4], order = [0]>
module attributes {tinyttg.num_warps = 4 : i32} {
  func.func @vecadd(%arg0: !tinytt.ptr<f32>, %arg1: !tinytt.ptr<f32>, %arg2: !tinytt.ptr<f32>) {
    %0 = tinyttg.get_program_id <axis = 0> : i32
    %c1024_i32 = arith.constant 1024 : i32
    %1 = arith.muli %0, %c1024_i32 : i32
    %2 = tinyttg.make_range <axis = 0> : tensor<1024xi32, #blocked>
    %3 = tinyttg.splat %1 : i32 -> tensor<1024xi32, #blocked>
    %4 = arith.addi %3, %2 : tensor<1024xi32, #blocked>
    %5 = tinyttg.splat %arg0 : !tinytt.ptr<f32> -> tensor<1024x!tinytt.ptr<f32>, #blocked>
    %6 = tinyttg.addptr %5, %4 : tensor<1024x!tinytt.ptr<f32>, #blocked>, tensor<1024xi32, #blocked> -> tensor<1024x!tinytt.ptr<f32>, #blocked>
    %7 = tinyttg.load %6 : tensor<1024x!tinytt.ptr<f32>, #blocked>, tensor<1024xf32, #blocked>
    %8 = tinyttg.splat %arg1 : !tinytt.ptr<f32> -> tensor<1024x!tinytt.ptr<f32>, #blocked>
    %9 = tinyttg.addptr %8, %4 : tensor<1024x!tinytt.ptr<f32>, #blocked>, tensor<1024xi32, #blocked> -> tensor<1024x!tinytt.ptr<f32>, #blocked>
    %10 = tinyttg.load %9 : tensor<1024x!tinytt.ptr<f32>, #blocked>, tensor<1024xf32, #blocked>
    %11 = tinyttg.splat %arg2 : !tinytt.ptr<f32> -> tensor<1024x!tinytt.ptr<f32>, #blocked>
    %12 = tinyttg.addptr %11, %4 : tensor<1024x!tinytt.ptr<f32>, #blocked>, tensor<1024xi32, #blocked> -> tensor<1024x!tinytt.ptr<f32>, #blocked>
    %13 = arith.addf %7, %10 : tensor<1024xf32, #blocked>
    tinyttg.store %12, %13 : tensor<1024x!tinytt.ptr<f32>, #blocked>, tensor<1024xf32, #blocked>
    return
  }
}
