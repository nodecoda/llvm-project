# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 2
# RUN: llc -mtriple=x86_64-unknown-linux-gnu -mattr=+x87 -global-isel -run-pass=legalizer %s -o - | FileCheck %s
#
# x87 load and store legalize the same three (type, memory type) pairs, and
# X86LegalizerInfo.td states them once as X86_X87MemRules.  The pairs are
# legalized in place: no mutation, no splitting, the instruction survives.
#
# This is the coverage the de-duplication needs.  Before it, no lit test
# exercised G_FPEXTLOAD or G_FPTRUNCSTORE memory shapes at all, so dropping a
# pair from the shared list was invisible to the suite.

---
name:            fpextload_s80_from_s32
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: fpextload_s80_from_s32
    ; CHECK: [[P0:%[0-9]+]]:_(p0) = IMPLICIT_DEF
    ; CHECK-NEXT: [[V:%[0-9]+]]:_(s80) = G_FPEXTLOAD [[P0]](p0) :: (load (s32) from `ptr undef`)
    ; CHECK-NEXT: RET 0, implicit [[V]]
    %0:_(p0) = IMPLICIT_DEF
    %1:_(s80) = G_FPEXTLOAD %0:_(p0) :: (load (s32) from `ptr undef`)
    RET 0, implicit %1

...
---
name:            fpextload_s64_from_s32
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: fpextload_s64_from_s32
    ; CHECK: [[P0:%[0-9]+]]:_(p0) = IMPLICIT_DEF
    ; CHECK-NEXT: [[V:%[0-9]+]]:_(s64) = G_FPEXTLOAD [[P0]](p0) :: (load (s32) from `ptr undef`)
    ; CHECK-NEXT: RET 0, implicit [[V]]
    %0:_(p0) = IMPLICIT_DEF
    %1:_(s64) = G_FPEXTLOAD %0:_(p0) :: (load (s32) from `ptr undef`)
    RET 0, implicit %1

...
---
name:            fptruncstore_s80_to_s64
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: fptruncstore_s80_to_s64
    ; CHECK: [[V:%[0-9]+]]:_(s80) = IMPLICIT_DEF
    ; CHECK-NEXT: [[P0:%[0-9]+]]:_(p0) = IMPLICIT_DEF
    ; CHECK-NEXT: G_FPTRUNCSTORE [[V]](s80), [[P0]](p0) :: (store (s64) into `ptr undef`)
    ; CHECK-NEXT: RET 0
    %0:_(s80) = IMPLICIT_DEF
    %1:_(p0) = IMPLICIT_DEF
    G_FPTRUNCSTORE %0:_(s80), %1:_(p0) :: (store (s64) into `ptr undef`)
    RET 0

...
