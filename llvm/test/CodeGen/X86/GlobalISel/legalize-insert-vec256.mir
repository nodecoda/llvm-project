# RUN: llc -mtriple=x86_64-linux-gnu -mattr=+avx                -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=ALL
# RUN: llc -mtriple=x86_64-linux-gnu -mattr=+avx512f,+avx512vl  -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=ALL
--- |
  define void @test_insert_128() {
    ret void
  }
  define void @rule_X86_EXTRACT_0() { ret void }
  define void @rule_X86_INSERT_0() { ret void }
...
---
name:            test_insert_128
# ALL-LABEL: name:  test_insert_128
alignment:       16
legalized:       false
regBankSelected: false
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
# ALL:               %0:_(<8 x s32>) = COPY $ymm0
# ALL-NEXT:          %1:_(<4 x s32>) = COPY $xmm1
# ALL-NEXT:          %2:_(<8 x s32>) = G_INSERT %0, %1(<4 x s32>), 0
# ALL-NEXT:          $ymm0 = COPY %2(<8 x s32>)
# ALL-NEXT:          RET 0, implicit $ymm0
body:             |
  bb.1 (%ir-block.0):
    liveins: $ymm0, $ymm1

    %0(<8 x s32>) = COPY $ymm0
    %1(<4 x s32>) = COPY $xmm1
    %2(<8 x s32>) = G_INSERT %0(<8 x s32>), %1(<4 x s32>), 0
    $ymm0 = COPY %2(<8 x s32>)
    RET 0, implicit $ymm0

...
---
name: rule_X86_EXTRACT_0
body: |
  bb.0:
    ; ALL-LABEL: name: rule_X86_EXTRACT_0
    ; ALL: %{{[0-9]+}}:_(<16 x s8>) = G_EXTRACT
    %0:_(<32 x s8>) = IMPLICIT_DEF
    %1:_(<16 x s8>) = G_EXTRACT %0, 0
    RET 0, implicit %1
...
---
name: rule_X86_INSERT_0
body: |
  bb.0:
    ; ALL-LABEL: name: rule_X86_INSERT_0
    ; ALL: %{{[0-9]+}}:_(<32 x s8>) = G_INSERT
    %0:_(<32 x s8>) = IMPLICIT_DEF
    %1:_(<16 x s8>) = IMPLICIT_DEF
    %2:_(<32 x s8>) = G_INSERT %0, %1, 0
    RET 0, implicit %2
...
