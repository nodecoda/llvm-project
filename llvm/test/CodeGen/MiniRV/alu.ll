; RUN: llc -mtriple=minirv64 < %s | FileCheck %s
; RUN: llc -mtriple=minirv64 -filetype=obj < %s \
; RUN:   | llvm-objdump -d --triple=minirv64 - \
; RUN:   | FileCheck %s --check-prefix=OBJ

; Every instruction below is selected by a Pat in MiniRVInstrInfo.td that names
; a record generated by auto-td, so this test fails if the generated records and
; the SelectionDAG patterns drift apart.

; CHECK-LABEL: add:
; CHECK:         add     x10, x10, x11
define i64 @add(i64 %a, i64 %b) {
  %r = add i64 %a, %b
  ret i64 %r
}

; CHECK-LABEL: sub:
; CHECK:         sub     x10, x10, x11
define i64 @sub(i64 %a, i64 %b) {
  %r = sub i64 %a, %b
  ret i64 %r
}

; The R-type shift instructions take the shift amount from a register.
; CHECK-LABEL: shl:
; CHECK:         sll     x10, x10, x11
define i64 @shl(i64 %a, i64 %b) {
  %r = shl i64 %a, %b
  ret i64 %r
}

; CHECK-LABEL: srl:
; CHECK:         srl     x10, x10, x11
define i64 @srl(i64 %a, i64 %b) {
  %r = lshr i64 %a, %b
  ret i64 %r
}

; CHECK-LABEL: sra:
; CHECK:         sra     x10, x10, x11
define i64 @sra(i64 %a, i64 %b) {
  %r = ashr i64 %a, %b
  ret i64 %r
}

; CHECK-LABEL: addi:
; CHECK:         addi    x10, x10, -1
define i64 @addi(i64 %a) {
  %r = add i64 %a, -1
  ret i64 %r
}

; CHECK-LABEL: andi:
; CHECK:         andi    x10, x10, 2047
define i64 @andi(i64 %a) {
  %r = and i64 %a, 2047
  ret i64 %r
}

; CHECK-LABEL: ori:
; CHECK:         ori     x10, x10, 7
define i64 @ori(i64 %a) {
  %r = or i64 %a, 7
  ret i64 %r
}

; CHECK-LABEL: xori:
; CHECK:         xori    x10, x10, -2048
define i64 @xori(i64 %a) {
  %r = xor i64 %a, -2048
  ret i64 %r
}

; CHECK-LABEL: mixed:
; CHECK:         andi    x3, x10, 96
; CHECK-NEXT:    xor     x3, x3, x11
; CHECK-NEXT:    ori     x10, x3, 7
define i64 @mixed(i64 %a, i64 %b) {
  %x = and i64 %a, 96
  %y = xor i64 %x, %b
  %z = or i64 %y, 7
  ret i64 %z
}

; OBJ: add     x10, x10, x11
; OBJ: addi    x10, x10, -1
