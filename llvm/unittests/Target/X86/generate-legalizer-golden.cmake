#===----------------------------------------------------------------------===#
#
# Embed x86-ctpop-report.json in the test binary as a raw string literal, so
# reproducing the committed table needs no runtime file access and no path.
#
#===----------------------------------------------------------------------===#

foreach(_var GOLDEN OUT)
  if(NOT DEFINED ${_var})
    message(FATAL_ERROR "generate-legalizer-golden.cmake: -D${_var} is required")
  endif()
endforeach()

file(READ "${GOLDEN}" _golden)
if(_golden MATCHES "\\)X86GOLDEN\"")
  message(FATAL_ERROR "the golden report contains the raw-string delimiter")
endif()

file(WRITE "${OUT}"
  "// Generated by generate-legalizer-golden.cmake. Do not edit.\n"
  "static const char X86CtpopGoldenReport[] = R\"X86GOLDEN(${_golden})X86GOLDEN\";\n")
