#===----------------------------------------------------------------------===#
#
# Emit x86-legalizer-pins.h: the pinned tuple recorded in the frozen corpus,
# next to the values observed in this build.  The gtest compares them field by
# field, so a drift names the field instead of failing a hash comparison.
#
# This runs at build time, not at configure time, because two of the inputs --
# the generated .inc and the Core IR -- do not exist until llvm-tblgen has run.
#
# Usage:
#   cmake -DINC=... -DCORE=... -DJSON=... -DEMITTER=... -DLEGALIZERINFO_TD=...
#         -DX86_TD=... -DSRC_ROOT=... -DOUT=... -P generate-legalizer-pins.cmake
#
#===----------------------------------------------------------------------===#

foreach(_var INC CORE JSON EMITTER LEGALIZERINFO_TD X86_TD ORACLE SRC_ROOT OUT)
  if(NOT DEFINED ${_var})
    message(FATAL_ERROR "generate-legalizer-pins.cmake: -D${_var} is required")
  endif()
endforeach()

file(READ "${JSON}" _json)

# Recorded side.
function(pin out name)
  string(JSON _v ERROR_VARIABLE _err GET "${_json}" pins ${name})
  if(_err)
    message(FATAL_ERROR "corpus JSON has no pins.${name}: ${_err}")
  endif()
  set(${out} "${_v}" PARENT_SCOPE)
endfunction()

pin(_rec_oracle oracle_sha256)
pin(_rec_emitter emitter_blob)
pin(_rec_li_td legalizerinfo_td_blob)
pin(_rec_x86_td x86_td_blob)
pin(_rec_inc generated_inc_sha256)
pin(_rec_core core_ir_sha256)
pin(_rec_escapes core_ir_escape_count)
pin(_rec_ctpop core_ir_ctpop_clamp_escapes)

# Observed side.
file(SHA256 "${ORACLE}" _act_oracle)
file(SHA256 "${EMITTER}" _act_emitter)
file(SHA256 "${LEGALIZERINFO_TD}" _act_li_td)
file(SHA256 "${X86_TD}" _act_x86_td)
file(SHA256 "${INC}" _act_inc)

# The Core IR records the absolute path of the .td it was generated from, so
# hash it with the checkout root folded to a fixed token.  Without this the pin
# would only hold in the tree that produced it.
file(READ "${CORE}" _core)
string(REPLACE "${SRC_ROOT}" "<llvm>" _core "${_core}")
string(SHA256 _act_core "${_core}")

string(JSON _n LENGTH "${_core}" escapes)
set(_act_escapes "${_n}")
set(_act_ctpop 0)
if(_n GREATER 0)
  math(EXPR _last "${_n} - 1")
  foreach(_i RANGE ${_last})
    string(JSON _rs GET "${_core}" escapes ${_i} ruleset)
    string(JSON _kind GET "${_core}" escapes ${_i} kind)
    string(JSON _reason GET "${_core}" escapes ${_i} reason)
    if(_rs STREQUAL "X86_CTPOP" AND _kind STREQUAL "nonliteral_type"
       AND _reason MATCHES "\\(clampScalar\\)")
      math(EXPR _act_ctpop "${_act_ctpop} + 1")
    endif()
  endforeach()
endif()

set(_hdr "// Generated by generate-legalizer-pins.cmake. Do not edit.\n")

# Quote unless the value is a bare count.
function(define name value)
  if(NOT value MATCHES "^[0-9]+$")
    set(value "\"${value}\"")
  endif()
  set(_line "#define ${name} ${value}\n")
  string(APPEND _hdr "${_line}")
  set(_hdr "${_hdr}" PARENT_SCOPE)
endfunction()

define(X86_PIN_ORACLE_RECORDED "${_rec_oracle}")
define(X86_PIN_ORACLE_ACTUAL "${_act_oracle}")
define(X86_PIN_EMITTER_RECORDED "${_rec_emitter}")
define(X86_PIN_EMITTER_ACTUAL "${_act_emitter}")
define(X86_PIN_LI_TD_RECORDED "${_rec_li_td}")
define(X86_PIN_LI_TD_ACTUAL "${_act_li_td}")
define(X86_PIN_X86_TD_RECORDED "${_rec_x86_td}")
define(X86_PIN_X86_TD_ACTUAL "${_act_x86_td}")
define(X86_PIN_INC_RECORDED "${_rec_inc}")
define(X86_PIN_INC_ACTUAL "${_act_inc}")
define(X86_PIN_CORE_RECORDED "${_rec_core}")
define(X86_PIN_CORE_ACTUAL "${_act_core}")
define(X86_PIN_ESCAPES_RECORDED "${_rec_escapes}")
define(X86_PIN_ESCAPES_ACTUAL "${_act_escapes}")
define(X86_PIN_CTPOP_ESCAPES_RECORDED "${_rec_ctpop}")
define(X86_PIN_CTPOP_ESCAPES_ACTUAL "${_act_ctpop}")

file(WRITE "${OUT}" "${_hdr}")
