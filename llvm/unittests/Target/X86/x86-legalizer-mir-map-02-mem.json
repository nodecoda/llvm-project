{
  "schema": "llvm.gisel.x86-legalizer-mir-map",
  "version": 1,
  "family": "mem",
  "comment": "T4 decision-level MIR map for the memory, stack, pointer and control rule sets (Lane B). Each entry names a legalizer-pass MIR file under llvm/test/CodeGen/X86/GlobalISel and the functions whose FileCheck assertions cover the rule set's decision. Entries use a rule atom when that literal rule is reachable from well-formed MIR. For X86_LOAD, X86_STORE, X86_PTRTOINT and X86_PTR_ADD the literal rule atoms are only reachable through queries whose non-pointer type index no machine function can express (the machine verifier rejects them), so those four use the escape atom of the same rule set that the referenced function actually exercises; X86_LOAD is the same choice as the schema example. The eight all-escaped sets are all mapped to real MIR here rather than excluded.",
  "rule_sets": [
    {"rule_set": "X86_BR", "kind": "mir", "mir_file": "legalize-brcond.mir",
     "functions": ["test"], "atom": "x86/rule/X86_BR#0", "opcodes": ["G_BR"]},
    {"rule_set": "X86_BRCOND", "kind": "mir", "mir_file": "legalize-brcond.mir",
     "functions": ["test"], "atom": "x86/rule/X86_BRCOND#0", "opcodes": ["G_BRCOND"]},
    {"rule_set": "X86_CONSTANT_POOL", "kind": "mir", "mir_file": "legalizer-decisions-mem.mir",
     "functions": ["rule_X86_CONSTANT_POOL_0"], "atom": "x86/escape/X86_CONSTANT_POOL#0", "opcodes": ["G_CONSTANT_POOL"]},
    {"rule_set": "X86_DYN_STACKALLOC", "kind": "mir", "mir_file": "legalizer-decisions-misc.mir",
     "functions": ["rule_X86_DYN_STACKALLOC_0"], "atom": "x86/rule/X86_DYN_STACKALLOC#0", "opcodes": ["G_DYN_STACKALLOC"]},
    {"rule_set": "X86_FPEXTLOAD", "kind": "mir", "mir_file": "legalize-x87-memdesc.mir",
     "functions": ["fpextload_s64_from_s32"], "atom": "x86/escape/X86_FPEXTLOAD#0", "opcodes": ["G_FPEXTLOAD"]},
    {"rule_set": "X86_FPTRUNCSTORE", "kind": "mir", "mir_file": "legalize-x87-memdesc.mir",
     "functions": ["fptruncstore_s80_to_s64"], "atom": "x86/escape/X86_FPTRUNCSTORE#0", "opcodes": ["G_FPTRUNCSTORE"]},
    {"rule_set": "X86_FRAME_INDEX", "kind": "mir", "mir_file": "legalizer-decisions-misc.mir",
     "functions": ["rule_X86_FRAME_INDEX_0"], "atom": "x86/escape/X86_FRAME_INDEX#0", "opcodes": ["G_FRAME_INDEX"]},
    {"rule_set": "X86_GLOBAL_VALUE", "kind": "mir", "mir_file": "x86_64-legalize-GV.mir",
     "functions": ["test_global_ptrv"], "atom": "x86/escape/X86_GLOBAL_VALUE#0", "opcodes": ["G_GLOBAL_VALUE"]},
    {"rule_set": "X86_INTTOPTR", "kind": "mir", "mir_file": "x86_64-legalize-inttoptr.mir",
     "functions": ["inttoptr_p0_s64"], "atom": "x86/escape/X86_INTTOPTR#0", "opcodes": ["G_INTTOPTR"]},
    {"rule_set": "X86_INTRINSIC", "kind": "mir", "mir_file": "legalizer-decisions-misc.mir",
     "functions": ["rule_X86_INTRINSIC_0"], "atom": "x86/rule/X86_INTRINSIC#0", "opcodes": ["G_INTRINSIC"]},
    {"rule_set": "X86_INVOKE_REGION_START", "kind": "mir", "mir_file": "legalizer-decisions-misc.mir",
     "functions": ["rule_X86_INVOKE_REGION_START_0"], "atom": "x86/rule/X86_INVOKE_REGION_START#0", "opcodes": ["G_INVOKE_REGION_START"]},
    {"rule_set": "X86_LOAD", "kind": "mir", "mir_file": "legalize-memop-scalar-64.mir",
     "functions": ["test_memop_s8tos32"], "atom": "x86/escape/X86_LOAD#0", "opcodes": ["G_LOAD"]},
    {"rule_set": "X86_MEMCPY", "kind": "mir", "mir_file": "legalizer-decisions-mem.mir",
     "functions": ["rule_X86_MEMCPY_0"], "atom": "x86/rule/X86_MEMCPY#0", "opcodes": ["G_MEMCPY"]},
    {"rule_set": "X86_PTRTOINT", "kind": "mir", "mir_file": "x86_64-legalize-ptrtoint.mir",
     "functions": ["ptrtoint_s1_p0"], "atom": "x86/escape/X86_PTRTOINT#0", "opcodes": ["G_PTRTOINT"]},
    {"rule_set": "X86_PTR_ADD", "kind": "mir", "mir_file": "legalize-ptr-add-64.mir",
     "functions": ["test_gep_i64"], "atom": "x86/escape/X86_PTR_ADD#1", "opcodes": ["G_PTR_ADD"]},
    {"rule_set": "X86_SEXTLOAD", "kind": "mir", "mir_file": "legalizer-decisions-mem.mir",
     "functions": ["rule_X86_SEXTLOAD_0"], "atom": "x86/escape/X86_SEXTLOAD#0", "opcodes": ["G_SEXTLOAD"]},
    {"rule_set": "X86_STORE", "kind": "mir", "mir_file": "legalize-memop-scalar-64.mir",
     "functions": ["test_memop_s8tos32"], "atom": "x86/escape/X86_STORE#0", "opcodes": ["G_STORE"]},
    {"rule_set": "X86_TRAP", "kind": "mir", "mir_file": "legalizer-decisions-misc.mir",
     "functions": ["rule_X86_TRAP_0"], "atom": "x86/rule/X86_TRAP#0", "opcodes": ["G_TRAP"]},
    {"rule_set": "X86_ZEXTLOAD", "kind": "mir", "mir_file": "legalizer-decisions-mem.mir",
     "functions": ["rule_X86_ZEXTLOAD_0"], "atom": "x86/escape/X86_ZEXTLOAD#0", "opcodes": ["G_ZEXTLOAD"]}
  ]
}
