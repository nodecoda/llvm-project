  [[maybe_unused]] const LLT X86_s16MaxVector = HasAVX512 ? X86_v32s16 : HasAVX ? X86_v16s16 : X86_v8s16;
  [[maybe_unused]] const LLT X86_s32MaxVector = HasAVX512 ? X86_v16s32 : HasAVX ? X86_v8s32 : X86_v4s32;
