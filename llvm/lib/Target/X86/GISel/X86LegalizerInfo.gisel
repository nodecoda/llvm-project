            select(feature("Subtarget.hasAVX()"), 32, 16)),
            elem_of(slot(0))))) when (sort_of(slot(0)) == vector and not sort_of(slot(0)) == scalable_vector and elem_of(slot(0)) == ty(X86_s8) and num_elems(slot(0)) > select(feature("Subtarget.hasAVX512()"),
            64, select(feature("Subtarget.hasAVX()"), 32, 16)))
    fewer(slot(0), replace(scalar_or_vec_of(select(feature("Subtarget.hasAVX512()"), 32,
            select(feature("Subtarget.hasAVX()"), 16, 8)),
            elem_of(slot(0))))) when (sort_of(slot(0)) == vector and not sort_of(slot(0)) == scalable_vector and elem_of(slot(0)) == ty(X86_s16) and num_elems(slot(0)) > select(feature("Subtarget.hasAVX512()"),
            32, select(feature("Subtarget.hasAVX()"), 16, 8)))
    fewer(slot(0), replace(scalar_or_vec_of(select(feature("Subtarget.hasAVX512()"), 16,
            select(feature("Subtarget.hasAVX()"), 8, 4)),
            elem_of(slot(0))))) when (sort_of(slot(0)) == vector and not sort_of(slot(0)) == scalable_vector and elem_of(slot(0)) == ty(X86_s32) and num_elems(slot(0)) > select(feature("Subtarget.hasAVX512()"),
            16, select(feature("Subtarget.hasAVX()"), 8, 4)))
    fewer(slot(0), replace(scalar_or_vec_of(select(feature("Subtarget.hasAVX512()"), 8,
            select(feature("Subtarget.hasAVX()"), 4, 2)),
            elem_of(slot(0))))) when (sort_of(slot(0)) == vector and not sort_of(slot(0)) == scalable_vector and elem_of(slot(0)) == ty(X86_s64) and num_elems(slot(0)) > select(feature("Subtarget.hasAVX512()"),
            8, select(feature("Subtarget.hasAVX()"), 4, 2)))

