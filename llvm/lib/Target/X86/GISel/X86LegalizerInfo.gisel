ruleset X86_UITOFP: G_UITOFP
    note "For G_UITOFP and G_FPTOUI without AVX512, we have to custom legalize"
    note "types"
    note "<= s32 manually. Otherwise, in custom handler there is no way to"
    note "understand whether s32 is an original type and we need to promote it to"
    note "s64 or s32 is obtained after widening and we shouldn't widen it to s64."
    note ""
    note "For AVX512 we simply widen types as there is direct mapping from opcodes"
    note "to asm instructions."
    legal (feature("Subtarget.hasAVX512()") and in_pairs(slot(0), slot(1), [[X86_s32,
            X86_s32], [X86_s32, X86_s64], [X86_s64, X86_s32], [X86_s64, X86_s64]]))
    custom (not feature("Subtarget.hasAVX512()") and ((feature("Subtarget.hasSSE1()") and slot(0) == ty(X86_s32)) or (feature("Subtarget.hasSSE2()") and slot(0) == ty(X86_s64))) and bits_of(slot(1)) < select(feature("Subtarget.is64Bit()"),
            64, 32))
    lower (not feature("Subtarget.hasAVX512()") and ((feature("Subtarget.hasSSE1()") and slot(0) == ty(X86_s32)) or (feature("Subtarget.hasSSE2()") and slot(0) == ty(X86_s64))) and feature("Subtarget.is64Bit()") and slot(1) == ty(X86_s64))
    widen(slot(0), ty(X86_s32))
    narrow(slot(0), ty(X86_s64OrS32))
    widen(slot(0), pow2)
    widen(slot(1), ty(X86_s32))
    narrow(slot(1), ty(X86_sMaxScalar))
    widen(slot(1), pow2)

ruleset X86_FPTOUI: G_FPTOUI
    note "TODO: replace with customized legalization using"
    note "specifics of cvttsd2si. The selection of this node requires"
    note "a vector type. Either G_SCALAR_TO_VECTOR is needed or more advanced"
    note "support of G_BUILD_VECTOR/G_INSERT_VECTOR_ELT is required beforehand."
    legal (feature("Subtarget.hasAVX512()") and in_pairs(slot(0), slot(1), [[X86_s32,
            X86_s32], [X86_s32, X86_s64], [X86_s64, X86_s32], [X86_s64, X86_s64]]))
    custom (not feature("Subtarget.hasAVX512()") and ((feature("Subtarget.hasSSE1()") and slot(1) == ty(X86_s32)) or (feature("Subtarget.hasSSE2()") and slot(1) == ty(X86_s64))) and bits_of(slot(0)) < select(feature("Subtarget.is64Bit()"),
            64, 32))
    lower (not feature("Subtarget.hasAVX512()") and ((feature("Subtarget.hasSSE1()") and slot(1) == ty(X86_s32)) or (feature("Subtarget.hasSSE2()") and slot(1) == ty(X86_s64))) and feature("Subtarget.is64Bit()") and slot(0) == ty(X86_s64))
    widen(slot(0), ty(X86_s32))
    narrow(slot(0), ty(X86_sMaxScalar))
    widen(slot(0), pow2)
    widen(slot(1), ty(X86_s32))
    narrow(slot(1), ty(X86_s64OrS32))
    widen(slot(1), pow2)

ruleset X86_BUILD_VECTOR: G_BUILD_VECTOR
    note "vector ops"
    note "G_BUILD_VECTOR cannot be legalized by adding elements: the added"
    note "elements are undef, and narrowing the widened vector back to the"
    note "original type recreates the instruction being legalized, so the"
    note "legalizer would re-enqueue the same query forever.  Only clamp the"
    note "maximum number of elements; a narrow build vector is reported as"
    note "unsupported (and falls back to SelectionDAG) instead of looping."
    note "Lowering non-constant narrow build vectors is tracked by #143099."
    custom ((feature("Subtarget.hasSSE1()") and slot(0) == ty(X86_v4s32)) or (feature("Subtarget.hasSSE2()") and in(slot(0),
            [X86_v2s64, X86_v8s16,
            X86_v16s8])) or (feature("Subtarget.hasAVX()") and in(slot(0), [X86_v4s64,
            X86_v8s32, X86_v16s16,
            X86_v32s8])) or (feature("Subtarget.hasAVX512()") and in(slot(0), [X86_v8s64,
            X86_v16s32, X86_v32s16, X86_v64s8])))
