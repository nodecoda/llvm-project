{
  "version": 1,
  "warp_size": 8,
  "warps_per_block": 4,
  "threads_per_block": 32,
  "register_file": {
    "gpr_per_lane": 32,
    "pred_per_lane": 8,
    "uniform_per_warp": 8
  },
  "sys_funct": {
    "exit": 0,
    "ret": 1
  },
  "special_registers": [
    { "name": "laneid", "funct": 2 },
    { "name": "warpid", "funct": 3 },
    { "name": "blockid", "funct": 4 },
    { "name": "tid", "funct": 5 },
    { "name": "ntid", "funct": 6 },
    { "name": "nwarps", "funct": 7 },
    { "name": "activemask", "funct": 8 },
    { "name": "shared", "funct": 10 }
  ],
  "active_mask": {
    "bits": 8,
    "all_active": 255
  },
  "address_spaces": [
    { "id": 1, "name": "global", "scope": "grid", "readonly": false },
    { "id": 2, "name": "shared", "scope": "block", "readonly": false },
    { "id": 3, "name": "private", "scope": "lane", "readonly": false },
    { "id": 4, "name": "constant", "scope": "grid", "readonly": true }
  ],
  "launch": {
    "args_funct": 9,
    "args_register": "ur0",
    "grid_dims": 1,
    "max_threads_per_block": 32
  },
  "scheduling": {
    "units": { "alu": 1, "lsu": 1, "bar": 1 },
    "note": "issue slots per cycle per unit; no memory latency until chapter 19"
  },
  "latency": {
    "global": 0,
    "shared": 0,
    "note": "cycles a warp waits after a load; 0 keeps chapters 12-18 unchanged"
  },
  "occupancy": {
    "registers_per_sm": 65536,
    "max_warps_per_sm": 64,
    "registers_per_thread": 32,
    "note": "T4-class SM; registers_per_thread is the knob that matters"
  },
  "barrier": {
    "name": "bar.sync",
    "funct": 11,
    "scope": "block"
  },
  "shared": {
    "window_base": 0,
    "bytes_per_block": 49152,
    "bytes_per_warp_scope": "block"
  },
  "divergence": {
    "policy": "min-pc-frame-merge",
    "strict_flag": "--strict-uniform",
    "reconverge": "frames at the same pc run together"
  }
}
