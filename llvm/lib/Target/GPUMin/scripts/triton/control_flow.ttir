// Golden canonical TTIR for scripts/triton/control_flow.py with BLOCK=32,
// i32 pointers for where_kernel/unroll_kernel and f32 pointers for
// fwhere_kernel/swhere_kernel.  Triton's canonicalizer folds the i32
// select to arith.minsi and the two unrolled loops to arith.constant 16.
module {
  tt.func public @where_kernel(%arg0: !tt.ptr<i32>, %arg1: !tt.ptr<i32>, %arg2: !tt.ptr<i32>) {
    %0 = tt.make_range {end = 32 : i32, start = 0 : i32} : tensor<32xi32>
    %1 = tt.splat %arg0 : !tt.ptr<i32> -> tensor<32x!tt.ptr<i32>>
    %2 = tt.addptr %1, %0 : tensor<32x!tt.ptr<i32>>, tensor<32xi32>
    %3 = tt.load %2 : tensor<32x!tt.ptr<i32>>
    %4 = tt.splat %arg1 : !tt.ptr<i32> -> tensor<32x!tt.ptr<i32>>
    %5 = tt.addptr %4, %0 : tensor<32x!tt.ptr<i32>>, tensor<32xi32>
    %6 = tt.load %5 : tensor<32x!tt.ptr<i32>>
    %7 = arith.minsi %3, %6 : tensor<32xi32>
    %8 = tt.splat %arg2 : !tt.ptr<i32> -> tensor<32x!tt.ptr<i32>>
    %9 = tt.addptr %8, %0 : tensor<32x!tt.ptr<i32>>, tensor<32xi32>
    tt.store %9, %7 : tensor<32x!tt.ptr<i32>>
    tt.return
  }
  tt.func public @fwhere_kernel(%arg0: !tt.ptr<f32>, %arg1: !tt.ptr<f32>, %arg2: !tt.ptr<f32>) {
    %0 = tt.make_range {end = 32 : i32, start = 0 : i32} : tensor<32xi32>
    %1 = tt.splat %arg0 : !tt.ptr<f32> -> tensor<32x!tt.ptr<f32>>
    %2 = tt.addptr %1, %0 : tensor<32x!tt.ptr<f32>>, tensor<32xi32>
    %3 = tt.load %2 : tensor<32x!tt.ptr<f32>>
    %4 = tt.splat %arg1 : !tt.ptr<f32> -> tensor<32x!tt.ptr<f32>>
    %5 = tt.addptr %4, %0 : tensor<32x!tt.ptr<f32>>, tensor<32xi32>
    %6 = tt.load %5 : tensor<32x!tt.ptr<f32>>
    %7 = arith.cmpf olt, %3, %6 : tensor<32xf32>
    %8 = arith.select %7, %3, %6 : tensor<32xi1>, tensor<32xf32>
    %9 = tt.splat %arg2 : !tt.ptr<f32> -> tensor<32x!tt.ptr<f32>>
    %10 = tt.addptr %9, %0 : tensor<32x!tt.ptr<f32>>, tensor<32xi32>
    tt.store %10, %8 : tensor<32x!tt.ptr<f32>>
    tt.return
  }
  tt.func public @swhere_kernel(%arg0: !tt.ptr<f32>) {
    %cst = arith.constant 2.500000e+00 : f32
    %cst_0 = arith.constant 1.500000e+00 : f32
    %c0_i32 = arith.constant 0 : i32
    %0 = tt.get_program_id x : i32
    %1 = arith.cmpi sgt, %0, %c0_i32 : i32
    %2 = arith.select %1, %cst_0, %cst : f32
    %3 = tt.addptr %arg0, %0 : !tt.ptr<f32>, i32
    tt.store %3, %2 : !tt.ptr<f32>
    tt.return
  }
  tt.func public @unroll_kernel(%arg0: !tt.ptr<i32>) {
    %c16_i32 = arith.constant 16 : i32
    tt.store %arg0, %c16_i32 : !tt.ptr<i32>
    tt.return
  }
}

