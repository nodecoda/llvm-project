module {
  tt.func public @mask_broadcast_kernel(%x_ptr: !tt.ptr<f32>, %out_ptr: !tt.ptr<f32>) {
    %0 = tt.make_range {start = 0 : i32, end = 8 : i32} : tensor<8xi32>
    %r = tt.expand_dims %0 {axis = 1 : i32} : tensor<8xi32> -> tensor<8x1xi32>
    %2 = tt.make_range {start = 0 : i32, end = 8 : i32} : tensor<8xi32>
    %c = tt.expand_dims %2 {axis = 0 : i32} : tensor<8xi32> -> tensor<1x8xi32>
    %4 = arith.constant 4 : i32
    %5 = tt.splat %4 : i32 -> tensor<1x8xi32>
    %colmask = arith.cmpi slt, %c, %5 : tensor<1x8xi32>
    %7 = arith.constant 8 : i32
    %8 = tt.splat %7 : i32 -> tensor<8x1xi32>
    %9 = arith.muli %r, %8 : tensor<8x1xi32>
    %10 = tt.splat %x_ptr : !tt.ptr<f32> -> tensor<8x1x!tt.ptr<f32>>
    %11 = tt.addptr %10, %9 : tensor<8x1x!tt.ptr<f32>>, tensor<8x1xi32>
    %12 = tt.broadcast %11 : tensor<8x1x!tt.ptr<f32>> -> tensor<8x8x!tt.ptr<f32>>
    %13 = tt.broadcast %c : tensor<1x8xi32> -> tensor<8x8xi32>
    %14 = tt.addptr %12, %13 : tensor<8x8x!tt.ptr<f32>>, tensor<8x8xi32>
    %15 = tt.broadcast %colmask : tensor<1x8xi1> -> tensor<8x8xi1>
    %16 = arith.constant 0.000000e+00 : f32
    %17 = tt.splat %16 : f32 -> tensor<8x8xf32>
    %x = tt.load %14, %15, %17 : tensor<8x8x!tt.ptr<f32>>
    %19 = arith.constant 8 : i32
    %20 = tt.splat %19 : i32 -> tensor<8x1xi32>
    %21 = arith.muli %r, %20 : tensor<8x1xi32>
    %22 = tt.splat %out_ptr : !tt.ptr<f32> -> tensor<8x1x!tt.ptr<f32>>
    %23 = tt.addptr %22, %21 : tensor<8x1x!tt.ptr<f32>>, tensor<8x1xi32>
    %24 = tt.broadcast %23 : tensor<8x1x!tt.ptr<f32>> -> tensor<8x8x!tt.ptr<f32>>
    %25 = tt.broadcast %c : tensor<1x8xi32> -> tensor<8x8xi32>
    %26 = tt.addptr %24, %25 : tensor<8x8x!tt.ptr<f32>>, tensor<8x8xi32>
    tt.store %26, %x : tensor<8x8x!tt.ptr<f32>>
    tt.return
  }
}
