//===----------------------------------------------------------------------===//
//
// Source of truth for AArch64LegalizerInfo.td.  That .td is generated; do not
// edit it.  Regenerate and check with:
//
//   llvm-dev/tools/gisel_td.py gen <this file> --out AArch64LegalizerInfo.td
//   llvm-dev/tools/gisel_td.py check <this file> --td AArch64LegalizerInfo.td
//
// The rule body is one statement per line; the indentation after `ruleset`
// groups statements into one rule set.  The vocabulary is the core IR:
//
//   legal <pred>                            terminal: legal
//   lower/custom/unsupported/libcall <pred>
//   widen|narrow|more|fewer|bitcast(<obs>, <target>) [when <pred>]
//   scalarize(<obs>) [when <pred>]
//   clamp_min(<idx>, <elt>, <lanes>) / clamp_max(<idx>, <elt>, <lanes>)
//   imm_idx(<n>)                            coverage marker, not a core rule
//
// Observations: slot(i), elem_of, scalar_of, sort_of, num_elems, bits_of,
// size_of, size_in_bytes_of, is_byte_sized, addr_space, align_of, mem_slot,
// mem_ty, mem_ordering, mem_failure_ordering, is_pow2, is_bfloat16, is_float16.
// Constructors: pow2, pow2_min(n), multiple_of(n), pow2_ceil(n), clamp(l,h),
// ty(t), same_as(k), min_vector_size(n), int_of_size(n), elt_type_to(t,t),
// elt_size_to(t,n), div_lanes(t,n), vec_of(n,t), scalar_or_vec_of(n,t),
// replace(t), select(p,a,b), mul(a,b), urem(a,b), udiv(a,b).
// Predicates: feature("<C++ bool expression>"), true, A and B, A or B, not A,
// a == b (and !=, <, <=, >, >=), in(slot(t)|[t,...]), in_pairs, in_triples,
// in_mem_desc.
//
// The declarations below are the TableGen scaffolding the rules name: the
// feature booleans (whose record names become the C++ `bool`s), the named LLT
// constants, the select types that cache a subtarget choice, and the type
// lists/sets a rule can use as one operand.  A rule body never spells the
// target prefix; the generator resolves `s8`, `v2s64`, ... to the named
// records.
//
//===----------------------------------------------------------------------===//
include "llvm/Target/LegalizerInfo.td"
include "llvm/Target/Target.td"

feature AArch64_HasFP16 = Subtarget.hasFullFP16()
feature AArch64_HasCSSC = Subtarget.hasCSSC()
feature AArch64_HasRCPC3 = Subtarget.hasRCPC3()
feature AArch64_HasSVE = Subtarget.hasSVE()
feature AArch64_UseOutlineAtomics = Subtarget.outlineAtomics() && !Subtarget.hasLSE()
feature AArch64_SmallCodeModel = TM.getCodeModel() == CodeModel::Small
feature AArch64_HasBF16 = Subtarget.hasBF16()
feature AArch64_HasMOPS = Subtarget.hasMOPS()
type AArch64_p0 = LLT::pointer(0, 64)
type AArch64_s1 = LLT::scalar(1)
type AArch64_s8 = LLT::scalar(8)
type AArch64_s16 = LLT::scalar(16)
type AArch64_s32 = LLT::scalar(32)
type AArch64_s64 = LLT::scalar(64)
type AArch64_s128 = LLT::scalar(128)
type AArch64_i8 = LLT::integer(8)
type AArch64_i16 = LLT::integer(16)
type AArch64_i32 = LLT::integer(32)
type AArch64_i64 = LLT::integer(64)
type AArch64_i128 = LLT::integer(128)
type AArch64_bf16 = LLT::bfloat16()
type AArch64_f16 = LLT::float16()
type AArch64_f32 = LLT::float32()
type AArch64_f64 = LLT::float64()
type AArch64_f128 = LLT::float128()
type AArch64_v2s8 = LLT::fixed_vector(2, 8)
type AArch64_v4s8 = LLT::fixed_vector(4, 8)
type AArch64_v8s8 = LLT::fixed_vector(8, 8)
type AArch64_v16s8 = LLT::fixed_vector(16, 8)
type AArch64_v2s16 = LLT::fixed_vector(2, 16)
type AArch64_v4s16 = LLT::fixed_vector(4, 16)
type AArch64_v8s16 = LLT::fixed_vector(8, 16)
type AArch64_v2s32 = LLT::fixed_vector(2, 32)
type AArch64_v4s32 = LLT::fixed_vector(4, 32)
type AArch64_v2s64 = LLT::fixed_vector(2, 64)
type AArch64_v2p0 = LLT::fixed_vector(2, LLT::pointer(0, 64))
type AArch64_v8i8 = LLT::fixed_vector(8, LLT::integer(8))
type AArch64_v16i8 = LLT::fixed_vector(16, LLT::integer(8))
type AArch64_v4i16 = LLT::fixed_vector(4, LLT::integer(16))
type AArch64_v8i16 = LLT::fixed_vector(8, LLT::integer(16))
type AArch64_v2i32 = LLT::fixed_vector(2, LLT::integer(32))
type AArch64_v4i32 = LLT::fixed_vector(4, LLT::integer(32))
type AArch64_v2i64 = LLT::fixed_vector(2, LLT::integer(64))
type AArch64_v4bf16 = LLT::fixed_vector(4, LLT::bfloat16())
type AArch64_v8bf16 = LLT::fixed_vector(8, LLT::bfloat16())
type AArch64_v4f16 = LLT::fixed_vector(4, LLT::float16())
type AArch64_v8f16 = LLT::fixed_vector(8, LLT::float16())
type AArch64_v2f32 = LLT::fixed_vector(2, LLT::float32())
type AArch64_v4f32 = LLT::fixed_vector(4, LLT::float32())
type AArch64_v2f64 = LLT::fixed_vector(2, LLT::float64())
type AArch64_nxv16s8 = LLT::scalable_vector(16, 8)
type AArch64_nxv8s16 = LLT::scalable_vector(8, 16)
type AArch64_nxv4s32 = LLT::scalable_vector(4, 32)
type AArch64_nxv2s64 = LLT::scalable_vector(2, 64)
type AArch64_nxv16i8 = LLT::scalable_vector(16, LLT::integer(8))
type AArch64_nxv8i16 = LLT::scalable_vector(8, LLT::integer(16))
type AArch64_nxv4i32 = LLT::scalable_vector(4, LLT::integer(32))
type AArch64_nxv2i64 = LLT::scalable_vector(2, LLT::integer(64))
type_list AArch64_PackedVectorAllTypes = [AArch64_v16s8, AArch64_v8s16, AArch64_v4s32, AArch64_v2s64, AArch64_v2p0, AArch64_v8s8, AArch64_v4s16, AArch64_v2s32]
type_set AArch64_S8To32Set = [AArch64_s8, AArch64_s16, AArch64_s32]
type_set AArch64_S16To64Set = [AArch64_s16, AArch64_s32, AArch64_s64]
type_set AArch64_S16To64OrPtrSet = [AArch64_s16, AArch64_s32, AArch64_s64, AArch64_p0]
type_set AArch64_S32Or64Set = [AArch64_s32, AArch64_s64]
type_set AArch64_S32Or64OrPtrSet = [AArch64_s32, AArch64_s64, AArch64_p0]
type_set AArch64_S32Or64Or128OrPtrSet = [AArch64_s32, AArch64_s64, AArch64_s128, AArch64_p0]
type_set AArch64_S8To128Set = [AArch64_s8, AArch64_s16, AArch64_s32, AArch64_s64, AArch64_s128]
type_set AArch64_V2s16OrV2s8Set = [AArch64_v2s16, AArch64_v2s8]
type_set AArch64_S64OrPtrSet = [AArch64_s64, AArch64_p0]
type_set AArch64_F16OrBF16Set = [AArch64_f16, AArch64_bf16]
type_set AArch64_MemS8OrS16Set = [AArch64_s8, AArch64_s16]
type_set AArch64_MemS8To32Set = [AArch64_s8, AArch64_s16, AArch64_s32]
type_set AArch64_ShuffleSrcSet = [AArch64_v8s8, AArch64_v16s8, AArch64_v4s16, AArch64_v8s16, AArch64_v2s32, AArch64_v4s32, AArch64_v2s64]
type_set AArch64_PackedVectorCoreSet = AArch64_PackedVectorAllTypes.Elems
type_set AArch64_ScalarAndPtrCoreSet = [AArch64_s8, AArch64_s16, AArch64_s32, AArch64_s64, AArch64_p0]
type_set AArch64_PackedVectorOrV2s16Set = [AArch64_v8s8, AArch64_v16s8, AArch64_v2s16, AArch64_v4s16, AArch64_v8s16, AArch64_v2s32, AArch64_v4s32, AArch64_v2s64, AArch64_v2p0]
type_set AArch64_ImplicitDefScalarSet = [AArch64_p0, AArch64_s8, AArch64_s16, AArch64_s32, AArch64_s64, AArch64_s128]
type_set AArch64_ImplicitDefVectorSet = [AArch64_v2s8, AArch64_v4s8, AArch64_v8s8, AArch64_v16s8, AArch64_v2s16, AArch64_v4s16, AArch64_v8s16, AArch64_v2s32, AArch64_v4s32, AArch64_v2s64, AArch64_v2p0]
type_set AArch64_PhiTypesSet = [AArch64_p0, AArch64_s16, AArch64_s32, AArch64_s64]
type_set AArch64_I32Or64OrIntVecSet = [AArch64_i32, AArch64_i64, AArch64_v8i8, AArch64_v16i8, AArch64_v4i16, AArch64_v8i16, AArch64_v2i32, AArch64_v4i32, AArch64_v2i64]
type_set AArch64_I32OrI64Set = [AArch64_i32, AArch64_i64]
type_set AArch64_SmulhTypesSet = [AArch64_i64, AArch64_v16i8, AArch64_v8i16, AArch64_v4i32]
type_set AArch64_IntVecNoV2i64Set = [AArch64_v8i8, AArch64_v16i8, AArch64_v4i16, AArch64_v8i16, AArch64_v2i32, AArch64_v4i32]
type_set AArch64_PackedVectorOrV2p0Set = [AArch64_v16i8, AArch64_v8i16, AArch64_v4i32, AArch64_v2i64, AArch64_v2p0, AArch64_v8i8, AArch64_v4i16, AArch64_v2i32]
type_set AArch64_BitreverseTypesSet = [AArch64_i32, AArch64_i64, AArch64_v8i8, AArch64_v16i8]
type_set AArch64_V8i8OrV16i8Set = [AArch64_v8i8, AArch64_v16i8]
type_set AArch64_BswapTypesSet = [AArch64_i32, AArch64_i64, AArch64_v4i16, AArch64_v8i16, AArch64_v2i32, AArch64_v4i32, AArch64_v2i64]
type_set AArch64_UaddsatTypesSet = [AArch64_v8i8, AArch64_v16i8, AArch64_v4i16, AArch64_v8i16, AArch64_v2i32, AArch64_v4i32, AArch64_v2i64]
type_set AArch64_FPScalarOrVecSet = [AArch64_f32, AArch64_f64, AArch64_v2f32, AArch64_v4f32, AArch64_v2f64]
type_set AArch64_S16To128Set = [AArch64_s16, AArch64_s32, AArch64_s64, AArch64_s128]
type_set AArch64_S32Set = [AArch64_s32]
type_set AArch64_PtrSet = [AArch64_p0]
type_set AArch64_I128Set = [AArch64_i128]
type_set AArch64_F128Set = [AArch64_f128]
type_set AArch64_F32To128Set = [AArch64_f32, AArch64_f64, AArch64_f128]
type_set AArch64_SremTypesSet = [AArch64_i8, AArch64_i16, AArch64_i32, AArch64_i64, AArch64_v2i32, AArch64_v4i32, AArch64_v2i64]
type_set AArch64_F16OrBF16VecSet = [AArch64_f16, AArch64_bf16, AArch64_v4f16, AArch64_v4bf16, AArch64_v8f16, AArch64_v8bf16]
type_set AArch64_SVEIntVecSet = [AArch64_nxv16i8, AArch64_nxv8i16, AArch64_nxv4i32, AArch64_nxv2i64]
type_set AArch64_F16OrV4V8F16Set = [AArch64_f16, AArch64_v4f16, AArch64_v8f16]
type_set AArch64_Bitcast16Set = [AArch64_s16]
type_set AArch64_Bitcast32Set = [AArch64_s32, AArch64_v2s16, AArch64_v4s8]
type_set AArch64_Bitcast64Set = [AArch64_s64, AArch64_v8s8, AArch64_v4s16, AArch64_v2s32]
type_set AArch64_Bitcast128Set = [AArch64_s128, AArch64_v16s8, AArch64_v8s16, AArch64_v4s32, AArch64_v2s64, AArch64_v2p0]

ruleset AArch64_IMPLICIT_DEF: G_IMPLICIT_DEF G_FREEZE G_CONSTANT_FOLD_BARRIER
    legal in(slot(0), AArch64_ImplicitDefScalarSet)
    legal in(slot(0), AArch64_ImplicitDefVectorSet)
    widen(slot(0), pow2)
    widen(slot(0), ty(AArch64_s8))
    narrow(slot(0), ty(AArch64_s64))
    more(slot(0), pow2)
    widen(elem_of(slot(0)), min_vector_size(64))
    clamp_min(0, AArch64_s8, 8)
    clamp_max(0, AArch64_s8, 16)
    clamp_min(0, AArch64_s16, 4)
    clamp_max(0, AArch64_s16, 8)
    clamp_min(0, AArch64_s32, 2)
    clamp_max(0, AArch64_s32, 4)
    clamp_max(0, AArch64_s64, 2)
    clamp_max(0, AArch64_p0, 2)
    scalarize(slot(0)) when bits_of(slot(0)) > 64

ruleset AArch64_PHI: G_PHI
    legal in(slot(0), AArch64_PhiTypesSet)
    legal in(slot(0), AArch64_PackedVectorCoreSet)
    widen(slot(0), pow2)
    more(slot(0), pow2)
    scalarize(slot(0)) when bits_of(slot(0)) > 64
    widen(slot(0), ty(AArch64_s16))
    narrow(slot(0), ty(AArch64_s64))
    clamp_min(0, AArch64_s8, 8)
    clamp_max(0, AArch64_s8, 16)
    clamp_min(0, AArch64_s16, 4)
    clamp_max(0, AArch64_s16, 8)
    clamp_min(0, AArch64_s32, 2)
    clamp_max(0, AArch64_s32, 4)
    clamp_max(0, AArch64_s64, 2)
    clamp_max(0, AArch64_p0, 2)
    widen(slot(0), 8)

ruleset AArch64_INSERT: G_INSERT
    legal (in(slot(0), AArch64_S32Or64OrPtrSet) and in(slot(1),
            AArch64_MemS8To32Set) and size_of(slot(1)) < size_of(slot(0)))
    widen(slot(0), pow2)
    widen(slot(0), ty(AArch64_s32))
    narrow(slot(0), ty(AArch64_s64))
    widen(slot(1), pow2)
    widen(slot(1), ty(AArch64_s8))
    narrow(slot(1), ty(AArch64_s16)) when slot(0) == ty(AArch64_s32)
    narrow(slot(1), ty(AArch64_s32)) when in(slot(0), AArch64_S64OrPtrSet)

ruleset AArch64_EXTRACT: G_EXTRACT
    legal (in(slot(0), AArch64_S16To64OrPtrSet) and in(slot(1),
            AArch64_S32Or64Or128OrPtrSet) and size_of(slot(0)) < size_of(slot(1)))
    widen(slot(1), pow2)
    widen(slot(1), ty(AArch64_s32))
    narrow(slot(1), ty(AArch64_s128))
    widen(slot(0), pow2)
    widen(slot(0), ty(AArch64_s16))
    narrow(slot(0), ty(AArch64_s16)) when slot(1) == ty(AArch64_s32)
    narrow(slot(0), ty(AArch64_s32)) when in(slot(1), AArch64_S64OrPtrSet)
    narrow(slot(0), ty(AArch64_s64)) when slot(1) == ty(AArch64_s128)

ruleset AArch64_ADD: G_ADD G_SUB G_AND G_OR G_XOR
    legal in(slot(0), AArch64_I32Or64OrIntVecSet)
    legal (feature("Subtarget.hasSVE()") and in(slot(0), AArch64_SVEIntVecSet))
    widen(slot(0), pow2)
    widen(slot(0), ty(AArch64_s32))
    narrow(slot(0), ty(AArch64_s64))
    clamp_max(0, AArch64_s8, 16)
    clamp_max(0, AArch64_s16, 8)
    clamp_min(0, AArch64_s32, 2)
    clamp_max(0, AArch64_s32, 4)
    clamp_min(0, AArch64_s64, 2)
    clamp_max(0, AArch64_s64, 2)
    widen(elem_of(slot(0)), ty(AArch64_s32)) when num_elems(slot(0)) <= 2
    widen(elem_of(slot(0)), ty(AArch64_s16)) when num_elems(slot(0)) <= 4
    widen(elem_of(slot(0)), ty(AArch64_s8)) when num_elems(slot(0)) <= 16
    scalarize(slot(0)) when bits_of(slot(0)) > 64
    more(slot(0), pow2)

ruleset AArch64_MUL: G_MUL
    legal in(slot(0), AArch64_I32Or64OrIntVecSet)
    widen(slot(0), pow2)
    widen(slot(0), ty(AArch64_s32))
    narrow(slot(0), ty(AArch64_s64))
    clamp_max(0, AArch64_s8, 16)
    clamp_max(0, AArch64_s16, 8)
    clamp_min(0, AArch64_s32, 2)
    clamp_max(0, AArch64_s32, 4)
    clamp_min(0, AArch64_s64, 2)
    clamp_max(0, AArch64_s64, 2)
    widen(elem_of(slot(0)), ty(AArch64_s32)) when num_elems(slot(0)) <= 2
    widen(elem_of(slot(0)), ty(AArch64_s16)) when num_elems(slot(0)) <= 4
    widen(elem_of(slot(0)), ty(AArch64_s8)) when num_elems(slot(0)) <= 16
    scalarize(slot(0)) when bits_of(slot(0)) > 64
    more(slot(0), pow2)

ruleset AArch64_SHL: G_SHL G_ASHR G_LSHR
    custom (not sort_of(slot(0)) == vector and size_of(slot(0)) == 32 and size_of(slot(1)) == 32)
    legal in_pairs(slot(0), slot(1), [[AArch64_i32, AArch64_i32], [AArch64_i32,
            AArch64_i64], [AArch64_i64, AArch64_i64], [AArch64_v8i8, AArch64_v8i8],
            [AArch64_v16i8, AArch64_v16i8], [AArch64_v4i16, AArch64_v4i16], [AArch64_v8i16,
            AArch64_v8i16], [AArch64_v2i32, AArch64_v2i32], [AArch64_v4i32, AArch64_v4i32],
            [AArch64_v2i64, AArch64_v2i64]])
    widen(slot(1), pow2)
    widen(slot(0), pow2)
    widen(slot(1), ty(AArch64_s32))
    narrow(slot(1), ty(AArch64_s64))
    widen(slot(0), ty(AArch64_s32))
    narrow(slot(0), ty(AArch64_s64))
    clamp_min(0, AArch64_s8, 8)
    clamp_max(0, AArch64_s8, 16)
    clamp_min(0, AArch64_s16, 4)
    clamp_max(0, AArch64_s16, 8)
    clamp_min(0, AArch64_s32, 2)
    clamp_max(0, AArch64_s32, 4)
    clamp_min(0, AArch64_s64, 2)
    clamp_max(0, AArch64_s64, 2)
    more(slot(0), pow2)
    widen(slot(1), same_as(0))
    scalarize(slot(0)) when bits_of(slot(0)) > 64
    widen(slot(1), same_as(0)) when sort_of(slot(0)) == vector
    narrow(slot(1),
            replace(same_as(0))) when (sort_of(slot(0)) == vector and bits_of(slot(0)) < bits_of(slot(1)))

ruleset AArch64_PTR_ADD: G_PTR_ADD
    legal in_pairs(slot(0), slot(1), [[AArch64_p0, AArch64_i64], [AArch64_v2p0,
            AArch64_v2i64]])
    widen(elem_of(slot(1)), ty(AArch64_s64))
    narrow(elem_of(slot(1)), ty(AArch64_s64))
    clamp_min(0, AArch64_p0, 2)
    clamp_max(0, AArch64_p0, 2)

ruleset AArch64_PTRMASK: G_PTRMASK
    legal in_pairs(slot(0), slot(1), [[AArch64_p0, AArch64_s64]])

ruleset AArch64_SDIV: G_SDIV G_UDIV
    legal in(slot(0), AArch64_I32OrI64Set)
    libcall in(slot(0), AArch64_i128)
    widen(slot(0), ty(AArch64_s32))
    narrow(slot(0), ty(AArch64_s64))
    widen(slot(0), pow2)
    scalarize(slot(0))

ruleset AArch64_SREM: G_SREM G_UREM G_SDIVREM G_UDIVREM
    lower in(slot(0), AArch64_SremTypesSet)
    libcall in(slot(0), AArch64_i128)
    widen(elem_of(slot(0)), pow2)
    widen(elem_of(slot(0)), ty(AArch64_s32))
    clamp_min(0, AArch64_s32, 2)
    clamp_max(0, AArch64_s32, 4)
    clamp_min(0, AArch64_s64, 2)
    clamp_max(0, AArch64_s64, 2)
    scalarize(slot(0))

ruleset AArch64_SMULO: G_SMULO G_UMULO
    widen(slot(0), pow2_min(32))
    widen(slot(0), ty(AArch64_s32))
    narrow(slot(0), ty(AArch64_s64))
    lower true

ruleset AArch64_SMULH: G_SMULH G_UMULH
    legal in(slot(0), AArch64_SmulhTypesSet)
    clamp_max(0, AArch64_s8, 16)
    clamp_max(0, AArch64_s16, 8)
    clamp_max(0, AArch64_s32, 4)
    lower true

ruleset AArch64_SMULFIX: G_SMULFIX G_UMULFIX G_SMULFIXSAT G_UMULFIXSAT
    lower true

ruleset AArch64_SMIN: G_SMIN G_SMAX G_UMIN G_UMAX
    legal in(slot(0), AArch64_IntVecNoV2i64Set)
    legal (feature("Subtarget.hasCSSC()") and in(slot(0), AArch64_I32OrI64Set))
    widen(slot(0), ty(AArch64_s32))
    clamp_min(0, AArch64_s8, 8)
    clamp_max(0, AArch64_s8, 16)
    clamp_min(0, AArch64_s16, 4)
    clamp_max(0, AArch64_s16, 8)
    clamp_min(0, AArch64_s32, 2)
    clamp_max(0, AArch64_s32, 4)
    lower true

ruleset AArch64_ABS: G_ABS
    legal (feature("Subtarget.hasCSSC()") and in(slot(0), AArch64_I32OrI64Set))
    legal in(slot(0), AArch64_PackedVectorOrV2p0Set)
    custom (sort_of(slot(0)) == scalar and size_of(slot(0)) < 128)
    widen(slot(0), replace(ty(AArch64_v4i16))) when slot(0) == ty(AArch64_v4s8)
